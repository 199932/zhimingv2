[
  {
    "id": "ux2a_primary_action",
    "anchor": "<div class=\"page\" id=\"page-today\">",
    "insert": "before",
    "code": "<!-- ===== 顶部 Primary Action Zone（新手第一眼入口） ===== -->\n<div class=\"primary-action\" id=\"primaryActionZone\" aria-label=\"今日我想算\">\n  <button class=\"pab pab-cn\" type=\"button\" onclick=\"window.switchTab && window.switchTab('cn'); window.switchSec && window.switchSec('cn1'); if(document.getElementById('bazi_year') && !document.getElementById('bazi_year').value) window.applySmartDefaultsToForms && window.applySmartDefaultsToForms('bazi'); var e1=document.getElementById('sec-cn1'); if(e1) try{e1.scrollIntoView({behavior:'smooth',block:'start'});}catch(_){}\">\n    <span class=\"emj\">☯️</span><span>八字排盘</span>\n  </button>\n  <button class=\"pab pab-wu\" type=\"button\" onclick=\"window.switchTab && window.switchTab('wu'); window.switchSec && window.switchSec('wu1'); var f=window.drawTarotDaily || function(){}; try{f('single', document.getElementById('result-wu1'));}catch(_){} var e1=document.getElementById('sec-wu1'); if(e1) try{e1.scrollIntoView({behavior:'smooth',block:'start'});}catch(_){}\">\n    <span class=\"emj\">✦</span><span>每日塔罗</span>\n  </button>\n  <button class=\"pab pab-al\" type=\"button\" onclick=\"window.switchTab && window.switchTab('al'); var e1=document.getElementById('page-al'); if(e1) try{e1.scrollIntoView({behavior:'smooth',block:'start'});}catch(_){}\">\n    <span class=\"emj\">❖</span><span>今日黄历</span>\n  </button>\n  <button class=\"pab pab-qc\" type=\"button\" onclick=\"window.openQuickCmd && window.openQuickCmd('起卦');\">\n    <span class=\"emj\">🔍</span><span>更多功能…（命令面板）</span>\n  </button>\n</div>\n",
    "required": true
  },
  {
    "id": "ux2b_modals_banner",
    "anchor": "  <!-- Phase 3: 西方灵数画像 -->",
    "insert": "before",
    "code": "  <!-- ============== UX Smooth Skeleton ============== -->\n  <!-- 错误口语横幅（空壳，内容由 JS 动态填） -->\n  <div id=\"errBanner\" class=\"errBanner\" role=\"alert\" aria-live=\"assertive\"></div>\n\n  <!-- 快速命令面板 Modal -->\n  <div id=\"quickCmdModal\" role=\"dialog\" aria-modal=\"true\" aria-label=\"快速命令\">\n    <div class=\"qc-panel\">\n      <input id=\"qc_input\" class=\"qc-input\" type=\"text\" placeholder=\"输入命令：算八字 / 算塔罗圣三角 / 看黄历 / 词典 七杀 …\" autocomplete=\"off\" spellcheck=\"false\">\n      <ul id=\"qc_candidates\" class=\"qc-candidates\"></ul>\n      <div class=\"qc-foot\">\n        <span>回车执行 · Esc 关闭 · 选中后自动记录</span>\n        <button type=\"button\" onclick=\"window.closeQuickCmd && window.closeQuickCmd()\">关闭</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- 历史对比双栏浮层 -->\n  <div id=\"compareModal\" role=\"dialog\" aria-modal=\"true\" aria-label=\"最近两次对比\">\n    <div class=\"cm-panel\">\n      <div class=\"cm-head\">\n        <div class=\"title\">📊 最近两次同类型结果对比</div>\n        <button type=\"button\" class=\"close\" onclick=\"window.closeCompareModal && window.closeCompareModal()\">✕ 关闭</button>\n      </div>\n      <div id=\"compareDiffBar\" class=\"cm-diff-bar\" style=\"display:none;\"></div>\n      <div class=\"cm-body\">\n        <div class=\"cm-col\"><h3 id=\"cmLTitle\">—</h3><div class=\"cm-meta\" id=\"cmLMeta\"></div><div class=\"cm-content\" id=\"cmLBody\">（尚未载入左栏）</div></div>\n        <div class=\"cm-col\"><h3 id=\"cmRTitle\">—</h3><div class=\"cm-meta\" id=\"cmRMeta\"></div><div class=\"cm-content\" id=\"cmRBody\">（尚未载入右栏）</div></div>\n      </div>\n      <div class=\"cm-foot\">\n        <button type=\"button\" onclick=\"window.closeCompareModal && window.closeCompareModal()\">关闭</button>\n        <button type=\"button\" class=\"primary\" onclick=\"window.openHistory && window.openHistory()\">在历史中重选</button>\n      </div>\n    </div>\n  </div>\n  <!-- ============== UX Smooth Skeleton END ============== -->\n",
    "required": true
  }
]
