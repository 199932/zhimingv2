    case 18: // 月亮：月+狗+狼+小龙虾+两塔
      return `<g>
        <rect x="0" y="0" width="96" height="148" fill="#1C1C4B" opacity="0.4"/>
        <!-- 月亮 -->
        <g transform="translate(48,30)">
          <circle cx="0" cy="0" r="20" fill="#F5F5DC"/>
