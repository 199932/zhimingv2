        <!-- 信徒 -->
        <g transform="translate(22,110)"><circle cx="0" cy="0" r="4" fill="#FFE4B5"/>
          <rect x="-6" y="4" width="12" height="20" fill="#2F4F4F"/></g>
        <g transform="translate(74,110)"><circle cx="0" cy="0" r="4" fill="#FFE4B5"/>
          <rect x="-6" y="4" width="12" height="20" fill="#2F4F4F"/></g>
        <!-- 交叉钥匙 -->
        <g transform="translate(48,130)" stroke="#B8860B" stroke-width="1.2" fill="none">
          <circle cx="-10" cy="0" r="5"/><line x1="-6" y1="3" x2="10" y2="14"/>
          <line x1="4" y1="10" x2="8" y2="12" stroke-width="1.5"/>
          <circle cx="10" cy="0" r="5"/><line x1="6" y1="3" x2="-10" y2="14"/>
          <line x1="-4" y1="10" x2="-8" y2="12" stroke-width="1.5"/>
        </g>
      </g>`;
    case 6: // 恋人：一对男女+天使+苹果/树
      return `<g>
        <g transform="translate(48,20)"><polygon points="0,-14 12,0 6,0 8,14 -8,14 -6,0 -12,0" fill="#FFF8DC" stroke="#87CEEB" stroke-width="0.5"/>
          <circle cx="-6" cy="-18" r="3" fill="#FFF8DC"/><circle cx="6" cy="-18" r="3" fill="#FFF8DC"/></g>
        <!-- 树+苹果 -->
        <g transform="translate(12,120)">
          <rect x="-2" y="0" width="4" height="20" fill="#8B4513"/>
          <circle cx="0" cy="-8" r="14" fill="#228B22"/>
          <circle cx="-4" cy="-10" r="2" fill="#FF0000"/>
          <circle cx="5" cy="-4" r="2" fill="#FF0000"/>
          <circle cx="0" cy="-2" r="2" fill="#FF0000"/>
        </g>
        <!-- 女 -->
        <g transform="translate(30,108)"><circle cx="0" cy="0" r="5" fill="#FFE4B5"/>
          <path d="M-7,8 L7,8 10,38 -10,38 Z" fill="#FFC0CB"/><circle cx="6" cy="12" r="1.5" fill="#FF0000"/></g>
        <!-- 男 -->
        <g transform="translate(66,108)"><circle cx="0" cy="0" r="5" fill="#FFE4B5"/>
          <path d="M-7,8 L7,8 10,38 -10,38 Z" fill="#87CEEB"/><circle cx="-6" cy="12" r="1.5" fill="#FF0000"/></g>
      </g>`;
    case 7: // 战车：狮身人面拉车+战士
      return `<g>
        <!-- 战车 -->
        <rect x="14" y="88" width="68" height="44" fill="#4682B4" stroke="#000080" stroke-width="1"/>
        <rect x="10" y="76" width="76" height="14" fill="#FFD700"/>
        <polygon points="14,76 82,76 78,68 18,68" fill="#8B4513"/>
        <circle cx="24" cy="140" r="8" fill="#333" stroke="#000" stroke-width="1"/>
        <circle cx="72" cy="140" r="8" fill="#333" stroke="#000" stroke-width="1"/>
        <line x1="24" y1="140" x2="24" y2="134" stroke="#808080" stroke-width="1"/>
        <line x1="24" y1="140" x2="30" y2="140" stroke="#808080" stroke-width="1"/>
        <line x1="72" y1="140" x2="72" y2="134" stroke="#808080" stroke-width="1"/>
        <line x1="72" y1="140" x2="78" y2="140" stroke="#808080" stroke-width="1"/>
        <!-- 战士 -->
        <g transform="translate(48,50)">
          <circle cx="0" cy="0" r="7" fill="#FFE4B5"/>
          <polygon points="-6,-8 6,-8 0,-16" fill="#4682B4"/>
          <rect x="-10" y="8" width="20" height="38" fill="#4682B4"/>
          <polygon points="0,14 -3,30 3,30" fill="#FFD700"/>
        </g>
        <!-- 狮身人面 -->
        <g transform="translate(10,132)"><circle cx="0" cy="-10" r="6" fill="#C2B280"/>
          <path d="M-8,-4 L8,-4 14,4 -14,4 Z" fill="#C2B280"/>
          <circle cx="-2" cy="-11" r="0.7" fill="#000"/>
          <circle cx="2" cy="-11" r="0.7" fill="#000"/></g>
        <g transform="translate(86,132)"><circle cx="0" cy="-10" r="6" fill="#2C2C2C"/>
          <path d="M-8,-4 L8,-4 14,4 -14,4 Z" fill="#2C2C2C"/>
          <circle cx="-2" cy="-11" r="0.7" fill="#FFF"/>
          <circle cx="2" cy="-11" r="0.7" fill="#FFF"/></g>
      </g>`;
    case 8: // 力量：无限符号+女性抚狮头
      return `<g>
        <text x="48" y="16" font-size="14" fill="#B8860B" text-anchor="middle" font-weight="700">∞</text>
        <!-- 狮子 -->
        <g transform="translate(48,102)">
          <ellipse cx="0" cy="10" rx="30" ry="20" fill="#DAA520"/>
          <circle cx="0" cy="-10" r="14" fill="#DAA520"/>
          <circle cx="-16" cy="-18" r="4" fill="#DAA520"/>
          <circle cx="16" cy="-18" r="4" fill="#DAA520"/>
          <polygon points="-8,-8 -5,-6 -8,-4" fill="#FFF"/>
          <polygon points="8,-8 5,-6 8,-4" fill="#FFF"/>
          <circle cx="-6" cy="-7" r="0.7" fill="#000"/>
          <circle cx="6" cy="-7" r="0.7" fill="#000"/>
          <polygon points="-2,-1 0,2 2,-1" fill="#000"/>
        </g>
        <!-- 女性 -->
        <g transform="translate(48,50)">
          <circle cx="0" cy="0" r="8" fill="#FFE4B5"/>
          <circle cx="0" cy="-4" r="9" fill="#FFD700"/>
          <path d="M-16,12 L16,12 22,60 -22,60 Z" fill="#FF6347"/>
          <path d="M-12,20 Q-18,40 -22,52" stroke="#FF6347" stroke-width="4" fill="none"/>
        </g>
      </g>`;
    case 9: // 隐士：提灯老人+山
      return `<g>
        <polygon points="0,148 32,70 48,98 70,52 96,148" fill="#696969"/>
        <polygon points="10,148 40,80 60,110 84,70 96,148" fill="#808080" opacity="0.6"/>
        <g transform="translate(48,92)">
          <!-- 斗篷 -->
          <polygon points="-18,10 18,10 24,56 -24,56" fill="#4A4A4A"/>
          <circle cx="0" cy="0" r="8" fill="#FFE4B5"/>
          <polygon points="-10,-8 10,-8 8,-14 -8,-14" fill="#808080"/> <!-- 帽 -->
          <rect x="-12" y="-4" width="24" height="4" fill="#4A4A4A"/> <!-- 帽檐 -->
          <!-- 提灯 -->
          <g transform="translate(16,22)">
            <line x1="-6" y1="-10" x2="-6" y2="-20" stroke="#000" stroke-width="0.8"/>
            <rect x="-10" y="-10" width="8" height="12" fill="#FFD700" stroke="#8B4513" stroke-width="0.5"/>
            <polygon points="-6,8 -10,-2 -2,-2" fill="#FFEB3B"/>
          </g>
          <!-- 权杖 -->
          <g transform="translate(-18,18)"><rect x="0" y="0" width="2" height="36" fill="#8B4513"/>
            <circle cx="1" cy="-2" r="3" fill="#8B4513"/></g>
        </g>
      </g>`;
    case 10: // 命运之轮：四角生物+轮+符号
      return `<g>
        <!-- 四角 -->
        <g transform="translate(12,20)"><rect x="0" y="0" width="16" height="12" fill="#FFE4B5" stroke="#8B4513" stroke-width="0.5"/>
