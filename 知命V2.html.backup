    kbBi:{"李":7,"王":4,"张":11,"刘":15,"陈":16,"杨":13,"赵":14,"黄":12,"周":8,"吴":7,"徐":10,"孙":10,"马":10,"朱":6,"胡":11,"郭":15,"何":7,"林":8,"罗":20,"高":10,"郑":19,"梁":11,"谢":17,"宋":7,"唐":10,"许":11,"韩":17,"冯":12,"邓":19,"曹":11,"彭":12,"曾":12,"萧":18,"田":5,"董":15,"袁":10,"潘":16,"于":8,"蒋":17,"蔡":17,"余":7,"杜":7,"叶":15,"程":12,"苏":22,"魏":18,"吕":7,"沈":8,"任":6,"姚":9,"卢":16,"傅":12,"钟":20,"姜":9,"崔":11,"谭":19,"廖":14,"范":15,"汪":8,"陆":16,"金":8,"石":5,"戴":18,"贾":13,"韦":9,"夏":10,"邱":12,"方":4,"侯":9,"邹":17,"熊":14,"孟":8,"秦":10,"白":5,"江":7,"阎":16,"薛":19,"尹":4,"雷":13,"龙":16,"段":9,"郝":14,"孔":4,"邵":12,"史":5,"毛":4,"常":11,"万":15,"顾":21,"赖":16,"武":8,"康":11,"贺":12,"严":20,"钱":16,"汤":13,"易":8,"乔":12,"文":4,"一":1,"二":2,"三":3,"四":5,"五":4,"六":4,"七":2,"八":2,"九":2,"十":2,"大":3,"小":3,"中":4,"天":4,"子":3,"宇":6,"安":6,"明":8,"清":12,"华":14,"伟":11,"强":11,"军":9,"勇":9,"杰":12,"超":12,"磊":15,"浩":11,"轩":10,"博":12,"豪":14,"源":14,"洋":10,"梓":11,"晨":11,"睿":14,"瑞":14,"欣":8,"怡":9,"佳":8,"思":9,"诗":13,"雅":12,"静":16,"丽":19,"婷":12,"雪":11,"梦":14,"慧":15,"琳":13,"瑶":15,"琪":13,"萱":15,"雯":12,"宁":14,"悦":11,"钰":13,"逸":15,"凡":3,"辰":7,"峻":10,"朗":11,"尧":12,"舜":12,"禹":9,"弘":5,"光":6,"宗":8,"政":9,"启":11,"承":8,"哲":10,"彬":11,"斌":11,"凯":12,"翔":12,"峰":10,"逍":14,"遥":17,"若":11,"沐":8,"阳":17,"雨":8,"露":20,"晓":16,"紫":11,"子":3,"玲":10,"芳":10,"娜":10,"敏":11,"笑":10,"书":10,"珊":10,"玲":10,"枫":13,"君":7,"妮":8,"菲":14,"茹":12,"涵":12,"婉":11,"冰":6,"筱":13,"莉":13,"蓝":20,"若":11,"彤":7,"柔":9,"虹":9,"珊":10,"婕":11,"婧":11,"怡":9,"馨":20,"韵":19,"瑶":15,"翠":14,"萍":14,"菊":14,"兰":23,"竹":6,"松":8,"梅":11,"柳":9,"柏":9,"杏":7,"桃":10,"桂":10,"林":8,"森":12,"淼":12,"焱":12,"垚":9,"鑫":24,"森":12,"品":9,"众":11,"晶":12,"磊":15,"淼":12,"森":12,"众":11,"品":9}
