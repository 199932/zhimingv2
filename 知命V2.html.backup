window._selfTest = function(){
    validateJieqi();
    const arr = [];
    TEST_BAZI.slice(0,3).forEach((t,i)=>{
      const r = baziCalc({year:t.y,month:t.m,day:t.d,hour:t.h,minute:t.minute??0,gender:t.gender,cityLng:t.lngE});
      arr.push({name:t.name,expect:t.expect,actual:r.pillars.map(p=>p.gz).join(" "),trueSolar:r.trueSolar});
    });
    return arr;
  };
}
let _toastTimer=null;
function showToast(text,type,duration){
  type=type||'info';duration=duration||1500;
  let box=document.getElementById('toastBox');
  if(!box){box=document.createElement('div');box.id='toastBox';document.body.appendChild(box);}
  box.innerHTML='';
  const icons={success:'✅',error:'❌',warn:'⚠️',info:''};
  const t=document.createElement('div');
  t.className='toast '+type;
  t.textContent=(icons[type]?icons[type]+' ':'')+text;
  box.appendChild(t);
  requestAnimationFrame(()=>{t.classList.add('show');});
  if(type==='success'){try{if(navigator.vibrate)navigator.vibrate(60);}catch(_){}}
  clearTimeout(_toastTimer);
  _toastTimer=setTimeout(()=>{t.classList.remove('show');setTimeout(()=>{if(t.parentNode===box)box.removeChild(t);},220);},duration);
}
function initSwipeTabs(){
  const ORDER=['today','cn','wu','al'];
  let sx=0,sy=0,dx=0,dy=0,startT=0,swiping=false;
  const app=document.body;
  app.addEventListener('touchstart',e=>{
    if(e.touches.length!==1)return;
    const t=e.touches[0].target;
    if(t.closest('.modal, select, input, textarea, .subtabs, .bottom-tabs, .topbar')){swiping=false;return;}
    sx=e.touches[0].clientX;sy=e.touches[0].clientY;dx=0;dy=0;startT=Date.now();swiping=true;
  },{passive:true});
  app.addEventListener('touchmove',e=>{
    if(!swiping)return;
    dx=e.touches[0].clientX-sx;dy=e.touches[0].clientY-sy;
  },{passive:true});
  app.addEventListener('touchend',e=>{
    if(!swiping)return;swiping=false;
    const dur=Date.now()-startT;
    if(Math.abs(dx)>80&&Math.abs(dx)>Math.abs(dy)*1.5&&dur<500){
      const cur=document.body.dataset.page||'today';
      let idx=ORDER.indexOf(cur);
      if(idx<0)idx=0;
      if(dx<0)idx=(idx+1)%ORDER.length;
      else idx=(idx-1+ORDER.length)%ORDER.length;
      switchTab(ORDER[idx]);
      try{if(navigator.vibrate)navigator.vibrate(15);}catch(_){}
    }
  },{passive:true});
}
function initPullRefresh(){
  let startY=0,pullY=0,pulling=false;
  const refreshEl=document.createElement('div');
  refreshEl.id='pullRefresh';
  refreshEl.style.cssText='position:fixed;top:56px;left:0;right:0;text-align:center;color:var(--pri);font-size:12px;z-index:50;height:0;overflow:hidden;transition:height .25s;';
  refreshEl.innerHTML='🔽 下拉刷新今日';
  document.body.appendChild(refreshEl);
  window.addEventListener('touchstart',e=>{
    if((document.body.dataset.page||'')!=='today')return;
    if(window.scrollY>4)return;
    if(e.touches.length!==1)return;
    startY=e.touches[0].clientY;pullY=0;pulling=true;
  },{passive:true});
  window.addEventListener('touchmove',e=>{
    if(!pulling)return;
    pullY=Math.max(0,e.touches[0].clientY-startY);
    refreshEl.style.height=Math.min(60,pullY*0.4)+'px';
    refreshEl.innerText=pullY>60?'🆗 松手刷新':'🔽 下拉刷新今日';
  },{passive:true});
  window.addEventListener('touchend',e=>{
    if(!pulling)return;pulling=false;
    if(pullY>60){
      refreshEl.innerText='⚡ 刷新中...';
      refreshEl.style.height='36px';
      setTimeout(()=>{
        renderToday();
        refreshEl.style.height='0px';
        showToast('🔄 已刷新今日数据','success',1000);
      },400);
    }else{refreshEl.style.height='0px';}
  });
}

/* =========================================================
 *  批次X1-1 PWA 离线安装 + X1-2 占卜日记日历
 * =======================================================*/
const MOOD_EMOJIS = ['😄','😃','😐','🤔','😭'];
const MOOD_LABELS = ['超棒','开心','一般','思考','难过'];
const WK_LABELS = ['日','一','二','三','四','五','六'];
const ICON_SVG_STR = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 192 192"><circle cx="96" cy="96" r="94" fill="#FAF8F5" stroke="#8B6F47" stroke-width="3"/><circle cx="96" cy="96" r="62" fill="#ffffff" stroke="#8B6F47" stroke-width="2"/><path d="M96 34 A62 62 0 0 1 96 158 A31 31 0 0 0 96 96 A31 31 0 0 1 96 34 Z" fill="#2b2b2b"/><circle cx="96" cy="65" r="11" fill="#ffffff"/><circle cx="96" cy="127" r="11" fill="#2b2b2b"/><text x="96" y="188" text-anchor="middle" font-size="20" font-weight="800" fill="#8B6F47" font-family="PingFang SC,Microsoft YaHei,sans-serif">知命</text></svg>`;
const ICON192_SVG = btoa(unescape(encodeURIComponent(ICON_SVG_STR)));
const ICON512_SVG = ICON192_SVG;

const PWA_MANIFEST_JSON = JSON.stringify({
  "name":"知命 V2 - 个人命理工具",
  "short_name":"知命V2",
  "description":"纯本地、无联网的个人命理占卜工具（八字/奇门/塔罗/星座/共振/黄历）",
  "start_url":"./知命V2.html",
  "display":"standalone",
  "orientation":"portrait",
  "background_color":"#FAF8F5",
  "theme_color":"#8B6F47",
  "icons":[
    {"src":"data:image/svg+xml;base64,"+ICON192_SVG,"sizes":"192x192","type":"image/svg+xml","purpose":"any maskable"},
    {"src":"data:image/svg+xml;base64,"+ICON512_SVG,"sizes":"512x512","type":"image/svg+xml","purpose":"any maskable"}
  ]
});

const SW_CODE = `const CACHE='zhiming_v2_sw_v1';
self.addEventListener('install',e=>{self.skipWaiting();});
self.addEventListener('activate',e=>{e.waitUntil(self.clients.claim());});
self.addEventListener('fetch',e=>{
  const req=e.request;
  if(req.method!=='GET') return;
  const url=new URL(req.url);
  if(!url.pathname.endsWith('.html')) return;
  e.respondWith(
    fetch(req).then(res=>{
      const clone=res.clone();
      caches.open(CACHE).then(c=>c.put(req,clone)).catch(()=>{});
      return res;
    }).catch(()=>caches.match(req).then(m=>m||caches.match('./知命V2.html')))
  );
});`;

let installPromptEvent=null;
window.addEventListener('beforeinstallprompt', e=>{
  e.preventDefault();
  installPromptEvent = e;
  const btn = document.getElementById('installBtn');
  if(btn) btn.style.display='inline-flex';
});

function onInstallBtnClick(){
  if(installPromptEvent){
    installPromptEvent.prompt();
    installPromptEvent.userChoice.then(r=>{
      if(r.outcome==='accepted') showToast('📲 已安装到桌面','success');
    });
  } else {
    showToast('手动添加到主屏幕：浏览器菜单→"添加到主屏幕"/"分享→添加"','info',3000);
  }
}

function initPWA(){
  try{
    const mh = document.getElementById('pwaManifestHref');
    if(mh) mh.href = URL.createObjectURL(new Blob([PWA_MANIFEST_JSON], {type:'application/json'}));
    const ai = document.getElementById('pwaAppleIcon');
    if(ai) ai.href = 'data:image/svg+xml;base64,'+ICON192_SVG;
  }catch(e){}
  if ('serviceWorker' in navigator) {
    try{
      const swBlob = new Blob([SW_CODE], {type:'application/javascript'});
      const swUrl = URL.createObjectURL(swBlob);
      navigator.serviceWorker.register(swUrl, {scope: './'}).then(()=>{}).catch(()=>{});
    }catch(e){}
  }
}

/* ===== 占卜日记 ===== */
const DIARY_KEY = "zhiming_v2_diary";
let _diaryYear = 0, _diaryMonth = 0, _diarySelectedDate = null;
let _diarySaveTimer = null;

function getDiaryAll(){
  try{ return JSON.parse(localStorage.getItem(DIARY_KEY)||"{}"); }catch(e){ return {}; }
}
function saveDiaryAll(obj){ localStorage.setItem(DIARY_KEY, JSON.stringify(obj)); }

function saveDiaryEntry(dateStr, data){
  const all = getDiaryAll();
  const cur = all[dateStr] || {};
  const merged = {...cur, ...data};
  if (merged.moodIndex===undefined && merged.note===undefined){
    delete all[dateStr];
  } else if (merged.note==="" && merged.moodIndex===undefined) {
    delete all[dateStr];
  } else if (merged.note==="" && merged.moodIndex===null) {
    delete all[dateStr];
  } else {
    all[dateStr] = merged;
  }
  saveDiaryAll(all);
}
function loadDiaryEntry(dateStr){
  const all = getDiaryAll();
  return all[dateStr] || {};
}

function pad(n){ return String(n).padStart(2,"0"); }
function dateKey(y,m,d){ return `${y}-${pad(m+1)}-${pad(d)}`; }
function todayKey(){
  const d = new Date();
  return dateKey(d.getFullYear(), d.getMonth(), d.getDate());
}

function getHistByDate(y,m,d){
  const arr = getHistory();
  const dk = dateKey(y,m,d);
  return arr.filter(h=>{
    const hd = new Date(h.ts);
    return dateKey(hd.getFullYear(), hd.getMonth(), hd.getDate()) === dk;
  });
}

function openDiaryModal(){
  const t = new Date();
  _diaryYear = t.getFullYear();
  _diaryMonth = t.getMonth();
  _diarySelectedDate = todayKey();
  document.getElementById("diaryModal").classList.add("show");
  renderDiaryCalendar(_diaryYear, _diaryMonth);
  renderDiaryDayDetail(_diarySelectedDate);
  document.getElementById("diaryStats").innerHTML = "";
}
function closeDiaryModal(){ document.getElementById("diaryModal").classList.remove("show"); }

function switchDiaryMonth(offset){
  if (offset === 'today'){
    const t = new Date();
    _diaryYear = t.getFullYear();
    _diaryMonth = t.getMonth();
    _diarySelectedDate = todayKey();
  } else if (offset === 0){
    return;
  } else {
    let nm = _diaryMonth + offset;
    let ny = _diaryYear;
    if (nm < 0){ nm = 11; ny--; }
    if (nm > 11){ nm = 0; ny++; }
    _diaryYear = ny;
    _diaryMonth = nm;
  }
  renderDiaryCalendar(_diaryYear, _diaryMonth);
  renderDiaryDayDetail(_diarySelectedDate);
}

function renderDiaryCalendar(y, m){
  document.getElementById("diaryCurMonth").textContent = `${y}年${m+1}月`;
  const firstDay = new Date(y, m, 1).getDay();
  const daysInMonth = new Date(y, m+1, 0).getDate();
  const daysInPrev = new Date(y, m, 0).getDate();
  const today = todayKey();
  const allDiary = getDiaryAll();
  const hist = getHistory();
  const histCntMap = {};
  hist.forEach(h=>{
    const d = new Date(h.ts);
    const k = dateKey(d.getFullYear(), d.getMonth(), d.getDate());
    histCntMap[k] = (histCntMap[k]||0) + 1;
  });
  let html = '<div class="diary-cal">';
  WK_LABELS.forEach((w,i)=>{
    let cls = 'diary-wk';
    if (i===0) cls += ' wk-sun';
    if (i===6) cls += ' wk-sat';
    html += `<div class="${cls}">${w}</div>`;
  });
  let totalCells = 0;
  for (let i = firstDay - 1; i >= 0; i--){
    const day = daysInPrev - i;
    let pm = m - 1, py = y;
    if (pm < 0){ pm = 11; py--; }
    const dk = dateKey(py, pm, day);
    const md = allDiary[dk];
    const cnt = histCntMap[dk] || 0;
    html += `<div class="diary-cell other-month" onclick="selectDiaryDate('${dk}')">
      <div class="dc-day">${day}</div>
      ${md && md.moodIndex!==undefined?`<div class="dc-mood">${MOOD_EMOJIS[md.moodIndex]}</div>`:''}
      ${cnt?`<div class="dc-cnt">×${cnt}</div>`:''}
    </div>`;
    totalCells++;
  }
  for (let d = 1; d <= daysInMonth; d++){
    const dk = dateKey(y, m, d);
    const md = allDiary[dk];
    const cnt = histCntMap[dk] || 0;
    const isToday = dk === today;
    const isSel = dk === _diarySelectedDate;
    let cls = 'diary-cell';
    if (isToday) cls += ' today';
    if (isSel) cls += ' selected';
    html += `<div class="${cls}" onclick="selectDiaryDate('${dk}')">
      <div class="dc-day">${d}</div>
      ${md && md.moodIndex!==undefined?`<div class="dc-mood">${MOOD_EMOJIS[md.moodIndex]}</div>`:''}
      ${cnt?`<div class="dc-cnt">×${cnt}</div>`:''}
    </div>`;
    totalCells++;
  }
  let nextDay = 1;
  while (totalCells < 42){
    let nm = m + 1, ny = y;
    if (nm > 11){ nm = 0; ny++; }
    const dk = dateKey(ny, nm, nextDay);
    const md = allDiary[dk];
    const cnt = histCntMap[dk] || 0;
    html += `<div class="diary-cell other-month" onclick="selectDiaryDate('${dk}')">
      <div class="dc-day">${nextDay}</div>
      ${md && md.moodIndex!==undefined?`<div class="dc-mood">${MOOD_EMOJIS[md.moodIndex]}</div>`:''}
      ${cnt?`<div class="dc-cnt">×${cnt}</div>`:''}
    </div>`;
    nextDay++;
    totalCells++;
  }
  html += '</div>';
  document.getElementById("diaryCalendar").innerHTML = html;
}

function selectDiaryDate(dateStr){
  _diarySelectedDate = dateStr;
  const [py, pm] = dateStr.split("-").map(Number);
  if (py !== _diaryYear || (pm-1) !== _diaryMonth){
    _diaryYear = py;
    _diaryMonth = pm - 1;
  }
  renderDiaryCalendar(_diaryYear, _diaryMonth);
  renderDiaryDayDetail(dateStr);
}

function renderDiaryDayDetail(dateStr){
  const [y,m,d] = dateStr.split("-").map(Number);
  const dt = new Date(y, m-1, d);
  const wk = WK_LABELS[dt.getDay()];
  const entry = loadDiaryEntry(dateStr);
  const histItems = getHistByDate(y, m-1, d);
  histItems.sort((a,b)=>a.ts-b.ts);
  let histHtml = '';
  if (histItems.length === 0){
    histHtml = `<div class="hint" style="padding:12px 0;">当日暂无占卜记录</div>`;
  } else {
    histHtml = `<div class="diary-hist-list">` + histItems.slice(0,5).map(h=>{
      const d2 = new Date(h.ts);
      const tstr = `${pad(d2.getHours())}:${pad(d2.getMinutes())}`;
      const sum = (summarizeHist(h)||"").slice(0,30);
      const color = HIST_TYPE_COLOR[h.type] || "var(--pri)";
      const tLabel = TYPE_LABEL[h.type] || h.type;
      const acc = h.accuracy;
      const accTxt = acc==='hit'?'🟢准':acc==='miss'?'🔴不准':acc==='pending'?'🟡待':'';
      return `<div class="diary-hist-item" onclick="restoreHistory('${h.id}');closeDiaryModal();">
        <div class="dhi-left">
          <span class="dhi-time">${tstr}</span>
          <span class="dhi-type" style="background:var(--pri-light);color:var(--pri-dark);">${tLabel}</span>
          <span class="dhi-sum">${sum}</span>
        </div>
        ${accTxt?`<span class="dhi-acc">${accTxt}</span>`:''}
      </div>`;
    }).join("") + `</div>`;
    if (histItems.length > 5){
      histHtml += `<div class="hint" style="padding:6px 0;">仅显示最近5条，共${histItems.length}条</div>`;
    }
  }
  const html = `<div class="diary-detail">
    <div class="dd-head">📌 ${dateStr} 星期${wk}</div>
    <div class="dd-label">心情</div>
    <div class="diary-mood-row">
      ${MOOD_EMOJIS.map((e,i)=>`<button class="diary-mood-btn ${entry.moodIndex===i?'active':''}" onclick="setDiaryMood('${dateStr}',${i})" title="${MOOD_LABELS[i]}">${e}</button>`).join("")}
      ${entry.moodIndex!==undefined?`<button class="diary-mood-btn" onclick="setDiaryMood('${dateStr}',null)" title="清除">✕</button>`:''}
    </div>
    <div class="dd-label">笔记（自动保存）</div>
    <textarea class="diary-note" id="diaryNoteArea" placeholder="记录今日占卜心得、感悟、事件..." oninput="onDiaryNoteInput('${dateStr}', this.value)">${entry.note||""}</textarea>
    <div class="dd-label">当日占卜记录（${histItems.length}条，点击还原）</div>
    ${histHtml}
  </div>`;
  document.getElementById("diaryDayDetail").innerHTML = html;
}

function setDiaryMood(dateStr, idx){
  if (idx === null){
    const cur = loadDiaryEntry(dateStr);
    delete cur.moodIndex;
    saveDiaryEntry(dateStr, cur);
  } else {
    saveDiaryEntry(dateStr, {moodIndex: idx});
  }
  renderDiaryCalendar(_diaryYear, _diaryMonth);
  renderDiaryDayDetail(dateStr);
}

function onDiaryNoteInput(dateStr, val){
  if (_diarySaveTimer) clearTimeout(_diarySaveTimer);
  _diarySaveTimer = setTimeout(()=>{
    saveDiaryEntry(dateStr, {note: val});
  }, 300);
}

function renderDiaryMonthlyStats(y, m){
  const hist = getHistory();
  const allDiary = getDiaryAll();
  const monthPrefix = `${y}-${pad(m+1)}`;
  let monthHist = hist.filter(h=>{
    const d = new Date(h.ts);
    return dateKey(d.getFullYear(), d.getMonth(), d.getDate()).startsWith(monthPrefix);
  });
  const total = monthHist.length;
  const marked = monthHist.filter(h=>h.accuracy==='hit'||h.accuracy==='miss');
  const hit = monthHist.filter(h=>h.accuracy==='hit').length;
  const accRate = marked.length>0 ? Math.round(hit/marked.length*100) : 0;
  const moodDist = [0,0,0,0,0];
  let moodDays = 0;
  Object.keys(allDiary).forEach(k=>{
    if (!k.startsWith(monthPrefix)) return;
    const d = allDiary[k];
    if (d.moodIndex!==undefined){
      moodDist[d.moodIndex]++;
      moodDays++;
    }
  });
  const tarotTypes = ['tarot','tarot_daily'];
  const tarotCount = {};
  monthHist.filter(h=>tarotTypes.includes(h.type)).forEach(h=>{
    let name = "";
    try{
      if (h.type === 'tarot' && h.input && Array.isArray(h.input.cards) && h.input.cards.length>0){
        const c = h.input.cards[0];
        const rev = c.reversed ? '逆位·' : '正位·';
        const tname = (TAROT_DATA && TAROT_DATA[c.id] && TAROT_DATA[c.id].name) || ('牌'+c.id);
        name = rev + tname;
      } else if (h.type === 'tarot_daily' && h.input && typeof h.input.cardId === 'number'){
        const rev = h.input.reversed ? '逆位·' : '正位·';
        const tname = (TAROT_DATA && TAROT_DATA[h.input.cardId] && TAROT_DATA[h.input.cardId].name) || ('牌'+h.input.cardId);
        name = rev + tname;
      }
    }catch(e){}
    if (name){
      tarotCount[name] = (tarotCount[name]||0) + 1;
    }
  });
  const tarotTop = Object.entries(tarotCount).sort((a,b)=>b[1]-a[1]).slice(0,3);
  const moodDistHtml = moodDays>0 ?
    MOOD_EMOJIS.map((e,i)=>moodDist[i]>0?`<span class="dmd-item">${e}${moodDist[i]}</span>`:'').filter(Boolean).join(" ") :
    `<span style="color:var(--text-hint);">暂无记录</span>`;
  const tarotTopHtml = tarotTop.length>0 ?
    tarotTop.map(([n,c])=>`${n}(${c}次)`).join("、") :
    `<span style="color:var(--text-hint);">暂无记录</span>`;
  const html = `<div class="diary-stats" style="margin-top:4px;">
    <div class="ds-title">📊 ${y}年${m+1}月 统计</div>
    <div class="ds-row">本月占卜：<span class="ds-v">${total}次</span> | 标记验证：<span class="ds-v">${marked.length}次</span> | 准确率：<span class="ds-v">${accRate}%</span></div>
    <div class="ds-row">本月心情分布：<div class="diary-mood-dist">${moodDistHtml}</div></div>
    <div class="ds-row">本月高频塔罗：<span class="ds-v">${tarotTopHtml}</span></div>
  </div>`;
  document.getElementById("diaryStats").innerHTML = html;
}

