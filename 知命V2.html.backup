      </div>`;
    }).join("");
    bodyHTML = `
      <div style="background:${IS_DARK?'#3f382c':'#EFE6D8'};border-radius:12px;padding:16px 20px;margin:0 0 16px;text-align:center;">
        <div style="font-size:24px;font-weight:800;color:${BRAND_DARK};letter-spacing:4px;">${r.surname||""}${r.given||""}</div>
        <div style="font-size:12px;color:${SUB};margin-top:6px;">姓氏笔画: ${r.surnameBi||""} · 名字笔画: ${r.givenBi||""}</div>
      </div>
      <div>${geHTML}</div>`;
    cardH = 1050;
  } else if (type === "cezi"){
    title = "✎ 测字 · 字理数象";
    const jxColor = r.jxTag==="吉"?"#27AE60":r.jxTag==="凶"?"#C0392B":"#B8860B";
    bodyHTML = `
      <div style="background:linear-gradient(135deg,${IS_DARK?'#3f382c':'#EFE6D8'} 0%,${CARD_BG} 100%);border-radius:16px;padding:30px 20px;text-align:center;margin:0 0 16px;">
        <div style="font-size:96px;font-weight:900;color:${BRAND};line-height:1;">${r.char||""}</div>
        <div style="margin-top:10px;"><span style="display:inline-block;padding:5px 16px;border-radius:14px;background:${jxColor};color:#fff;font-weight:700;font-size:14px;">${r.jxTag||""}</span></div>
      </div>
      <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin:0 0 16px;">
        <div style="background:${IS_DARK?'#3f382c':'#EFE6D8'};border-radius:10px;padding:12px;"><div style="font-size:11px;color:${SUB};">康熙笔画</div><div style="font-size:18px;font-weight:700;color:${BRAND_DARK};margin-top:4px;">${r.stroke||""}</div></div>
        <div style="background:${IS_DARK?'#3f382c':'#EFE6D8'};border-radius:10px;padding:12px;"><div style="font-size:11px;color:${SUB};">五行属性</div><div style="font-size:18px;font-weight:700;color:${BRAND_DARK};margin-top:4px;">${r.wx||""}</div></div>
        <div style="background:${IS_DARK?'#3f382c':'#EFE6D8'};border-radius:10px;padding:12px;"><div style="font-size:11px;color:${SUB};">字形结构</div><div style="font-size:15px;font-weight:700;color:${BRAND_DARK};margin-top:4px;">${r.struct||""}</div></div>
        <div style="background:${IS_DARK?'#3f382c':'#EFE6D8'};border-radius:10px;padding:12px;"><div style="font-size:11px;color:${SUB};">81数理</div><div style="font-size:15px;font-weight:700;color:${BRAND_DARK};margin-top:4px;">${r.code||""}</div></div>
      </div>
      <div style="padding:12px 16px;background:${IS_DARK?'#3f382c':'#EFE6D8'};border-radius:12px;font-size:12px;color:${TEXT_C};line-height:1.7;">${r.jxText||""}</div>`;
    cardH = 1050;
  } else {
    title = "知命 V2 占卜结果";
    bodyHTML = `<div style="padding:40px;text-align:center;font-size:14px;color:${SUB};">暂无详细结果展示</div>`;
  }
  const html = `
    <div ${CARD}>
      <div style="height:80px;background:${IS_DARK?BRAND_DARK:BRAND};padding:0 28px;display:flex;align-items:center;justify-content:space-between;">
        <div style="color:#fff;font-size:22px;font-weight:800;letter-spacing:3px;">知命 V2</div>
        <div style="color:rgba(255,255,255,0.85);font-size:12px;">${dateLabel}</div>
      </div>
      <div style="padding:24px;">
        <div style="background:${CARD_BG};border-radius:18px;padding:28px 24px;border:1px solid ${IS_DARK?'#4a443c':'#f1e9dc'};min-height:${cardH-180}px;">
          <div style="font-size:22px;font-weight:800;color:${BRAND_DARK};margin-bottom:18px;text-align:center;letter-spacing:2px;">${title}</div>
          ${bodyHTML}
        </div>
      </div>
      <div style="height:60px;padding:0 24px;display:flex;align-items:center;justify-content:space-between;border-top:1px dashed ${IS_DARK?'#4a443c':'#ece3d6'};">
        <div style="font-size:10px;color:${SUB};max-width:75%;line-height:1.5;">※ 本结果仅供娱乐参考，不构成任何人生决策建议</div>
        <div style="font-size:11px;color:${BRAND};font-weight:600;letter-spacing:1px;">知命V2 · 仅供娱乐</div>
      </div>
    </div>`;
  return {html, height: cardH};
}
function generateShareCardImage(type, resultData){
  const W = 720;
  const built = buildShareCardHTML(type, resultData);
  const H = built.height || 1200;
  const innerHTML = built.html.replace(/\bdata:image\/svg\+xml[^"']*/g, m => encodeURIComponent(decodeURIComponent(m)));
  const svgStr = `<svg xmlns="http://www.w3.org/2000/svg" width="${W}" height="${H}"><foreignObject width="100%" height="100%"><body xmlns="http://www.w3.org/1999/xhtml">${innerHTML}</body></foreignObject></svg>`;
  const svgBlob = new Blob([svgStr], {type: "image/svg+xml;charset=utf-8"});
  const url = URL.createObjectURL(svgBlob);
  const img = new Image();
  img.onload = function(){
    const canvas = document.createElement("canvas");
    const scale = 2;
    canvas.width = W * scale;
    canvas.height = H * scale;
    const ctx = canvas.getContext("2d");
    ctx.scale(scale, scale);
    ctx.drawImage(img, 0, 0, W, H);
    URL.revokeObjectURL(url);
    try {
      const dataURL = canvas.toDataURL("image/png");
      const a = document.createElement("a");
      const ts = new Date();
      const tsStr = `${ts.getFullYear()}${String(ts.getMonth()+1).padStart(2,"0")}${String(ts.getDate()).padStart(2,"0")}_${String(ts.getHours()).padStart(2,"0")}${String(ts.getMinutes()).padStart(2,"0")}`;
      a.download = `知命_${type}_${tsStr}.png`;
      a.href = dataURL;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      try{showToast('🖼 图片已生成下载','success');}catch(_){}
    } catch(e){
      _warn("canvas.toDataURL 失败，尝试替代方案:", e);
      const win = window.open("");
      if (win){
        win.document.write(`<div style="padding:20px;"><h3>右键图片另存为：</h3>${innerHTML}</div>`);
      }
    }
  };
  img.onerror = function(e){
    URL.revokeObjectURL(url);
    _warn("SVG 加载失败:", e);
    const win = window.open("");
    if (win){
      win.document.write(`<div style="padding:20px;"><h3>分享卡预览（右键截图保存）：</h3><div style="width:${W}px;margin:0 auto;">${innerHTML}</div></div>`);
    }
  };
  img.src = url;
}

const RC_KEY='zhiming_v2_recent_cities';
function getRecentCities(){try{return JSON.parse(localStorage.getItem(RC_KEY)||'[]')}catch(e){return []}}
function saveRecentCity(k){const rc=getRecentCities();const i=rc.indexOf(k);if(i>=0)rc.splice(i,1);rc.unshift(k);if(rc.length>3)rc.length=3;try{localStorage.setItem(RC_KEY,JSON.stringify(rc))}catch(e){}}
function filterCityOptions(f,s){const q=(f.value||'').trim().toLowerCase();let total=0;s.querySelectorAll('optgroup').forEach(o=>{let n=0;o.querySelectorAll('option').forEach(p=>{const m=!q||p.textContent.toLowerCase().includes(q);p.style.display=m?'':'none';if(m)n++});o.style.display=n?'':'none';total+=n});if(q&&total===0){try{showToast('未找到相关城市','warn',1000);}catch(_){}}}
function upgradeCityPickers(){['bz-city','qm-city','gz-city'].forEach(id=>{const s=document.getElementById(id);if(!s)return;const w=document.createElement('div');w.className='city-picker';s.parentNode.insertBefore(w,s);w.appendChild(s);const r=document.createElement('div');r.className='recent-cities';r.innerHTML='最近：';getRecentCities().forEach(k=>{let n=null;for(const g in CITIES){const x=CITIES[g].find(c=>(isNaN(c.lng)?'__custom__':String(c.lng))===k);if(x){n=x.n;break}}if(!n)return;const b=document.createElement('button');b.textContent=n;b.onclick=()=>{s.value=k;s.dispatchEvent(new Event('change'));filterCityOptions(f,s)};r.appendChild(b)});const f=document.createElement('input');f.className='city-filter';f.placeholder='搜索城市...';f.addEventListener('input',()=>filterCityOptions(f,s));w.insertBefore(r,s);w.insertBefore(f,s);s.addEventListener('change',()=>saveRecentCity(s.value))})}
const _HS='h5,.desc-title,.desc-sub-title,.card-title,.bz-five-title,.bz-wuxing-title,.bz-wx-result,.aspect-title';
function makeLongResultCollapsible(I,R){const E=document.getElementById(I);if(!E)return;const H=Array.from(E.querySelectorAll(_HS)).filter(h=>h.closest('#'+I));if(!H.length)return;const T=h=>{const t=h.textContent.trim();return t.length>20?t.slice(0,20):t};H.forEach(h=>{const B=[];let n=h.nextSibling;while(n){if(n.nodeType===1&&n.matches(_HS))break;B.push(n);n=n.nextSibling}if(!B.length)return;const W=document.createElement('div');W.className='result-block collapsible';W.dataset.title=T(h);const d=document.createElement('div');d.className='rb-header';d.innerHTML=`<span class="rb-title">${T(h)}</span><span class="rb-arrow">\u25BE</span>`;d.onclick=()=>W.classList.toggle('collapsed');const b=document.createElement('div');b.className='rb-body';h.parentNode.insertBefore(W,h);W.appendChild(d);W.appendChild(b);b.appendChild(h);B.forEach(s=>b.appendChild(s));if(R&&R.defaultCollapsed&&R.defaultCollapsed(T(h)))W.classList.add('collapsed')})}
