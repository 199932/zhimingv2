      </g>`;
    default:
      return `<rect x="8" y="8" width="${s-16}" height="${h-16}" fill="#EEE" stroke="#999"/>`;
  }
}

/* --- 56 小阿卡纳 SVG 图案 --- */
function _wandSVG(x,y,size){ // 权杖：树枝+叶子
  const h = size||16;
  return `<g transform="translate(${x},${y})">
    <rect x="-1.5" y="${-h*0.5}" width="3" height="${h}" fill="#D2691E" stroke="#8B4513" stroke-width="0.4" rx="1"/>
    <path d="M0,${-h*0.35} Q6,${-h*0.5} 4,${-h*0.15}" stroke="#228B22" stroke-width="1" fill="none"/>
    <path d="M0,${-h*0.1} Q-6,${-h*0.25} -4,${h*0.1}" stroke="#228B22" stroke-width="1" fill="none"/>
    <path d="M0,${h*0.15} Q5,${h*0.05} 6,${h*0.25}" stroke="#228B22" stroke-width="1" fill="none"/>
  </g>`;
}
function _cupSVG(x,y,size){ // 圣杯
  const s = size||16;
  return `<g transform="translate(${x},${y})">
    <path d="M${-s*0.35},${-s*0.35} Q0,${-s*0.8} ${s*0.35},${-s*0.35} Q${s*0.3},${-s*0.05} 0,${-s*0.05} Q${-s*0.3},${-s*0.05} ${-s*0.35},${-s*0.35} Z" fill="#4A90E2" stroke="#1E3A8A" stroke-width="0.5"/>
    <rect x="-1" y="${-s*0.05}" width="2" height="${s*0.22}" fill="#1E3A8A"/>
    <rect x="${-s*0.32}" y="${s*0.17}" width="${s*0.64}" height="2" fill="#1E3A8A"/>
    <path d="M0,${-s*0.55} Q${-s*0.1},${-s*0.45} ${-s*0.05},${-s*0.25}" stroke="#FFF" stroke-width="0.5" fill="none" opacity="0.7"/>
  </g>`;
}
function _swordSVG(x,y,size){ // 宝剑
  const s = size||16;
  return `<g transform="translate(${x},${y})">
    <polygon points="-1.5,${-s*0.5} 0,${-s*0.62} 1.5,${-s*0.5} 1.5,${s*0.2} -1.5,${s*0.2}" fill="#C0C0C0" stroke="#555" stroke-width="0.4"/>
    <rect x="${-s*0.3}" y="${s*0.2}" width="${s*0.6}" height="2" fill="#8B4513"/>
    <rect x="-1.5" y="${s*0.22}" width="3" height="${s*0.2}" fill="#5C3A1E"/>
    <circle cx="0" cy="${s*0.44}" r="2" fill="#FFD700" stroke="#8B4513" stroke-width="0.3"/>
  </g>`;
}
function _pentacleSVG(x,y,size){ // 星币：五芒星币
  const s = size||16;
  return `<g transform="translate(${x},${y})">
    <circle cx="0" cy="0" r="${s*0.42}" fill="#FFD700" stroke="#8B6914" stroke-width="0.6"/>
    <circle cx="0" cy="0" r="${s*0.3}" fill="none" stroke="#8B6914" stroke-width="0.3"/>
    <polygon points="0,${-s*0.3} ${s*0.28},${-s*0.08} ${s*0.18},${s*0.28} ${-s*0.18},${s*0.28} ${-s*0.28},${-s*0.08}" fill="#FFF" stroke="#8B6914" stroke-width="0.4"/>
  </g>`;
}
function _aceSuitSVG(suit, w, h){
  const cx=w/2, cy=h/2;
  const bg = `<g>
    <circle cx="${cx}" cy="${cy}" r="${Math.min(w,h)*0.38}" fill="#FFFFF0" stroke="#D2B48C" stroke-width="1"/>
    <circle cx="${cx}" cy="${cy}" r="${Math.min(w,h)*0.32}" fill="none" stroke="#FFD700" stroke-width="0.6"/>
  </g>`;
  let sym="";
  if (suit==="wands"){
    sym = `<g transform="translate(${cx},${cy-6})">
      <rect x="-3" y="-20" width="6" height="50" fill="#D2691E" stroke="#8B4513" stroke-width="0.6" rx="2"/>
      <path d="M0,-20 Q12,-28 6,-8" stroke="#228B22" stroke-width="1.5" fill="none"/>
      <path d="M0,-10 Q-14,-16 -8,6" stroke="#228B22" stroke-width="1.5" fill="none"/>
      <path d="M0,6 Q14,0 10,20" stroke="#228B22" stroke-width="1.5" fill="none"/>
      <circle cx="0" cy="-22" r="5" fill="#FFD700" stroke="#FF8C00" stroke-width="0.6"/>
    </g>`;
  } else if (suit==="cups"){
    sym = `<g transform="translate(${cx},${cy})">
      <path d="M-22,-14 Q0,-40 22,-14 Q18,6 0,6 Q-18,6 -22,-14 Z" fill="#4A90E2" stroke="#1E3A8A" stroke-width="1"/>
      <rect x="-3" y="6" width="6" height="10" fill="#1E3A8A"/>
      <rect x="-20" y="16" width="40" height="4" fill="#1E3A8A"/>
      <path d="M-10,-20 Q0,-34 10,-20 Q6,-10 0,-10 Q-6,-10 -10,-20 Z" fill="#FFF" opacity="0.5"/>
      <path d="M0,-22 Q-6,-12 3,8" stroke="#87CEEB" stroke-width="1.2" fill="none" opacity="0.6"/>
    </g>`;
  } else if (suit==="swords"){
    sym = `<g transform="translate(${cx},${cy-8})">
      <polygon points="-3,-34 0,-44 3,-34 3,18 -3,18" fill="#D3D3D3" stroke="#4A4A4A" stroke-width="0.8"/>
      <rect x="-14" y="18" width="28" height="4" fill="#8B4513"/>
      <rect x="-2" y="22" width="4" height="14" fill="#5C3A1E"/>
      <!-- 皇冠 -->
      <g transform="translate(0,-46)"><polygon points="-8,6 -8,-2 -4,2 0,-6 4,2 8,-2 8,6" fill="#FFD700" stroke="#8B6914" stroke-width="0.5"/>
        <circle cx="-5" cy="-1" r="1.2" fill="#DC143C"/><circle cx="0" cy="-4" r="1.2" fill="#4169E1"/><circle cx="5" cy="-1" r="1.2" fill="#DC143C"/></g>
      <!-- 橄榄叶 -->
      <g stroke="#228B22" stroke-width="1.2" fill="none">
        <path d="M-16,-6 Q-30,-14 -26,-30"/>
        <path d="M16,-6 Q30,-14 26,-30"/>
      </g>
      <g fill="#228B22"><ellipse cx="-22" cy="-18" rx="2" ry="3"/><ellipse cx="-26" cy="-26" rx="2" ry="3"/>
        <ellipse cx="22" cy="-18" rx="2" ry="3"/><ellipse cx="26" cy="-26" rx="2" ry="3"/></g>
    </g>`;
  } else {
    sym = `<g transform="translate(${cx},${cy})">
      <circle cx="0" cy="0" r="26" fill="#FFD700" stroke="#8B6914" stroke-width="1.5"/>
      <circle cx="0" cy="0" r="20" fill="none" stroke="#8B6914" stroke-width="0.8"/>
      <circle cx="0" cy="0" r="14" fill="#FFF8DC" stroke="#8B6914" stroke-width="0.6"/>
      <polygon points="0,-18 7,-5 11,14 -11,14 -7,-5" fill="#FFF" stroke="#8B6914" stroke-width="0.8"/>
      <polygon points="0,-10 4,-2 6,7 -6,7 -4,-2" fill="#FFD700" stroke="#8B6914" stroke-width="0.5"/>
    </g>`;
  }
  return bg+sym;
}
function _courtSVG(suit, rank){
  let color = {wands:"#D2691E",cups:"#4A90E2",swords:"#696969",pentacles:"#B8860B"}[suit];
  let cloak = {wands:"#FF6347",cups:"#00008B",swords:"#2F4F4F",pentacles:"#8B4513"}[suit];
  let body="";
  if (rank===11){ // 侍
    body = `<g transform="translate(48,76)">
      <circle cx="0" cy="0" r="7" fill="#FFE4B5"/>
      <polygon points="-8,-8 -4,-16 4,-16 8,-8 6,-4 -6,-4" fill="${color}"/> <!-- 帽 -->
      <rect x="-12" y="7" width="24" height="38" fill="${cloak}"/>
      <rect x="-16" y="10" width="6" height="30" fill="${cloak}"/>
      <rect x="10" y="10" width="6" height="30" fill="${cloak}"/>
    </g>`;
  } else if (rank===12){ // 骑
    body = `<g transform="translate(48,84)">
      <!-- 马 -->
      <path d="M-26,-8 L18,-8 22,6 18,20 -22,20 -26,4 Z" fill="#F5F5DC" stroke="#808080" stroke-width="0.6"/>
      <g transform="translate(20,-12)"><circle cx="0" cy="0" r="6" fill="#F5F5DC"/>
        <polygon points="-4,-8 0,-14 4,-8" fill="#8B4513"/>
        <circle cx="3" cy="-1" r="0.7" fill="#000"/></g>
      <line x1="-20" y1="20" x2="-24" y2="44" stroke="#808080" stroke-width="1.6"/>
      <line x1="14" y1="20" x2="18" y2="44" stroke="#808080" stroke-width="1.6"/>
      <!-- 骑士 -->
      <circle cx="0" cy="-22" r="6" fill="#FFE4B5"/>
      <polygon points="-7,-26 7,-26 5,-32 -5,-32" fill="${color}"/>
      <rect x="-12" y="-16" width="24" height="22" fill="${cloak}"/>
    </g>`;
  } else if (rank===13){ // 后
    body = `<g transform="translate(48,80)">
      <!-- 王座 -->
      <rect x="-24" y="18" width="48" height="50" fill="#DAA520" stroke="#8B4513" stroke-width="0.8"/>
      <rect x="-28" y="12" width="56" height="8" fill="#8B4513"/>
      <!-- 人物 -->
      <circle cx="0" cy="-6" r="8" fill="#FFE4B5"/>
      <!-- 王冠 -->
      <polygon points="-10,-14 -6,-22 -2,-16 2,-22 6,-16 10,-14 8,-10 -8,-10" fill="#FFD700" stroke="#8B6914" stroke-width="0.5"/>
      <circle cx="-6" cy="-16" r="1" fill="#DC143C"/>
      <circle cx="0" cy="-20" r="1" fill="#DC143C"/>
      <circle cx="6" cy="-16" r="1" fill="#DC143C"/>
      <path d="M-18,4 L18,4 24,60 -24,60 Z" fill="${cloak}"/>
      <rect x="-22" y="10" width="44" height="6" fill="#FFD700"/>
    </g>`;
  } else { // 王
    body = `<g transform="translate(48,80)">
      <rect x="-26" y="18" width="52" height="50" fill="#B8860B" stroke="#5C3A1E" stroke-width="0.8"/>
      <rect x="-30" y="12" width="60" height="8" fill="#5C3A1E"/>
      <circle cx="0" cy="-6" r="8" fill="#FFE4B5"/>
      <!-- 王冠 -->
      <polygon points="-12,-14 -8,-24 -4,-18 0,-26 4,-18 8,-24 12,-14 10,-10 -10,-10" fill="#FFD700" stroke="#8B6914" stroke-width="0.5"/>
      <circle cx="-8" cy="-18" r="1.2" fill="#DC143C"/>
      <circle cx="0" cy="-22" r="1.2" fill="#4169E1"/>
      <circle cx="8" cy="-18" r="1.2" fill="#DC143C"/>
      <rect x="-14" y="2" width="28" height="66" fill="${cloak}"/>
      <rect x="-12" y="12" width="24" height="5" fill="#FFD700"/>
      <rect x="-12" y="28" width="24" height="5" fill="#FFD700"/>
      <rect x="-12" y="44" width="24" height="5" fill="#FFD700"/>
    </g>`;
  }
  let suitMark = "";
  if (suit==="wands") suitMark = _wandSVG(14,22,14);
  else if (suit==="cups") suitMark = _cupSVG(14,22,14);
  else if (suit==="swords") suitMark = _swordSVG(14,22,14);
  else suitMark = _pentacleSVG(14,22,14);
  let suitMark2 = "";
  if (suit==="wands") suitMark2 = _wandSVG(82,126,14);
  else if (suit==="cups") suitMark2 = _cupSVG(82,126,14);
  else if (suit==="swords") suitMark2 = _swordSVG(82,126,14);
  else suitMark2 = _pentacleSVG(82,126,14);
  return body + suitMark + suitMark2;
}
function _minorInnerSVG(suit, num){
  const W=96, H=148;
  if (num===1){ return _aceSuitSVG(suit, W, H); }
  if (num>=11){ return _courtSVG(suit, num); }
  const n = num;
  const symFn = {wands:_wandSVG,cups:_cupSVG,swords:_swordSVG,pentacles:_pentacleSVG}[suit];
  const symSize = suit==="pentacles" ? 16 : (suit==="cups"?15:15);
  let pts = [];
  const CX = W/2, UY = 30, LY = H-30, MY = H/2;
  if (n===2) pts = [[CX,UY],[CX,LY]];
  else if (n===3) pts = [[CX,UY],[CX-16,LY],[CX+16,LY]];
  else if (n===4) pts = [[CX-16,UY],[CX+16,UY],[CX-16,LY],[CX+16,LY]];
  else if (n===5) pts = [[CX-18,UY],[CX+18,UY],[CX,MY],[CX-18,LY],[CX+18,LY]];
  else if (n===6) pts = [[CX-18,UY],[CX,UY],[CX+18,UY],[CX-18,LY],[CX,LY],[CX+18,LY]];
  else if (n===7) pts = [[CX-16,UY],[CX+16,UY],[CX-18,MY-12],[CX,MY-12],[CX+18,MY-12],[CX-16,LY],[CX+16,LY]];
  else if (n===8) pts = [[CX-20,UY-4],[CX-6,UY-4],[CX+6,UY-4],[CX+20,UY-4],
                        [CX-20,LY+4],[CX-6,LY+4],[CX+6,LY+4],[CX+20,LY+4]];
  else if (n===9) pts = [[CX-20,UY],[CX,UY],[CX+20,UY],
                        [CX-18,MY],[CX,MY],[CX+18,MY],
                        [CX-20,LY],[CX,LY],[CX+20,LY]];
  else if (n===10) pts = [[CX-24,UY],[CX-12,UY],[CX+12,UY],[CX+24,UY],
                         [CX-10,MY-4],[CX+10,MY-4],
                         [CX-24,LY],[CX-12,LY],[CX+12,LY],[CX+24,LY]];
  let s = "";
  pts.forEach((p,i)=>{
    s += symFn(p[0], p[1], symSize);
  });
  return s;
}

/* --- 5.3  牌阵 & 抽牌交互 --- */
const TAROT_SPREADS = {
  single:   { count:1, name:"单牌占卜",  positions:["当前指引"] },
  triangle: { count:3, name:"圣三角",   positions:["过去影响","现在状况","未来走向"] },
  choice:   { count:5, name:"二选一",   positions:["现状","选项A","A的结果","选项B","B的结果"] }
};
let _tarotSpread = "single";
let _lastTarotResult = null;

function initTarotUI(){
  const tabs = document.getElementById("tarotSpreadTabs");
  if (tabs){
    tabs.addEventListener("click", e=>{
      const t = e.target.closest(".tarot-spread-tab");
      if (!t) return;
      tabs.querySelectorAll(".tarot-spread-tab").forEach(x=>x.classList.toggle("active", x===t));
      _tarotSpread = t.dataset.spread;
      renderTarotBacks();
      document.getElementById("tarot-result").innerHTML = "";
      document.getElementById("tarotDrawBtn").textContent = "🎴 抽 牌";
    });
  }
  renderTarotBacks();
}
function renderTarotBacks(){
  const area = document.getElementById("tarotCardsArea");
  if (!area) return;
  const spread = TAROT_SPREADS[_tarotSpread];
  const positions = spread.positions;
  area.innerHTML = positions.map((_,i)=>`
    <div class="tarot-card-wrap" data-idx="${i}">
      <div class="tarot-card" id="tc_${i}">
        <div class="tarot-face back">${renderTarotBackSVG()}</div>
        <div class="tarot-face front">${renderTarotFaceSVG(0)}</div>
      </div>
      <div class="tarot-pos-label">${positions[i]}</div>
    </div>`).join("");
  const btn = document.getElementById("tarotDrawBtn");
  if (btn) btn.textContent = "🎴 抽 牌";
}
function shufflePick(count){
  const pool = TAROT_DATA.map(x=>x.id);
  for (let i = pool.length-1; i > 0; i--){
    const j = Math.floor(Math.random()*(i+1));
    [pool[i],pool[j]] = [pool[j],pool[i]];
  }
  const picked = pool.slice(0, count);
  return picked.map(id=>({id, reversed: Math.random()<0.4}));
}
function drawTarot(){
  const spread = TAROT_SPREADS[_tarotSpread];
  const cards = shufflePick(spread.count);
  const question = (document.getElementById("tarotQuestion").value||"").trim();
  cards.forEach((c, i)=>{
    const el = document.getElementById("tc_"+i);
    if (!el) return;
    const front = el.querySelector(".tarot-face.front");
    if (front) front.innerHTML = renderTarotFaceSVG(c.id);
    setTimeout(()=>{
      el.classList.add("flipped");
      if (c.reversed) el.classList.add("reversed-face");
      const lab = document.querySelector(`.tarot-card-wrap[data-idx="${i}"] .tarot-pos-label`);
      if (lab) lab.classList.add("show");
    }, 200 + i*200);
  });
  const totalMs = 200 + cards.length*200 + 800;
  setTimeout(()=>{
    const interpretationHTML = renderTarotInterpretation(cards, question, spread);
    document.getElementById("tarot-result").innerHTML = enhanceResultHtml(interpretationHTML);
    document.getElementById("copyBar").style.display = "flex";
    addHistory("tarot", {question, spreadType:_tarotSpread, cards:cards.map(c=>({id:c.id,reversed:c.reversed}))}, {interpretationHTML}, "");
    try{showToast('✅ 排盘完成','success',1200);}catch(_){}
    _lastTarotResult = {cards, question, spread:_tarotSpread, spreadName:spread.name, positions:spread.positions};
    const res = document.getElementById("tarot-result");
    if (res) res.scrollIntoView({behavior:"smooth",block:"start"});
  }, totalMs);
  const btn = document.getElementById("tarotDrawBtn");
  if (btn) btn.textContent = "🔄 重新抽";
}

/* --- 5.4  解读输出 --- */
function classifyQuestion(q){
  if (!q) return ["career","love","choice"];
  const loveK = ["爱","恋","情","对象","感情","伴侣","他","她","关系","喜欢","表白","复合","分手","桃花","婚姻","姻缘","结婚","男友","女友"];
  const careerK = ["工作","事业","公司","offer","项目","面试","赚钱","生意","创业","跳槽","换工作","职场","领导","客户","业绩","工资","投资","财运"];
  const choiceK = ["选","还是","A或B","决定","纠结","两个","二选一","选择"];
  let score = {love:0, career:0, choice:0};
  loveK.forEach(k=>{ if (q.includes(k)) score.love++; });
  careerK.forEach(k=>{ if (q.includes(k)) score.career++; });
  choiceK.forEach(k=>{ if (q.includes(k)) score.choice++; });
  const order = Object.entries(score).sort((a,b)=>b[1]-a[1]).map(x=>x[0]);
  if (order.every(k=>score[k]===0)) return ["career","love","choice"];
  ["career","love","choice"].forEach(k=>{ if (order.indexOf(k)<0) order.push(k); });
  return order;
}
/* 【7.2】由 spread 对象反查 spreadType(single/triangle/choice) */
function _tarotSpreadTypeOf(spread){
  if (!spread) return "";
  for (const k in TAROT_SPREADS){ if (TAROT_SPREADS[k] === spread) return k; }
  if (spread.count === 1) return "single";
  if (spread.count === 3) return "triangle";
  if (spread.count === 5) return "choice";
  return "";
}
/* 【7.2】逆位 + 牌阵位置 的语义引导句（正位或无匹配返回空串）
   - 单牌逆位：当前能量受阻/未发挥
   - 圣三角：过去=未消化课题 / 现在=能量受阻 / 未来=可能错失的机会
   - 二选一：现状=隐藏因素 / 选项=隐患内在矛盾 / 结果=不如预期需额外努力 */
function getReversedPositionHint(spreadType, positionIdx){
  const map = {
    single:   ["这张牌逆位出现，代表当前能量受阻或未能充分发挥，需先正视内在卡点。"],
    triangle: [
      "这张牌逆位出现在过去位置，代表过去尚未解决或未消化的课题仍在影响当下。",
      "这张牌逆位出现在现在位置，代表当前能量受阻、未能发挥，需觉察内在卡点。",
      "这张牌逆位出现在未来位置，提示若不改变当前路径，可能错失本可把握的机会。"
    ],
    choice:   [
      "这张牌逆位出现在现状位置，代表当前处境存在尚未正视的隐藏因素。",
      "这张牌逆位出现在选项A位置，代表该选项暗藏隐患或内在矛盾。",
      "这张牌逆位出现在A的结果位置，代表此路结果不如预期，需额外努力方能如愿。",
      "这张牌逆位出现在选项B位置，代表该选项暗藏隐患或内在矛盾。",
      "这张牌逆位出现在B的结果位置，代表此路结果不如预期，需额外努力方能如愿。"
    ]
  };
  const arr = map[spreadType];
  if (!arr) return "";
  return arr[positionIdx] || "";
}
function renderTarotInterpretation(cards, question, spread){
  const order = classifyQuestion(question);
  const labels = {love:"💞 感情解读",career:"💼 事业/财运",choice:"⚖ 抉择建议"};
  const spreadType = _tarotSpreadTypeOf(spread);
  let html = "";
  cards.forEach((c,i)=>{
    const t = TAROT_DATA[c.id];
    const kw = c.reversed ? t.keywords_r : t.keywords_u;
    const desc = c.reversed ? t.desc_r : t.desc_u;
    const revHint = c.reversed ? getReversedPositionHint(spreadType, i) : "";
    html += `<div class="tarot-intp-card">
      <div class="tarot-intp-head">
        <span class="tarot-intp-pos">【${spread.positions[i]}】</span>
        <span class="tarot-intp-name">${t.name}</span>
        <span class="tarot-ur-badge ${c.reversed?'reversed':'upright'}">${c.reversed?'【逆位】':'【正位】'}</span>
      </div>
      ${revHint?`<div class="tarot-rev-hint">↩ ${revHint}</div>`:""}
      <div class="tarot-kw-row">${kw.map(k=>`<span class="tarot-kw">${k}</span>`).join("")}</div>
      <div class="tarot-desc-block">
        <div class="tarot-desc-t">${labels[order[0]]}</div>
        <div class="tarot-desc-p">${desc[order[0]]}</div>
      </div>
      <div class="tarot-desc-block">
        <div class="tarot-desc-t">${labels[order[1]]}</div>
        <div class="tarot-desc-p">${desc[order[1]]}</div>
      </div>
      <div class="tarot-desc-block">
        <div class="tarot-desc-t">${labels[order[2]]}</div>
        <div class="tarot-desc-p">${desc[order[2]]}</div>
      </div>
    </div>`;
  });
  const allKw = cards.map(c=>{
    const t = TAROT_DATA[c.id];
    return (c.reversed ? t.keywords_r : t.keywords_u).map(k=>`${t.name}·${k}`);
  }).flat();
  const sumArr = [];
  if (cards.length === 1){
    sumArr.push(`本次抽到 ${cards.map(c=>TAROT_DATA[c.id].name+(c.reversed?'(逆)':'(正)')).join("、")}，`);
    sumArr.push(`核心关键词：${allKw.slice(0,6).join("、")}。整体能量指向明确，是关于当下的强烈提示：`);
    const t = TAROT_DATA[cards[0].id];
    sumArr.push((cards[0].reversed ? t.desc_r.choice : t.desc_u.choice) + " ");
    sumArr.push("静心体会这份指引，按直觉行动即可。");
  } else {
    sumArr.push(`本次【${spread.name}】牌阵依次抽到：${cards.map(c=>TAROT_DATA[c.id].name+(c.reversed?'(逆)':'(正)')).join(" → ")}。`);
    sumArr.push(`综合关键词：${allKw.slice(0,8).join("、")}。`);
    const first = cards[0];
    if (cards.length===3){
      const a = TAROT_DATA[first.id], b = TAROT_DATA[cards[1].id], c2 = TAROT_DATA[cards[2].id];
      sumArr.push(`过去由【${a.name}${first.reversed?'(逆)':'(正)'}】主导，${(first.reversed?a.keywords_r:a.keywords_u)[0]}的能量仍然影响你；`);
      sumArr.push(`现在【${b.name}${cards[1].reversed?'(逆)':'(正)'}】是核心状态，建议把握${(cards[1].reversed?b.keywords_r:b.keywords_u)[0]}；`);
      sumArr.push(`未来走向看【${c2.name}${cards[2].reversed?'(逆)':'(正)'}】，最终倾向于${(cards[2].reversed?c2.keywords_r:c2.keywords_u).join("/")}。`);
    } else if (cards.length===5){
      sumArr.push(`当前现状由【${TAROT_DATA[cards[0].id].name}${cards[0].reversed?'(逆)':'(正)'}】定义；`);
      sumArr.push(`走选项A将面对【${TAROT_DATA[cards[1].id].name}${cards[1].reversed?'(逆)':'(正)'}】，结果走向【${TAROT_DATA[cards[2].id].name}${cards[2].reversed?'(逆)':'(正)'}】；`);
      sumArr.push(`走选项B将面对【${TAROT_DATA[cards[3].id].name}${cards[3].reversed?'(逆)':'(正)'}】，结果走向【${TAROT_DATA[cards[4].id].name}${cards[4].reversed?'(逆)':'(正)'}】。`);
      sumArr.push(`对比两条路径的结果牌，哪条更让你动心、代价更小，通常就是更好的答案。`);
    }
  }
  html += `<div class="tarot-sum-box">
    <div class="tarot-sum-title">✨ 综合解读</div>
    <div class="tarot-sum-text">${sumArr.join("")}</div>
  </div>`;
  _tarotCopyBuf = buildTarotCopyText(cards, question, spread);
  return html;
}
let _tarotCopyBuf = "";
function buildTarotCopyText(cards, question, spread){
  const order = classifyQuestion(question);
  const labels = {love:"感情解读",career:"事业/财运",choice:"抉择建议"};
  const arr = [];
  arr.push("【知命V2 韦特塔罗占卜结果】");
  arr.push(`牌阵：${spread.name} (${spread.count}张)`);
  if (question) arr.push(`问题：${question}`);
  arr.push("");
  cards.forEach((c,i)=>{
    const t = TAROT_DATA[c.id];
    const kw = c.reversed ? t.keywords_r : t.keywords_u;
    const desc = c.reversed ? t.desc_r : t.desc_u;
    arr.push(`─── ${spread.positions[i]} ───`);
    arr.push(`牌：${t.name} ${c.reversed?"【逆位】":"【正位】"}`);
    arr.push(`关键词：${kw.join("、")}`);
    arr.push(`${labels[order[0]]}：${desc[order[0]]}`);
    arr.push(`${labels[order[1]]}：${desc[order[1]]}`);
    arr.push(`${labels[order[2]]}：${desc[order[2]]}`);
    arr.push("");
  });
  arr.push("【综合解读】");
  if (cards.length===1){
    arr.push(`本次抽到 ${cards.map(c=>TAROT_DATA[c.id].name+(c.reversed?'(逆)':'(正)')).join("、")}，核心提示如上所述。静心体会并采取相应行动。`);
  } else if (cards.length===3){
    arr.push(`过去→现在→未来：${cards.map(c=>TAROT_DATA[c.id].name+(c.reversed?'(逆)':'(正)')).join(" → ")}`);
    arr.push(`结合三张牌的关键词和三方向解读，按时间线串起自己的故事，寻找下一步行动的钥匙。`);
  } else {
    arr.push(`现状 / 选项A / A结果 / 选项B / B结果：${cards.map(c=>TAROT_DATA[c.id].name+(c.reversed?'(逆)':'(正)')).join(" / ")}`);
    arr.push(`两种路径结果对比，哪个更舒服/代价更小/更契合长期目标，就是更好的选择。`);
  }
  return arr.join("\n");
}

/* --- 5.5  塔罗历史摘要 & 还原 + 复制扩展 --- */
(function extendSummarizeHistTarot(){
  const orig = window.summarizeHist;
  window.summarizeHist = function(h){
    if (h.type === "tarot"){
      try{
        const i = h.input || {};
        const cards = i.cards || [];
        const q = (i.question||"").slice(0,20) || "(无问题)";
        const sp = TAROT_SPREADS[i.spreadType] ? TAROT_SPREADS[i.spreadType].name : "塔罗";
        const thumbs = cards.slice(0,3).map(c=>{
          const face = renderTarotFaceSVG(c.id, 56, 92, c.reversed);
          return `<div class="hi-tt">${face}</div>`;
        }).join("");
        const cardsStr = cards.map(c=>{
          const t = TAROT_DATA[c.id]; return t ? t.name+(c.reversed?"(逆)":"") : "";
        }).filter(Boolean).join("、");
        return `<div class="hi-tarot-thumbs">${thumbs}</div>
          <div><b>${sp}</b> · ${cardsStr}</div>
          <div style="font-size:12px;color:var(--text-sub);">问：${q}</div>`;
      }catch(e){return "塔罗历史";}
    }
    return orig(h);
  };
})();
/* 扩展 summarizeHist 支持 tarot_daily */
(function extendSummarizeTarotDaily(){
  const orig = window.summarizeHist;
  window.summarizeHist = function(h){
    if (h && h.type === "tarot_daily"){
      try{
        const i = h.input || {};
        const t = TAROT_DATA[i.cardId];
        const name = t ? t.name : "塔罗";
        const ur = i.reversed ? "逆" : "正";
        const interp = (h.result && h.result.interpretation) || {};
        const guide = interp.guide ? (" "+String(interp.guide).slice(0,24)) : "";
        return `<b>每日塔罗</b> · ${name}(${ur}) ${i.date||""}${guide}`;
      }catch(e){ return "每日塔罗"; }
    }
    return orig(h);
  };
})();
/* 扩展 restoreHistory 支持 tarot_daily */
(function extendRestoreTarotDaily(){
  const orig = window.restoreHistory;
  window.restoreHistory = function(id){
    const h = getHistory().find(x=>x.id===id);
    if (!h) return;
    if (h.type === "tarot_daily"){
      switchTab("wu"); switchSec("wu","wu1");
      closeHistory();
      return;
    }
    orig(id);
  };
})();
(function extendRestoreHistTarot(){
  const orig = window.restoreHistory;
  window.restoreHistory = function(id){
    const h = getHistory().find(x=>x.id===id);
    if (!h) return;
    if (h.type === "tarot"){
      const i = h.input || {};
      switchTab("wu");
      switchSec("wu","wu1");
      const spreadType = i.spreadType || "single";
      const tabs = document.getElementById("tarotSpreadTabs");
      if (tabs){
        tabs.querySelectorAll(".tarot-spread-tab").forEach(x=>{
          x.classList.toggle("active", x.dataset.spread===spreadType);
        });
        _tarotSpread = spreadType;
      }
      document.getElementById("tarotQuestion").value = i.question||"";
      const cards = i.cards||[];
      const spread = TAROT_SPREADS[spreadType];
      renderTarotBacks();
      cards.forEach((c,i)=>{
        const el = document.getElementById("tc_"+i);
        if (!el) return;
        const front = el.querySelector(".tarot-face.front");
        if (front) front.innerHTML = renderTarotFaceSVG(c.id);
        setTimeout(()=>{
          el.classList.add("flipped");
          if (c.reversed) el.classList.add("reversed-face");
          const lab = document.querySelector(`.tarot-card-wrap[data-idx="${i}"] .tarot-pos-label`);
          if (lab) lab.classList.add("show");
        }, 150 + i*150);
      });
      const total = 150 + cards.length*150 + 400;
      setTimeout(()=>{
        const r = h.result || {};
        document.getElementById("tarot-result").innerHTML = r.interpretationHTML || "";
        document.getElementById("copyBar").style.display = "flex";
        _lastTarotResult = {cards, question:i.question||"", spread:spreadType, spreadName:spread.name, positions:spread.positions};
        _tarotCopyBuf = buildTarotCopyText(cards, i.question||"", spread);
        const res = document.getElementById("tarot-result");
        if (res) res.scrollIntoView({behavior:"smooth",block:"start"});
        closeHistory();
      }, total);
      return;
    }
    orig(id);
  };
})();
(function extendCopyResultTarot(){
  const orig = window.copyResult;
  window.copyResult = function(){
    const activeSec = document.querySelector(".section.active");
    const secId = activeSec ? activeSec.id : "";
    if (secId === "sec-wu2" && _lastZodiacResult){
      const text = buildZodiacCopyText(_lastZodiacResult);
      return _execCopy(text);
    }
    if (secId === "sec-cn2" && _lastWugeResult){
      const text = buildWugeCopyText(_lastWugeResult);
      return _execCopy(text);
    }
    if (secId === "sec-cn3" && _lastZhouyiResult){
      const text = buildZhouyiCopyText(_lastZhouyiResult);
      return _execCopy(text);
    }
    if (secId === "sec-al1"){
      const ab = document.getElementById("almanac-body").innerText || "";
      const text = "【知命V2 黄历】\n" + ab.slice(0,800);
      return _execCopy(text);
    }
    if (_lastTarotResult && (secId==="sec-wu1" || (!_lastBaziResult && !_lastQimenResult))){
      const text = _tarotCopyBuf || buildTarotCopyText(_lastTarotResult.cards, _lastTarotResult.question, {name:_lastTarotResult.spreadName, count:_lastTarotResult.cards.length, positions:_lastTarotResult.positions});
      return _execCopy(text);
    }
    orig();
  };
})();
function _execCopy(text){
  const ta = document.createElement("textarea");
  ta.value = text || "";
  document.body.appendChild(ta); ta.select();
  try{
    document.execCommand("copy");
    try{showToast('📋 已复制到剪贴板','success');}catch(_){}
    const btn = document.getElementById("copyBtn");
    if (!btn) { document.body.removeChild(ta); return; }
    const ot = btn.textContent;
    btn.textContent = "✅ 已复制";
    btn.classList.add("ok");
    setTimeout(()=>{btn.textContent=ot;btn.classList.remove("ok");},1500);
  }catch(e){alert("复制失败,请手动复制:\n"+(text||""));}
  document.body.removeChild(ta);
}

/* 扩展 summarizeHist 支持 wuge/zhouyi/zodiac */
(function extendSummarizeHistPhase6(){
  const orig = window.summarizeHist;
  window.summarizeHist = function(h){
    try{
      if (h.type === "zodiac"){
        const i = h.input || {};
        const z = (ZODIAC_12[i.zodiacIdx]||{});
        const periodNames = ["今日","本周","本月"];
        const pname = periodNames[i.period] || "";
        return `<b>${z.sym||""} ${z.name||""}座</b> ${pname} ${i.date||""} ${(h.note||"").slice(0,16)}`;
      }
      if (h.type === "wuge"){
        const i = h.input || {};
        return `姓名：${i.surname||""}${i.given||""} (姓${i.surnameBi||"?"}画 / 名${i.givenBi||"?"}画)`;
      }
      if (h.type === "zhouyi"){
        const i = h.input || {};
        return `<b>周易</b>：${h.note||""} ${i.question?("问:"+String(i.question).slice(0,14)):""}`;
      }
      if (h.type === "almanac"){
        const i = h.input || {};
        return `黄历：${i.date||""}`;
      }
    }catch(e){}
    return orig(h);
  };
})();
/* 扩展 restoreHistory 支持 wuge/zhouyi/zodiac */
(function extendRestoreHistPhase6(){
  const orig = window.restoreHistory;
  window.restoreHistory = function(id){
    const h = getHistory().find(x=>x.id===id);
    if (!h) return;
    if (h.type === "zodiac"){
      const i = h.input || {};
      switchTab("wu"); switchSec("wu","wu2");
      _curZodiacPeriod = typeof i.period === "number" ? i.period : 0;
      document.querySelectorAll(".period-tab").forEach(el=>el.classList.toggle("active", +el.dataset.p === _curZodiacPeriod));
      selectZodiac(i.zodiacIdx||0);
      closeHistory();
      return;
    }
    if (h.type === "wuge"){
      const i = h.input || {};
      switchTab("cn"); switchSec("cn","cn2");
      document.getElementById("wg-surname").value = i.surname || "";
      document.getElementById("wg-given").value = i.given || "";
      document.getElementById("wg-surname-bi").value = i.surnameBi || "";
      document.getElementById("wg-given-bi").value = i.givenBi || "";
      calcWuge();
      closeHistory();
      return;
    }
    if (h.type === "zhouyi"){
      const i = h.input || {};
      switchTab("cn"); switchSec("cn","cn3");
      document.getElementById("zy-question").value = i.question || "";
      _zyYaos = (i.yaos && i.yaos.length === 6) ? i.yaos.slice() : [];
      if (_zyYaos.length === 6){
        calcZhouyi(false);
      } else {
        calcZhouyi(true);
      }
      closeHistory();
      return;
    }
    orig(id);
  };
})();

/* =========================================================
 *  批次A.1  共振判定 + 多盘主档案
 * =======================================================*/

/* ----- 档案系统常量/变量 ----- */
const PROFILE_KEY = 'zhiming_v2_profiles';
const ACTIVE_PROFILE_KEY = 'zhiming_v2_active_profile';
const PROFILE_EMOJIS = ["👨","👩","👴","👵","👦","👧","🧑","👱","👸","🤴","🧓","👲","🧔","👳","🧕","🧑‍🎓","👨‍💼","👩‍💼","👨‍🔬","👩‍🔬","👨‍💻","👩‍💻","👨‍🎨","👩‍🎨","👨‍🍳","👩‍🍳","🐱","🐶","🐰","🦊","🐻","🐼"];
const ZHOUYI_SCORE_MAP = {"乾为天":2,"坤为地":2,"地天泰":3,"天地否":-3,"火天大有":2,"地山谦":2,"雷地豫":1,"泽雷随":2,"地泽临":1,"风地观":1,"山地剥":-2,"地雷复":1,"天雷无妄":2,"山天大畜":1,"山雷颐":1,"坎为水":0,"离为火":1,"泽山咸":1,"雷风恒":1,"天山遯":1,"雷天大壮":0,"火地晋":1,"地火明夷":-2,"风火家人":1,"火泽睽":-1,"水山蹇":-1,"雷水解":1,"山泽损":1,"风雷益":2,"泽天夬":0,"天风姤":0,"泽地萃":1,"地风升":1,"泽水困":-2,"水风井":1,"泽火革":1,"火风鼎":2,"震为雷":0,"艮为山":0,"风山渐":1,"雷泽归妹":0,"雷火丰":1,"火山旅":0,"巽为风":1,"兑为泽":1,"风水涣":1,"水泽节":1,"风泽中孚":2,"雷山小过":0,"水火既济":1,"火水未济":0};
const TAROT_GOOD_KW = ["成功","胜利","圆满","幸福","美满","喜悦","快乐","爱情","热情","创造","新开始","机会","机遇","希望","光明","丰盛","富足","财富","健康","活力","平衡","和谐","和平","自由","成长","前进","突破","胜利","丰收","奖励","认可","赞誉","贵人","友谊","合作","承诺","信任","信念","信心","勇气","智慧","灵感","创意","领导","稳定","安全","保护","治愈","修复","重生","复兴","觉醒","启蒙","连接","统一","完成","实现","达成","回报"];
const TAROT_BAD_KW = ["失败","挫折","阻碍","困难","痛苦","悲伤","绝望","恐惧","焦虑","紧张","冲突","争吵","分离","背叛","欺骗","谎言","隐瞒","损失","失去","匮乏","贫穷","债务","疾病","虚弱","疲惫","倦怠","混乱","动荡","不稳定","叛逆","固执","任性","沉迷","上瘾","堕落","危险","警告","危机","压力","压迫","束缚","限制","囚禁","孤独","孤立","冷漠","无情","报复","仇恨","嫉妒","贪婪","自私","懒惰","拖延","犹豫","迷茫","迷失","沉沦","崩溃","结束","毁灭"];
let _profiles = [];
let _activeProfileId = null;
let _lastGongzhenResult = null;
let _profileEditingId = null;
let _profileSelEmoji = "👨";

/* ----- 档案：加载/保存 ----- */
function loadProfiles(){
  try{
    const raw = localStorage.getItem(PROFILE_KEY);
    _profiles = raw ? JSON.parse(raw) : [];
  }catch(e){ _profiles = []; }
  try{
    _activeProfileId = localStorage.getItem(ACTIVE_PROFILE_KEY);
  }catch(e){ _activeProfileId = null; }
  if (!Array.isArray(_profiles)) _profiles = [];
  updateTopProfileBadge();
  return _profiles;
}
function saveProfiles(){
  try{ localStorage.setItem(PROFILE_KEY, JSON.stringify(_profiles)); }catch(e){}
}
function getActiveProfile(){
  if (!_activeProfileId) return null;
  return _profiles.find(p => p.id === _activeProfileId) || null;
}
function updateTopProfileBadge(){
  const badge = document.getElementById("profileBadge");
  if (!badge) return;
  const p = getActiveProfile();
  if (!p){ badge.style.display = "none"; return; }
  const short = (p.name || "?").slice(0, 2);
  badge.textContent = (p.emoji || "👤") + short;
  badge.style.display = "";
}
function findCityByLng(lng){
  let found = null;
  Object.values(CITIES).forEach(arr => {
    arr.forEach(c => {
      if (Math.abs(c.lng - lng) < 0.1) found = c;
    });
  });
  return found;
}
function fillFormWithProfile(p){
  if (!p) return;
  const by = document.getElementById("bz-year");
  if (by) by.value = p.year || "";
  const bm = document.getElementById("bz-month");
  if (bm) bm.value = p.month || "";
  const bd = document.getElementById("bz-day");
  if (bd) bd.value = p.day || "";
  const bh = document.getElementById("bz-hour");
  if (bh) bh.value = p.hour || "12";
  const bmi = document.getElementById("bz-minute");
  if (bmi) bmi.value = p.minute || "30";
  const gr = document.querySelector(`input[name="bz-gender"][value="${p.gender||"男"}"]`);
  if (gr) gr.checked = true;
  const bzCitySel = document.getElementById("bz-city");
  if (bzCitySel){
    if (p.cityLng !== undefined && p.cityLng !== null){
      let match = false;
      bzCitySel.querySelectorAll("option").forEach(o=>{
        if (Math.abs((+o.value) - p.cityLng) < 0.1){ bzCitySel.value = o.value; match = true; }
      });
      if (!match){
        bzCitySel.value = "__custom__";
        const w = document.getElementById("customLngWrap");
        if (w) w.style.display = "block";
        const cl = document.getElementById("bz-customLng");
        if (cl) cl.value = p.cityLng;
      } else {
        const w = document.getElementById("customLngWrap");
        if (w) w.style.display = "none";
      }
    }
  }
  if (typeof detectZodiacIdx === "function" && p.month && p.day){
    const zIdx = detectZodiacIdx(+p.month, +p.day);
    if (typeof selectZodiac === "function") selectZodiac(zIdx, false);
    if (typeof renderZodiac === "function") renderZodiac();
    const bdm = document.getElementById("bd-month");
    const bdd = document.getElementById("bd-day");
    if (bdm) bdm.value = p.month;
    if (bdd) bdd.value = p.day;
    try{ localStorage.setItem("zhiming_zodiac_idx", String(zIdx)); }catch(e){}
  }
}
function setActiveProfile(id){
  _activeProfileId = id || null;
  try{
    if (_activeProfileId) localStorage.setItem(ACTIVE_PROFILE_KEY, _activeProfileId);
    else localStorage.removeItem(ACTIVE_PROFILE_KEY);
  }catch(e){}
  updateTopProfileBadge();
  const p = getActiveProfile();
  if (p) fillFormWithProfile(p);
  if (typeof renderToday === "function") renderToday();
  renderProfilesUI();
}
function addProfile(data){
  const p = Object.assign({
    id: "p_" + Date.now() + "_" + Math.random().toString(36).slice(2,6),
    emoji: "👤", name: "", gender: "男",
    year: 1998, month: 6, day: 15, hour: 12, minute: 30,
    cityName: "北京", cityLng: 116.407, note: ""
  }, data || {});
  _profiles.push(p);
  saveProfiles();
  return p;
}
function updateProfile(id, patch){
  const i = _profiles.findIndex(x=>x.id===id);
  if (i < 0) return;
  _profiles[i] = Object.assign({}, _profiles[i], patch || {});
  saveProfiles();
}
function deleteProfile(id){
  _profiles = _profiles.filter(x=>x.id!==id);
  if (_activeProfileId === id){
    _activeProfileId = null;
    try{ localStorage.removeItem(ACTIVE_PROFILE_KEY); }catch(e){}
    updateTopProfileBadge();
  }
  saveProfiles();
}
function cityOptionsForProfile(selectedLng){
  let html = "";
  Object.entries(CITIES).forEach(([group,arr])=>{
    html += `<optgroup label="${group}">`;
    arr.forEach(c=>{
      const sel = (selectedLng !== undefined && Math.abs(c.lng - selectedLng) < 0.1) ? " selected" : "";
      html += `<option value="${isNaN(c.lng)?'__custom__':c.lng}" data-lat="${c.lat}"${sel}>${c.n}</option>`;
    });
    html += `</optgroup>`;
  });
  return html;
}
function renderProfilesUI(){
  const body = document.getElementById("profileModalBody");
  if (!body) return;
  const active = getActiveProfile();
  const activeCard = active ? `
    <div class="pf-active-card">
      <div class="pf-active-emoji">${active.emoji||"👤"}</div>
      <div class="pf-active-info">
        <div class="pf-active-name">${active.name||"(无姓名)"}</div>
        <div class="pf-active-meta">
          🎂 ${active.year||"-"}-${String(active.month||0).padStart(2,"0")}-${String(active.day||0).padStart(2,"0")} ${String(active.hour||0).padStart(2,"0")}:${String(active.minute||0).padStart(2,"0")}<br>
          📍 ${active.cityName||"-"} · ${active.gender||"-"}
        </div>
      </div>
      <span class="pf-active-badge">⭐当前</span>
    </div>` : `<div class="card" style="padding:14px;text-align:center;color:var(--text-hint);">尚未选择当前人物，请在下方列表设为当前或新增档案。</div>`;

  const tpls = [
    {emoji:"👨", name:"我", gender:"男"},
    {emoji:"👩", name:"伴侣", gender:"女"},
    {emoji:"👴", name:"父亲", gender:"男"},
    {emoji:"👵", name:"母亲", gender:"女"},
    {emoji:"👧", name:"孩子", gender:"女"}
  ];
  const tplRow = `<div class="pf-tpl-row">
    ${tpls.map(t=>`<button class="pf-tpl-btn" onclick='quickAddProfile(${JSON.stringify(t)})'>${t.emoji} ${t.name}</button>`).join("")}
    <button class="pf-tpl-btn add" onclick="openProfileForm(null)">＋ 自定义</button>
  </div>`;

  let listHtml = "";
  if (_profiles.length === 0){
    listHtml = `<div class="hist-empty">暂无档案，点击上方快速模板或「＋自定义」创建人物</div>`;
  } else {
    listHtml = _profiles.map(p => {
      const isActive = (p.id === _activeProfileId);
      return `<div class="pf-list-item ${isActive?'active':''}">
        <div class="pf-emoji">${p.emoji||"👤"}</div>
        <div class="pf-info">
          <div class="pf-name">${p.name||"(无姓名)"}</div>
          <div class="pf-note">🎂 ${p.year||"-"}/${String(p.month||0).padStart(2,"0")}/${String(p.day||0).padStart(2,"0")} · 📍 ${p.cityName||"-"} ${p.note?`· ${p.note}`:""}</div>
        </div>
        <div class="pf-actions">
          ${!isActive ? `<button class="pf-act-btn set" title="设为当前" onclick="setActiveProfile('${p.id}')">⭐</button>` : ``}
          <button class="pf-act-btn" title="编辑" onclick="openProfileForm('${p.id}')">✎</button>
          <button class="pf-act-btn del" title="删除" onclick="confirmDeleteProfile('${p.id}')">✕</button>
        </div>
      </div>`;
    }).join("");
  }

  body.innerHTML = `
    ${activeCard}
    ${tplRow}
    <div class="card-title" style="font-size:14px;color:var(--pri-dark);font-weight:700;margin-bottom:8px;">📋 档案列表 (${_profiles.length})</div>
    ${listHtml}
    <div id="profileFormArea" style="margin-top:14px;"></div>
  `;
}
function quickAddProfile(tpl){
  const now = new Date();
  const y = (tpl.name === "我") ? 1998 : (tpl.name === "父亲" || tpl.name === "母亲") ? 1968 : (tpl.name === "伴侣") ? 1998 : 2018;
  const p = addProfile({
    emoji: tpl.emoji, name: tpl.name, gender: tpl.gender,
    year: y, month: now.getMonth()+1, day: Math.min(now.getDate(),28),
    hour: 12, minute: 0, cityName: "北京", cityLng: 116.407
  });
  setActiveProfile(p.id);
}
function confirmDeleteProfile(id){
  if (!confirm("确定删除该档案？此操作不可撤销。")) return;
  deleteProfile(id);
  renderProfilesUI();
}
function openProfileForm(id){
  const area = document.getElementById("profileFormArea");
  if (!area) return;
  let p;
  if (id){
    p = _profiles.find(x=>x.id===id);
    if (!p) return;
    _profileEditingId = id;
    _profileSelEmoji = p.emoji || "👤";
  } else {
    _profileEditingId = null;
    _profileSelEmoji = "👨";
    const now = new Date();
    p = {emoji:"👨", name:"", gender:"男", year:now.getFullYear()-25, month:now.getMonth()+1, day:Math.min(now.getDate(),28), hour:12, minute:0, cityName:"北京", cityLng:116.407, note:""};
  }
  const emojiGrid = PROFILE_EMOJIS.map(e=>`<button class="pf-emoji-btn ${e===_profileSelEmoji?'sel':''}" onclick="profilePickEmoji('${e}', this)">${e}</button>`).join("");
  area.innerHTML = `
    <div class="card" style="border-color:var(--pri);">
      <div class="card-title">${id?'✎ 编辑档案':'＋ 新增档案'}</div>
      <div class="form-row"><label>头像 Emoji</label><div class="pf-emoji-picker">${emojiGrid}</div></div>
      <div class="form-row"><label>姓名</label><input type="text" id="pf-name" placeholder="如：张三" value="${p.name||""}"></div>
      <div class="form-row"><label>性别</label><div class="radio-group">
        <label><input type="radio" name="pf-gender" value="男" ${p.gender!=="女"?"checked":""}><span>男</span></label>
        <label><input type="radio" name="pf-gender" value="女" ${p.gender==="女"?"checked":""}><span>女</span></label>
      </div></div>
      <div class="form-row"><label>生日（公历）</label><div class="inputs inline-3">
        <input type="number" id="pf-year" placeholder="年" min="1900" max="2100" value="${p.year||""}">
        <input type="number" id="pf-month" placeholder="月" min="1" max="12" value="${p.month||""}">
        <input type="number" id="pf-day" placeholder="日" min="1" max="31" value="${p.day||""}"></div></div>
      <div class="form-row"><label>出生时间</label><div class="inputs inline-2">
        <input type="number" id="pf-hour" placeholder="时0-23" min="0" max="23" value="${p.hour||0}">
        <input type="number" id="pf-minute" placeholder="分0-59" min="0" max="59" value="${p.minute||0}"></div></div>
      <div class="form-row"><label>出生城市</label>
        <select id="pf-city">${cityOptionsForProfile(p.cityLng)}</select>
      </div>
      <div class="form-row"><label>备注（可选）</label><input type="text" id="pf-note" placeholder="如：客户/朋友/客户A" value="${p.note||""}"></div>
      <div style="display:flex;gap:8px;">
        <button class="btn-secondary" style="flex:1;" onclick="document.getElementById('profileFormArea').innerHTML='';">取消</button>
        <button class="btn-primary" style="flex:1;" onclick="submitProfileForm()">保 存</button>
      </div>
    </div>
  `;
  setTimeout(()=>area.scrollIntoView({behavior:"smooth",block:"nearest"}), 50);
}
function profilePickEmoji(e, btn){
  _profileSelEmoji = e;
  const box = btn.parentElement;
  if (box){
    box.querySelectorAll(".pf-emoji-btn").forEach(b=>b.classList.remove("sel"));
    btn.classList.add("sel");
  }
}
function submitProfileForm(){
  const name = (document.getElementById("pf-name").value||"").trim();
  if (!name){ alert("请填写姓名"); return; }
  const year = +document.getElementById("pf-year").value;
  const month = +document.getElementById("pf-month").value;
  const day = +document.getElementById("pf-day").value;
  if (!year || !month || !day){ alert("请填写完整生日年月日"); return; }
  const hour = +document.getElementById("pf-hour").value || 0;
  const minute = +document.getElementById("pf-minute").value || 0;
  const gender = document.querySelector('input[name="pf-gender"]:checked').value;
  const sel = document.getElementById("pf-city");
  let cityLng = +sel.value, cityName = "北京";
  const selOpt = sel.options[sel.selectedIndex];
  if (selOpt) cityName = selOpt.textContent;
  const note = (document.getElementById("pf-note").value||"").trim();
  const patch = {emoji:_profileSelEmoji, name, gender, year, month, day, hour, minute, cityName, cityLng, note};
  if (_profileEditingId){
    updateProfile(_profileEditingId, patch);
    if (_activeProfileId === _profileEditingId) fillFormWithProfile(getActiveProfile());
  } else {
    const np = addProfile(patch);
    if (!_activeProfileId) setActiveProfile(np.id);
  }
  renderProfilesUI();
  updateTopProfileBadge();
}
function openProfileModal(){
  loadProfiles();
  renderProfilesUI();
  const m = document.getElementById("profileModal");
  if (m) m.classList.add("show");
}
function closeProfileModal(){
  const m = document.getElementById("profileModal");
  if (m) m.classList.remove("show");
}

/* ----- 共振判定：城市选择初始化 ----- */
function buildGongzhenCitySelect(){
  const sel = document.getElementById("gz-city");
  if (!sel) return;
  let html = "";
  Object.entries(CITIES).forEach(([group,arr])=>{
    html += `<optgroup label="${group}">`;
    arr.forEach(c=>{
      html += `<option value="${isNaN(c.lng)?'__custom__':c.lng}" data-lat="${c.lat}">${c.n}</option>`;
    });
    html += `</optgroup>`;
  });
  sel.innerHTML = html;
  sel.value = String(116.407);
  const now = new Date();
  document.getElementById("gz-year").value = now.getFullYear();
  document.getElementById("gz-month").value = now.getMonth()+1;
  document.getElementById("gz-day").value = now.getDate();
  document.getElementById("gz-hour").value = now.getHours();
  document.getElementById("gz-minute").value = now.getMinutes();
}
function onGzCityChange(){
  const sel = document.getElementById("gz-city");
  const wrap = document.getElementById("gz-customLngWrap");
  if (!sel || !wrap) return;
  wrap.style.display = sel.value === "__custom__" ? "block" : "none";
}

/* ----- 共振判定：核心算法 ----- */
function gongzhenCalc(question, y, m, d, h, minute, city, gender){
  const q = (question || "").trim();
  const Q = q || "未定问题";
  const lng = (city && typeof city === "object") ? (city.lng !== undefined ? city.lng : 116.407) : (typeof city === "number" ? city : 116.407);

  let qimenScore = 0;
  let qimenSummary = "";
  let qimenGood = 0, qimenBad = 0;
  try{
    const qr = qimenCalc({y, m, d, h, minute, cityLng: lng, gender: gender || "男", question: Q});
    qimenGood = (qr.goodGe || []).length;
    qimenBad  = (qr.badGe  || []).length;
    let diff = qimenGood - qimenBad;
    if (diff > 3) diff = 3;
    if (diff < -3) diff = -3;
    qimenScore = diff;
    const geDiff = qimenGood - qimenBad;
    let overStr = "";
    if (geDiff >= 2) overStr = "吉";
    else if (geDiff <= -2) overStr = "凶";
    qimenSummary = `吉格${qimenGood}/凶格${qimenBad}`;
    if (overStr === "吉") qimenScore += 1;
    if (overStr === "凶") qimenScore -= 1;
  }catch(e){
    qimenScore = 0;
    qimenSummary = "奇门计算异常";
  }
  const qimenDot = qimenScore >= 2 ? "g" : (qimenScore <= -2 ? "r" : "y");
  const qimenFinalScore = qimenScore;

  const hIdx = (() => {
    if (h === 23 || h === 0) return 0;
    return Math.floor((h + 1) / 2);
  })();
  const xlrIdx = (((m-1)+(d-1)+hIdx) % 6 + 6) % 6;
  const xlrG = XIAOLIUREN_DATA[xlrIdx];
  const XLR_SCORE = {大安:2,留连:-2,速喜:2,赤口:-2,小吉:2,空亡:-2};
  const xlrScore = XLR_SCORE[xlrG.name] || 0;
  const xlrSummary = `${xlrG.name}·${xlrG.jx}(${xlrG.kw.slice(0,2).join("/")})`;
  const xlrDot = xlrScore > 0 ? "g" : "r";

  let seed = 0;
  for (let i = 0; i < Q.length; i++) seed += Q.codePointAt(i) || 0;
  seed = (seed * 131) >>> 0;
  function nextRand(s){ return ((s * 1664525 + 1013904223) >>> 0); }
  let s = seed;
  const yaos = [];
  for (let i = 0; i < 6; i++){
    s = nextRand(s);
    const r = (s % 4); // 0..3 → 6..9
    yaos.push(6 + r);
  }
  function triIdx3(arr, start){
    const y = arr.map(v => (v===7||v===9)?1:0);
    return (y[start]<<0)|(y[start+1]<<1)|(y[start+2]<<2);
  }
  const benXia = triIdx3(yaos, 0), benShang = triIdx3(yaos, 3);
  const benIdx = (benXia<<3)|benShang;
  const guaName = hexNameByIndex(benIdx);
  const zyScore = (ZHOUYI_SCORE_MAP[guaName] !== undefined) ? ZHOUYI_SCORE_MAP[guaName] : 0;
  const zySummary = `${guaName}`;
  const zyDot = zyScore > 0 ? "g" : (zyScore < 0 ? "r" : "y");

  let sumCp = 0;
  for (let i = 0; i < Q.length; i++) sumCp += Q.codePointAt(i) || 0;
  const cardId = ((sumCp * 7 + m * 31 + d) % 78 + 78) % 78;
  const reversed = (sumCp % 3 === 0);
  const tCard = TAROT_DATA[cardId];
  let tarotScore = 1;
  let tarotHit = "中";
  if (tCard){
    const desc = (reversed ? (tCard.desc_r || "") : (tCard.desc_u || "")) + " " + (reversed ? (tCard.keywords_r || []).join(" ") : (tCard.keywords_u || []).join(" "));
    let goodHit = 0, badHit = 0;
    TAROT_GOOD_KW.forEach(k=>{ if (desc.indexOf(k)>=0) goodHit++; });
    TAROT_BAD_KW.forEach(k=>{ if (desc.indexOf(k)>=0) badHit++; });
    if (goodHit > badHit) { tarotScore = 2; tarotHit = "吉"; }
    else if (badHit > goodHit) { tarotScore = -2; tarotHit = "凶"; }
    else { tarotScore = 1; tarotHit = "中"; }
  }
  if (reversed) tarotScore = -tarotScore;
  const tName = tCard ? tCard.name : "未知牌";
  const tUrStr = reversed ? "逆位" : "正位";
  const tarotSummary = `${tUrStr}·${tName}(${tarotHit})`;
  const tarotDot = tarotScore > 0 ? "g" : (tarotScore < 0 ? "r" : "y");

  const rawTotal = qimenFinalScore * 2 + xlrScore * 1.5 + zyScore * 1.5 + tarotScore * 1;
  const totalScore = Math.round(rawTotal);
  let level = "", levelCls = "y", levelColor = "#B8860B", emoji = "🟡";
  if (totalScore >= 8)      { level = "高度一致吉"; levelCls = "g"; levelColor = "#27AE60"; emoji = "🟢"; }
  else if (totalScore >= 3) { level = "大概率吉";   levelCls = "g"; levelColor = "#27AE60"; emoji = "🟢"; }
  else if (totalScore >= -2){ level = "中性持平";   levelCls = "y"; levelColor = "#B8860B"; emoji = "🟡"; }
  else if (totalScore >= -7){ level = "大概率不利"; levelCls = "r"; levelColor = "#C0392B"; emoji = "🔴"; }
  else                      { level = "强烈不建议"; levelCls = "r"; levelColor = "#C0392B"; emoji = "🔴"; }

  let cat = "decision";
  if (/面试|offer|工作|项目|合作|职业|事业|考试|入职|晋升|加薪|跳槽|客户|合同|投资|创业|生意|业绩|公司|岗位|实习/.test(Q)) cat = "career";
  else if (/他|她|爱|情|对象|伴侣|感情|恋爱|暧昧|桃花|复合|分手|结婚|婚姻|相亲|告白|喜欢|追求|前任|恋情|约会/.test(Q)) cat = "love";
  const advice = {career:"", love:"", decision:""};
  if (totalScore >= 3){
    advice.career = "事业/决策面四法整体偏吉，关键节点可果断推进：面试/签约/项目启动正当时，注意提前梳理细节清单，借助贵人与现有资源乘势而为，可预留一成冗余应对意外小波折。";
    advice.love   = "感情气场顺遂吉多凶少：单身者近期易出现正缘信号，有伴者关系进入升温期，适合安排约会、告白或深度沟通；若涉及重大承诺（求婚/见家长）可趁此窗口推进。";
    advice.decision = "综合结论偏吉：建议主动出击、把握当前窗口，不要因过度犹豫而错过时机。执行时优先选择方案中最稳健的那条路径，同时保留一个备用方案以防万一。";
  } else if (totalScore <= -3){
    advice.career = "事业/决策面凶信号偏多：面试、签约、投资、新立项建议暂缓至少3-5天重新评估；现有项目多核查合同、对接人与资金链路，慎防口头承诺与信息差，换岗跳槽宜再观望。";
    advice.love   = "感情波动偏大：近期容易因误会、言语或第三方信息引发争吵。建议先冷静独处2-3天再沟通，不适合此时做分手、告白或订婚等重大决定，以守代攻更稳妥。";
    advice.decision = "综合结论偏凶：强烈不建议在此时做重大选择。把原计划推迟到下次更合适的时机，或先做小规模的试验性动作（而非全面投入），同时做好最坏情形的应对预案。";
  } else {
    advice.career = "事业面中性持平：四法信号不够统一，不宜一次性all-in。建议采用小步快跑、试错迭代的方式推进——先做最小可行验证，根据反馈再决定是否扩大投入；合作上留书面备忘。";
    advice.love   = "感情气场中性：既非大爆发也非低谷期，适合按兵不动、观察节奏。与其推进重大节点，不如专注日常细节的经营——一次深入对话、一次共同体验往往比大动作更有效。";
    advice.decision = "综合结论中性持平：四法意见不统一，说明此事本身变数较大、信息不够充分。建议再收集更多信息、请教2-3位不同视角的人，必要时拖延几天再做决定，切忌凭一时冲动拍板。";
  }

  return {
    methods: [
      {name:"奇门遁甲", score: qimenFinalScore, dot: qimenDot, summary: qimenSummary, goodCnt: qimenGood, badCnt: qimenBad},
      {name:"小六壬",  score: xlrScore, dot: xlrDot, summary: xlrSummary, gong: xlrG ? xlrG.name : ""},
      {name:"周易起卦", score: zyScore, dot: zyDot, summary: zySummary, guaName},
      {name:"塔罗单牌", score: tarotScore, dot: tarotDot, summary: tarotSummary, cardId, reversed, tName: tCard && tCard.name}
    ],
    totalScore, level, levelCls, levelColor, emoji,
    category: cat, advice,
    weight: {qimen:2, xiaoliuren:1.5, zhouyi:1.5, tarot:1},
    input: {question:Q, y,m,d,h,minute,cityLng:lng,gender:gender||"男"}
  };
}

/* ----- 共振判定：UI渲染 ----- */
function calcGongzhen(){
  const question = (document.getElementById("gz-question").value||"").trim();
  if (!question){ alert("请先填写所问之事"); return; }
  const y = +document.getElementById("gz-year").value;
  const m = +document.getElementById("gz-month").value;
  const d = +document.getElementById("gz-day").value;
  const h = +document.getElementById("gz-hour").value;
  const mn = +document.getElementById("gz-minute").value;
  const gd = document.querySelector('input[name="gz-gender"]:checked').value;
  const sel = document.getElementById("gz-city");
  let lng;
  if (sel.value === "__custom__") lng = +document.getElementById("gz-customLng").value || 116.4;
  else lng = +sel.value;
  if (!y||!m||!d){ alert("请填写完整的问事年月日"); return; }

  const r = gongzhenCalc(question, y, m, d, h, mn, {lng}, gd);
  _lastGongzhenResult = r;
  const cityName = (()=>{
    const o = sel.options[sel.selectedIndex];
    return o ? o.textContent : "自定义";
  })();

  const mHtml = r.methods.map(m => `
    <div class="gz-mcard">
      <div class="gz-head">
        <span class="gz-mname">${m.name}</span>
        <span class="gz-score" style="color:${m.dot==='g'?'var(--good)':(m.dot==='r'?'var(--bad)':'var(--warn)')};">
          ${m.score>0?'+':''}${m.score}<span class="gz-dot ${m.dot}"></span>
        </span>
      </div>
      <div class="gz-summary">${m.summary}</div>
    </div>
  `).join("");

  const catTitle = r.category === "career" ? "💼 事业建议" : (r.category === "love" ? "💞 感情建议" : "⚖ 综合决策建议");
  const catText = r.category === "career" ? r.advice.career : (r.category === "love" ? r.advice.love : r.advice.decision);

  const ratio = Math.max(-14, Math.min(14, r.totalScore));
  const pct = Math.round((ratio + 14) / 28 * 100);

  const html = `
    <div class="card">
      <div class="card-title">📝 判定输入</div>
      <div class="kv"><span class="k">所问之事</span><span class="v" style="color:var(--pri-dark);font-weight:700;">${question}</span></div>
      <div class="kv"><span class="k">时间</span><span class="v">${y}-${String(m).padStart(2,"0")}-${String(d).padStart(2,"0")} ${String(h).padStart(2,"0")}:${String(mn).padStart(2,"0")}</span></div>
      <div class="kv"><span class="k">城市 / 性别</span><span class="v">${cityName} · ${gd}</span></div>
    </div>

    <div class="card">
      <div class="card-title">🧭 四法各自判定</div>
      <div class="gz-grid">${mHtml}</div>
      <div class="hint">加权系数：奇门×2 / 六壬×1.5 / 周易×1.5 / 塔罗×1</div>
    </div>

    <div class="gz-overall" style="border-color:${r.levelColor};">
      <div class="gz-level" style="color:${r.levelColor};">${r.emoji} ${r.level}</div>
      <div class="gz-total" style="color:${r.levelColor};">${r.totalScore>0?'+':''}${r.totalScore}<span style="font-size:16px;color:var(--text-hint);font-weight:500;"> / 14</span></div>
      <div class="gz-range">理论区间 -14 ~ +14</div>
      <div style="height:10px;background:var(--track-bg);border-radius:5px;overflow:hidden;max-width:360px;margin:0 auto;">
        <div style="width:${pct}%;height:100%;background:${r.levelColor};border-radius:5px;transition:width .5s;"></div>
      </div>
    </div>

    <div class="card">
      <div class="card-title">💡 三方向建议</div>
      <div class="gz-advice">
        <div class="adv-block"><div class="adv-title">💼 事业/合作</div><div class="adv-text">${r.advice.career}</div></div>
        <div class="adv-block"><div class="adv-title">💞 感情/人际</div><div class="adv-text">${r.advice.love}</div></div>
        <div class="adv-block"><div class="adv-title">${catTitle}</div><div class="adv-text" style="font-weight:600;color:var(--text);">${catText}</div></div>
      </div>
    </div>
    <div class="hint">※ 本结果综合四法模型加权，仅供娱乐与自我觉察之用，不构成任何决策建议。</div>
  `;

  document.getElementById("gz-result").innerHTML = enhanceResultHtml(html);
  document.getElementById("copyBar").style.display = "flex";
  addHistory("gongzhen",
    {question, year:y,month:m,day:d,hour:h,minute:mn,gender:gd,cityLng:lng,cityName},
    r,
    `${r.emoji}${r.level} 总分${r.totalScore}`
  );
  try{showToast('✅ 排盘完成','success',1200);}catch(_){}
  setTimeout(()=>document.getElementById("gz-result").scrollIntoView({behavior:"smooth",block:"start"}),80);
}
function buildGongzhenCopyText(r){
  if (!r) return "";
  const lines = ["【知命V2 · 四法共振判定】"];
  const inp = r.input || {};
  lines.push(`问题：${inp.question || ""}`);
  lines.push(`时间：${inp.y||""}-${String(inp.m||0).padStart(2,"0")}-${String(inp.d||0).padStart(2,"0")} ${String(inp.h||0).padStart(2,"0")}:${String(inp.minute||0).padStart(2,"0")}  性别：${inp.gender||""}`);
  lines.push("");
  (r.methods||[]).forEach(m=>{
    lines.push(`【${m.name}】 ${m.score>0?'+':''}${m.score}  ${m.summary}`);
  });
  lines.push("");
  lines.push(`综合总分：${r.totalScore>0?'+':''}${r.totalScore} / 14`);
  lines.push(`判定级别：${r.emoji} ${r.level}`);
  lines.push("");
  lines.push("事业建议：" + (r.advice&&r.advice.career||""));
  lines.push("感情建议：" + (r.advice&&r.advice.love||""));
  lines.push("决策建议：" + (r.advice&&r.advice.decision||""));
  lines.push("");
  lines.push("—— 四法共振，仅供娱乐与自我觉察 ——");
  return lines.join("\n");
}

/* ----- 扩展：restoreHistory 增加 gongzhen ----- */
(function extendRestoreHistGongzhen(){
  const orig = window.restoreHistory;
  window.restoreHistory = function(id){
    const h = getHistory().find(x=>x.id===id);
    if (!h) return;
    if (h.type === "gongzhen"){
      const i = h.input || {};
      switchTab("cn"); switchSec("cn","cn1c");
      document.getElementById("gz-question").value = i.question || "";
      document.getElementById("gz-year").value = i.year || "";
      document.getElementById("gz-month").value = i.month || "";
      document.getElementById("gz-day").value = i.day || "";
      document.getElementById("gz-hour").value = i.hour || "";
      document.getElementById("gz-minute").value = i.minute || 0;
      const g = document.querySelector(`input[name="gz-gender"][value="${i.gender||"男"}"]`);
      if (g) g.checked = true;
      if (i.cityLng){
        const sel = document.getElementById("gz-city");
        let match = false;
        if (sel){
          sel.querySelectorAll("option").forEach(o=>{
            if (o.value !== "__custom__" && Math.abs((+o.value) - i.cityLng) < 0.1){ sel.value = o.value; match = true; }
          });
        }
        const wrap = document.getElementById("gz-customLngWrap");
        const lngInput = document.getElementById("gz-customLng");
        if (!match && wrap && lngInput){
          sel.value = "__custom__";
          wrap.style.display = "block";
          lngInput.value = i.cityLng;
        } else if (wrap){
          wrap.style.display = "none";
        }
      }
      closeHistory();
      calcGongzhen();
      return;
    }
    orig(id);
  };
})();

