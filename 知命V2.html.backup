        <!-- 跳舞女人+丝带 -->
        <g transform="translate(48,74)">
          <ellipse cx="0" cy="-2" rx="8" ry="16" fill="none" stroke="#8B008B" stroke-width="1.5"/>
          <circle cx="0" cy="-16" r="6" fill="#FFE4B5"/>
