<!-- ===== 历史 Modal ===== -->
<div class="modal-mask" id="histModal" onclick="if(event.target===this)closeHistory()">
  <div class="modal">
    <div class="modal-head">
      <h3>📚 历史记录</h3>
      <button class="modal-close" onclick="closeHistory()">✕</button>
    </div>
    <div class="modal-body">
      <div class="hist-view-row" id="histViewRow">
        <button class="hist-view-btn active" data-view="list" onclick="setHistView('list')">📋 列表</button>
        <button class="hist-view-btn" data-view="timeline" onclick="setHistView('timeline')">🕐 时间轴</button>
        <button class="hist-view-btn" data-view="trend" onclick="setHistView('trend')">📈 趋势图</button>
      </div>
      <div class="hist-search-row" id="histSearchRow">
        <input type="text" id="histSearch" placeholder="🔍 搜索问题/结果/标签/预测..." oninput="setHistSearch(this.value)">
        <div style="display:flex;gap:4px;flex-shrink:0;">
          <button class="btn-secondary small" onclick="showAccuracyDashboard()">📊 准确率</button>
          <button class="btn-secondary small" onclick="showMyPatterns()">🧠 规律</button>
        </div>
      </div>
      <div class="hist-filter" id="histFilter"></div>
      <div id="histList"></div>
      <div id="timelineList"></div>
      <div id="trendPanel"></div>
    </div>
    <div class="modal-foot">
      <button class="btn-secondary small" onclick="exportHistory()">⬇ 导出全部(JSON)</button>
      <button class="btn-secondary small" onclick="document.getElementById('histImport').click()">⬆ 导入JSON</button>
      <input type="file" id="histImport" accept=".json,application/json" style="display:none" onchange="importHistory(event)">
    </div>
  </div>
</div>

<div class="modal-mask" id="profileModal" onclick="if(event.target===this)closeProfileModal()">
  <div class="modal">
    <div class="modal-head">
      <h3>📇 人物档案</h3>
      <button class="modal-close" onclick="closeProfileModal()">✕</button>
    </div>
    <div class="modal-body" id="profileModalBody"></div>
  </div>
</div>

