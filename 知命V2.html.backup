<div class="modal-mask" id="glossaryModal" onclick="if(event.target===this)closeGlossary()">
  <div class="modal">
    <div class="modal-head">
      <h3>📖 命理词典</h3>
      <button class="modal-close" onclick="closeGlossary()">✕</button>
    </div>
    <div class="modal-body">
      <div class="gloss-tabs" id="glossTabs">
        <button class="gloss-tab active" data-cat="all" onclick="setGlossCat('all')">全部</button>
        <button class="gloss-tab" data-cat="bazi" onclick="setGlossCat('bazi')">八字</button>
        <button class="gloss-tab" data-cat="qimen" onclick="setGlossCat('qimen')">奇门</button>
        <button class="gloss-tab" data-cat="zhouyi" onclick="setGlossCat('zhouyi')">周易</button>
        <button class="gloss-tab" data-cat="tarot" onclick="setGlossCat('tarot')">塔罗</button>
        <button class="gloss-tab" data-cat="misc" onclick="setGlossCat('misc')">综合</button>
      </div>
      <div class="gloss-search">
        <input type="text" id="glossSearch" placeholder="搜索术语或定义..." oninput="searchGlossary(this.value)">
      </div>
      <div id="glossaryList"></div>
