        </div>`:""}
      </div>
      <div style="background:${IS_DARK?'#3f382c':'#EFE6D8'};border-radius:12px;padding:14px 16px;">
        ${r.question?`<div style="font-size:13px;color:${TEXT_C};margin-bottom:6px;"><b>问:</b> ${r.question}</div>`:""}
        <div style="font-size:12px;color:${TEXT_C};line-height:1.7;">${r.thisBrief||r.thisTuan||""}</div>
