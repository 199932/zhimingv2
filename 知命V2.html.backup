(function(){const _CB=calcBazi,_CQ=calcQimen,_CG=calcGongzhen,_DT=drawTarot;const bzDC=t=>/感情|财运|健康/.test(t),qmDC=t=>/决策|感情/.test(t),gzDC=t=>/建议|方向|事业|决策|感情/.test(t),tDC=(()=>{let c=0;return t=>{if(/事业|决策|感情/.test(t)){c++;return c>1}return 0}})();const W=(f,id,dc)=>function(){try{return f.apply(this,arguments)}finally{setTimeout(()=>makeLongResultCollapsible(id,{defaultCollapsed:dc}),30)}};calcBazi=W(_CB,'bz-result',bzDC);calcQimen=W(_CQ,'qm-result',qmDC);calcGongzhen=W(_CG,'gz-result',gzDC);if(typeof _DT==='function')drawTarot=function(){try{return _DT.apply(this,arguments)}finally{setTimeout(()=>{tDC.c=0;makeLongResultCollapsible('tarot-result',{defaultCollapsed:tDC})},30)}}})();

/* =========================================================
 *  X2-1 梅花易数 (Meihua Yishu)
 * =======================================================*/
const MEIHUA_BAGUA_NUM = {
  1:{name:"乾",symbol:"☰",wx:"金",line:[1,1,1]},
  2:{name:"兑",symbol:"☱",wx:"金",line:[1,1,0]},
  3:{name:"离",symbol:"☲",wx:"火",line:[1,0,1]},
  4:{name:"震",symbol:"☳",wx:"木",line:[0,0,1]},
  5:{name:"巽",symbol:"☴",wx:"木",line:[0,1,1]},
  6:{name:"坎",symbol:"☵",wx:"水",line:[0,1,0]},
  7:{name:"艮",symbol:"☶",wx:"土",line:[1,0,0]},
  8:{name:"坤",symbol:"☷",wx:"土",line:[0,0,0]}
};
const MEIHUA_ZHI_ORDER = ["子","丑","寅","卯","辰","巳","午","未","申","酉","戌","亥"];
const MEIHUA_WX_SHENG_PAIRS = [["金","水"],["水","木"],["木","火"],["火","土"],["土","金"]];
const MEIHUA_WUXING_KE_PAIRS = [["金","木"],["木","土"],["土","水"],["水","火"],["火","金"]];
function wxSheng(a,b){
  if(a==="金"&&b==="水")return true;
  if(a==="水"&&b==="木")return true;
  if(a==="木"&&b==="火")return true;
  if(a==="火"&&b==="土")return true;
  if(a==="土"&&b==="金")return true;
  return false;
}
function wxKe(a,b){
  if(a==="金"&&b==="木")return true;
  if(a==="木"&&b==="土")return true;
  if(a==="土"&&b==="水")return true;
  if(a==="水"&&b==="火")return true;
  if(a==="火"&&b==="金")return true;
  return false;
}
function tiYongRelation(ti, yong){
  if(ti===yong) return {type:"bihe", label:"体用比和", level:"大吉", emoji:"🤝", color:"#27AE60", desc:"体用五行相同，同心同德，事情稳成，左右逢源。"};
  if(wxKe(ti, yong)) return {type:"tikeyong", label:"体克用", level:"吉", emoji:"⚔️", color:"#4CAF50", desc:"体卦克制用卦，事情能成，但需要费力争取，消耗自身能量。"};
  if(wxKe(yong, ti)) return {type:"yongketi", label:"用克体", level:"凶", emoji:"⚠️", color:"#C0392B", desc:"用卦克制体卦，事情不利，有阻碍损失，宜守不宜攻。"};
  if(wxSheng(ti, yong)) return {type:"tishengyong", label:"体生用", level:"泄气", emoji:"💨", color:"#B8860B", desc:"体卦生扶用卦，付出多回报少，耗神破财，小凶。"};
  if(wxSheng(yong, ti)) return {type:"yongshengti", label:"用生体", level:"大吉", emoji:"🌟", color:"#27AE60", desc:"用卦生扶体卦，事情顺利，有贵人相助，必有收获。"};
  return {type:"unknown", label:"", level:"中", emoji:"❔", color:"#888", desc:""};
}
let _mhMode = "time";
function setMhMode(m){
  _mhMode = m;
  document.querySelectorAll(".switch-btn[data-mhmode]").forEach(b=>{
    b.classList.toggle("active", b.dataset.mhmode===m);
  });
  document.getElementById("mh-time-mode").style.display = (m==="time")?"":"none";
  document.getElementById("mh-num-mode").style.display  = (m==="num")?"":"none";
  document.getElementById("mh-zi-mode").style.display   = (m==="zi")?"":"none";
}
function onMhCityChange(){
  const sel = document.getElementById("mh-city");
  const wrap = document.getElementById("mhCustomLngWrap");
  if (sel.value === "__custom__"){ wrap.style.display = "block"; }
  else { wrap.style.display = "none"; }
}
function mhInitCity(){
  try{
    const src = document.getElementById("bz-city");
    const dst = document.getElementById("mh-city");
    if (src && dst){ dst.innerHTML = src.innerHTML; dst.value = src.value; }
  }catch(e){}
}
function hourToZhiIdx(h){
  if(h===23||h===0) return 0;
  if(h>=1&&h<=2) return 1;
  if(h>=3&&h<=4) return 2;
  if(h>=5&&h<=6) return 3;
  if(h>=7&&h<=8) return 4;
  if(h>=9&&h<=10) return 5;
  if(h>=11&&h<=12) return 6;
  if(h>=13&&h<=14) return 7;
  if(h>=15&&h<=16) return 8;
  if(h>=17&&h<=18) return 9;
  if(h>=19&&h<=20) return 10;
  return 11;
}
function mod8(n){ let r = n%8; return r===0?8:r; }
function mod6(n){ let r = n%6; return r===0?6:r; }
function numToBagua(n){ return MEIHUA_BAGUA_NUM[mod8(n)]; }
function buildGua6from3(topNum, botNum){
  const t = numToBagua(topNum), b = numToBagua(botNum);
  return {top:t, bot:b, line6:[...t.line, ...b.line], name:t.name+b.name, gua64Idx: (topNum-1)*8+(botNum-1)};
}
function huGua(gua6){
  const l = gua6.line6;
  const shangHu = [l[1],l[2],l[3]];
  const xiaHu  = [l[2],l[3],l[4]];
  function findNum(line3){
    for(let i=1;i<=8;i++){
      const b = MEIHUA_BAGUA_NUM[i];
      if(b.line[0]===line3[0]&&b.line[1]===line3[1]&&b.line[2]===line3[2]) return i;
    }
    return 1;
  }
  return buildGua6from3(findNum(shangHu), findNum(xiaHu));
}
function bianGua(gua6, dongYao1to6){
  const nl = [...gua6.line6];
  const idx = dongYao1to6 - 1;
  nl[idx] = nl[idx]===1?0:1;
  const topLine = [nl[0],nl[1],nl[2]], botLine = [nl[3],nl[4],nl[5]];
  function findNum(line3){
    for(let i=1;i<=8;i++){
      const b = MEIHUA_BAGUA_NUM[i];
      if(b.line[0]===line3[0]&&b.line[1]===line3[1]&&b.line[2]===line3[2]) return i;
    }
    return 1;
  }
  return buildGua6from3(findNum(topLine), findNum(botLine));
}
function tiYongOf(dongYao1to6, ben){
  if(dongYao1to6>=1&&dongYao1to6<=3){
    return {ti:"top", yong:"bot", tiGua:ben.top, yongGua:ben.bot};
  } else {
    return {ti:"bot", yong:"top", tiGua:ben.bot, yongGua:ben.top};
  }
}
function renderGuaYao(gua6){
  const lines = [];
  for(let i=0;i<6;i++){
    lines.push(`<div class="yao ${gua6.line6[5-i]===0?'yin':''}"></div>`);
  }
  return `<div class="yao-col">${lines.join("")}<div class="yao-label">${gua6.top.name}上/${gua6.bot.name}下</div></div>`;
}
function meihuaSimpleTip(relType, dongYaoPos, tiWx, yongWx){
  const careerMap = {
    bihe:"事业学业：稳扎稳打，团队协作能成事，适合稳步推进当前项目，忌急躁冒进。",
    tikeyong:"事业学业：通过努力可以达成目标，但过程较辛苦，需主动出击、克服阻力。",
    yongketi:"事业学业：近期阻碍较多，不宜激进投资或跳槽，宜静观其变、积蓄力量。",
    tishengyong:"事业学业：付出与回报不成正比，容易白忙活，避免做过多承诺。",
    yongshengti:"事业学业：贵人运旺，机会到来时主动把握，考试面试均有良好发挥。"
  };
  const loveMap = {
    bihe:"感情人际：双方观念契合，单身者容易遇到合适对象，有伴者关系稳定升温。",
    tikeyong:"感情人际：需要主动付出磨合，单身者可大胆追求但别急于求成。",
    yongketi:"感情人际：近期易起口舌争执，单身者不宜表白，有伴者多体谅包容。",
    tishengyong:"感情人际：一味讨好易被消耗，先爱自己再谈关系，避免单方面付出。",
    yongshengti:"感情人际：人缘极佳，单身者有被表白的机会，有伴者被关心体贴。"
  };
  function decisionTip(t, dPos){
    if(t==="yongshengti"||t==="bihe"){
      return "决策建议：大吉之象，果断行动即可，可寻求长辈或贵人意见助攻。";
    } else if(t==="tikeyong"){
      return "决策建议：可行但须多费心力，提前准备预案，不要轻敌。";
    } else if(t==="tishengyong"){
      return "决策建议：不宜大动作投入，观望为先、降低预期，三思而后行。";
    } else {
      return "决策建议：当前时机不利，建议暂缓决策、延后执行，等待下一个窗口期。";
    }
  }
  return {
    career: careerMap[relType] || "",
    love: loveMap[relType] || "",
    decision: decisionTip(relType, dongYaoPos)
  };
}
let _lastMeihuaResult = null;
function calcMeihua(){
  if (!document.getElementById("mh-city") || !document.getElementById("mh-city").innerHTML){ mhInitCity(); }
  const question = (document.getElementById("mh-question").value || "").trim();
  let inputSummary = "", modeName = "";
  let topN = 1, botN = 1, dongYao = 1;
  let lunarInfo = null;
  if (_mhMode === "time"){
    modeName = "时间起卦";
    const Y=+document.getElementById("mh-year").value, M=+document.getElementById("mh-month").value, D=+document.getElementById("mh-day").value;
    const h=+document.getElementById("mh-hour").value, min=+document.getElementById("mh-minute").value||0;
    if(!Y||!M||!D){ alert("请输入完整日期"); return; }
    let lng = 116.4;
    try{
      const cv = document.getElementById("mh-city").value;
      if(cv==="__custom__"){ lng = +document.getElementById("mh-customLng").value || 116.4; }
      else { const cSel = document.getElementById("mh-city"); const opt = cSel.options[cSel.selectedIndex]; if(opt && opt.dataset && opt.dataset.lng) lng = +opt.dataset.lng; }
    }catch(e){}
    const bjT = new Date(Y, M-1, D, h, min, 0);
    const tst = trueSolarTime(bjT, lng);
    const lunar = solar2lunar(tst.getFullYear(), tst.getMonth()+1, tst.getDate());
    const yearZhiIdx = ((lunar.year - 4) % 12 + 12) % 12;
    const nianZhiNum = yearZhiIdx + 1;
    const yueNum = lunar.month;
    const riNum = lunar.day;
    const zhiIdx = hourToZhiIdx(tst.getHours());
    const shiNum = zhiIdx + 1;
    topN = mod8(nianZhiNum + yueNum + riNum);
    botN = mod8(nianZhiNum + yueNum + riNum + shiNum);
    dongYao = mod6(nianZhiNum + yueNum + riNum + shiNum);
    lunarInfo = {lunar, nianZhi:MEIHUA_ZHI_ORDER[yearZhiIdx], shiChen:MEIHUA_ZHI_ORDER[zhiIdx], tstStr:`${tst.getFullYear()}-${tst.getMonth()+1}-${tst.getDate()} ${String(tst.getHours()).padStart(2,"0")}:${String(tst.getMinutes()).padStart(2,"0")}`};
    inputSummary = `${Y}-${M}-${D} ${String(h).padStart(2,"0")}:${String(min).padStart(2,"0")} → 农历${lunar.year}年${lunar.month}月${lunar.day}日 ${MEIHUA_ZHI_ORDER[zhiIdx]}时`;
  } else if (_mhMode === "num"){
    modeName = "数字起卦";
    const n1 = Math.abs(+document.getElementById("mh-num1").value);
    const n2 = Math.abs(+document.getElementById("mh-num2").value);
    if(!n1||!n2){ alert("请输入两个正整数"); return; }
    topN = mod8(n1); botN = mod8(n2); dongYao = mod6(n1 + n2);
    inputSummary = `报数 ${n1} / ${n2}`;
  } else {
    modeName = "字占";
    const txt = (document.getElementById("mh-zi").value || "").trim();
    if(!txt){ alert("请输入所测文字"); return; }
    const chars = Array.from(txt);
    const n = chars.length;
    let half1, half2;
    if(n % 2 === 0){ half1 = chars.slice(0, n/2); half2 = chars.slice(n/2); }
    else { half1 = chars.slice(0, (n+1)/2); half2 = chars.slice((n+1)/2); }
    const sum1 = half1.reduce((s,c)=>s + c.charCodeAt(0), 0);
    const sum2 = half2.reduce((s,c)=>s + c.charCodeAt(0), 0);
    topN = mod8(sum1); botN = mod8(sum2); dongYao = mod6(n);
    inputSummary = `「${txt.slice(0,20)}」 ${n}字`;
  }
  const benGua = buildGua6from3(topN, botN);
  const huGuaR = huGua(benGua);
  const bianGuaR = bianGua(benGua, dongYao);
  const ty = tiYongOf(dongYao, benGua);
  const rel = tiYongRelation(ty.tiGua.wx, ty.yongGua.wx);
  const huRel = tiYongRelation(ty.tiGua.wx, (ty.ti==="top"?huGuaR.bot.wx:huGuaR.top.wx));
  const bianYongGua = (ty.ti==="top"?bianGuaR.bot:bianGuaR.top);
  const bianRel = tiYongRelation(ty.tiGua.wx, bianYongGua.wx);
  const tip = meihuaSimpleTip(rel.type, dongYao, ty.tiGua.wx, ty.yongGua.wx);
  const tiMark = guaName => guaName===ty.tiGua.name?'<span class="badge" style="background:#E8F5E9;color:#2E7D32;">体</span>':(guaName===ty.yongGua.name?'<span class="badge" style="background:#FFF3E0;color:#E65100;">用</span>':'');
  const r = {modeName, inputSummary, lunarInfo, question, benGua, huGua:huGuaR, bianGua:bianGuaR, dongYao, tiYong:ty, tiWx:ty.tiGua.wx, yongWx:ty.yongGua.wx, rel, huRel, bianRel, tip};
  _lastMeihuaResult = r;
  const benTiTopMark = (ty.ti==="top")?'<span class="badge" style="background:#E8F5E9;color:#2E7D32;">体</span>':'<span class="badge" style="background:#FFF3E0;color:#E65100;">用</span>';
  const benTiBotMark = (ty.ti==="bot")?'<span class="badge" style="background:#E8F5E9;color:#2E7D32;">体</span>':'<span class="badge" style="background:#FFF3E0;color:#E65100;">用</span>';
  const huYongShang = (ty.ti==="top")?'<span class="badge" style="background:#F3E5F5;color:#6A1B9A;">上互</span>':'<span class="badge" style="background:#FFF3E0;color:#E65100;">上互·用</span>';
  const huYongXia   = (ty.ti==="bot")?'<span class="badge" style="background:#F3E5F5;color:#6A1B9A;">下互</span>':'<span class="badge" style="background:#FFF3E0;color:#E65100;">下互·用</span>';
  const bianShangMark = (ty.ti==="top")?'<span class="badge" style="background:#E8F5E9;color:#2E7D32;">体</span>':'<span class="badge" style="background:#FFEBEE;color:#B71C1C;">变·用</span>';
  const bianBotMark   = (ty.ti==="bot")?'<span class="badge" style="background:#E8F5E9;color:#2E7D32;">体</span>':'<span class="badge" style="background:#FFEBEE;color:#B71C1C;">变·用</span>';
  const guaCard = (title, g, m1, m2, arrow) => `<div style="flex:1;background:var(--card);border:1px solid var(--card-border);border-radius:14px;padding:14px;text-align:center;min-width:0;">
    <div style="font-size:12px;color:var(--text-sub);font-weight:700;margin-bottom:6px;">${title}</div>
    <div style="font-size:44px;line-height:1;color:var(--pri);margin:4px 0;">${g.top.symbol}${g.bot.symbol}</div>
    <div style="font-size:16px;font-weight:800;color:var(--text);margin:4px 0 6px;">${g.top.name}${g.bot.name}</div>
    <div style="display:flex;justify-content:center;gap:14px;margin:6px 0;">
      <div style="font-size:12px;">上·${g.top.name}<span class="tag tag-info">${g.top.wx}</span>${m1}</div>
      <div style="font-size:12px;">下·${g.bot.name}<span class="tag tag-info">${g.bot.wx}</span>${m2}</div>
    </div>
    ${arrow?`<div style="margin-top:6px;font-size:20px;color:var(--text-hint);">${arrow}</div>`:""}
  </div>`;
  const html = `
    <div class="card"><div class="card-title">起卦方式 · ${modeName}</div>
      <div class="qm-meta">
        ${question?`<span class="meta-badge">💬 ${question.slice(0,40)}</span>`:""}
        <span class="meta-badge">📝 ${inputSummary}</span>
        ${lunarInfo?`<span class="meta-badge">🌙 真太阳·${lunarInfo.tstStr}</span>`:""}
        ${lunarInfo?`<span class="meta-badge">🎋 年支${lunarInfo.nianZhi} · ${lunarInfo.shiChen}时</span>`:""}
        <span class="meta-badge" style="background:#FFF3E0;color:#E65100;">⚡ 第 ${dongYao} 爻动</span>
      </div>
    </div>
    <div class="card">
      <div class="card-title">三卦推演 · 本 → 互 → 变</div>
      <div style="display:flex;gap:10px;align-items:stretch;overflow-x:auto;padding:6px 0;">
        ${guaCard("本卦·当下现状", benGua, benTiTopMark, benTiBotMark, "➡")}
        ${guaCard("互卦·发展过程", huGuaR, huYongShang, huYongXia, "➡")}
        ${guaCard("变卦·最终结果", bianGuaR, bianShangMark, bianBotMark, "")}
      </div>
    </div>
    <div class="card" style="background:linear-gradient(135deg,var(--pri-light) 0%,var(--card) 100%);border:2px solid var(--pri);">
      <div class="card-title">🎯 核心结论 · 体用生克</div>
      <div style="text-align:center;padding:10px 0;">
        <div style="display:flex;justify-content:center;align-items:center;gap:16px;flex-wrap:wrap;">
          <div style="text-align:center;"><div style="font-size:28px;">${ty.tiGua.symbol}</div><div style="font-size:16px;font-weight:800;">体卦·${ty.tiGua.name}</div><span class="tag tag-info">${ty.tiGua.wx}</span></div>
          <div style="font-size:32px;">${rel.emoji}</div>
          <div style="text-align:center;"><div style="font-size:28px;">${ty.yongGua.symbol}</div><div style="font-size:16px;font-weight:800;">用卦·${ty.yongGua.name}</div><span class="tag tag-info">${ty.yongGua.wx}</span></div>
        </div>
        <div style="margin-top:14px;">
          <span class="tag" style="background:${rel.color};color:#fff;font-size:16px;padding:6px 16px;border-radius:14px;font-weight:700;">${rel.emoji} ${rel.label} · ${rel.level}</span>
        </div>
        <div class="desc-text" style="margin-top:10px;font-size:14px;">${rel.desc}</div>
      </div>
    </div>
    <div class="card"><div class="card-title">📈 过程与结果</div>
      <div class="sub-block">
        <div class="sb-k">互卦简析（发展过程）：体${ty.tiGua.wx} × 互用${ty.ti==="top"?huGuaR.bot.wx:huGuaR.top.wx} → ${huRel.label} ${huRel.emoji}</div>
        <div class="sb-p">${huRel.desc}</div>
      </div>
      <div class="sub-block">
        <div class="sb-k">变卦简析（最终走向）：体${ty.tiGua.wx} × 变用${bianYongGua.wx} → ${bianRel.label} ${bianRel.emoji}</div>
        <div class="sb-p">${bianRel.desc}</div>
      </div>
    </div>
    <div class="card"><div class="card-title">📌 三方向简评</div>
      <div class="sub-block"><div class="sb-k">💼 ${tip.career.split("：")[0]||"事业学业"}</div><div class="sb-p">${tip.career.split("：")[1]||tip.career}</div></div>
      <div class="sub-block"><div class="sb-k">💕 ${tip.love.split("：")[0]||"感情人际"}</div><div class="sb-p">${tip.love.split("：")[1]||tip.love}</div></div>
      <div class="sub-block"><div class="sb-k">🎯 ${tip.decision.split("：")[0]||"决策建议"}</div><div class="sb-p">${tip.decision.split("：")[1]||tip.decision}</div></div>
    </div>
  `;
  document.getElementById("mh-result").innerHTML = enhanceResultHtml(html);
  document.getElementById("copyBar").style.display = "flex";
  const histInput = {mode:_mhMode, question};
  if(_mhMode==="time"){ const Y=+document.getElementById("mh-year").value,M=+document.getElementById("mh-month").value,D=+document.getElementById("mh-day").value,h=+document.getElementById("mh-hour").value,min=+document.getElementById("mh-minute").value||0; histInput.year=Y;histInput.month=M;histInput.day=D;histInput.hour=h;histInput.minute=min; }
  else if(_mhMode==="num"){ histInput.num1=+document.getElementById("mh-num1").value;histInput.num2=+document.getElementById("mh-num2").value; }
  else { histInput.zi = document.getElementById("mh-zi").value; }
  addHistory("meihua", histInput, r, `${r.benGua.name}→${r.bianGua.name}`);
  try{showToast('✅ 起卦完成','success',1200);}catch(_){}
}
function buildMeihuaCopyText(r){
  if(!r) return "";
  const p = [`【知命V2 梅花易数结果】`];
  p.push(`起卦方式：${r.modeName}`);
  p.push(`输入摘要：${r.inputSummary}`);
  if(r.question) p.push(`所问之事：${r.question}`);
  p.push(`本卦：${r.benGua.name} (上${r.benGua.top.name}${r.benGua.top.wx} 下${r.benGua.bot.name}${r.benGua.bot.wx})`);
  p.push(`互卦：${r.huGua.name} (上${r.huGua.top.name}${r.huGua.top.wx} 下${r.huGua.bot.name}${r.huGua.bot.wx})`);
  p.push(`变卦：${r.bianGua.name} (上${r.bianGua.top.name}${r.bianGua.top.wx} 下${r.bianGua.bot.name}${r.bianGua.bot.wx})`);
  p.push(`动爻：第${r.dongYao}爻动　体卦：${r.tiYong.tiGua.name}${r.tiWx}　用卦：${r.tiYong.yongGua.name}${r.yongWx}`);
  p.push(`核心：${r.rel.label}(${r.rel.level}) ${r.rel.emoji}　${r.rel.desc}`);
  p.push(`事业：${r.tip.career}`);
  p.push(`感情：${r.tip.love}`);
  p.push(`决策：${r.tip.decision}`);
  return p.join("\n");
}

