        <div style="flex:1;height:12px;background:${IS_DARK?'#2a2620':'#f3ede3'};border-radius:6px;overflow:hidden;"><div style="height:100%;width:${v}%;background:${colors[i]};border-radius:6px;"></div></div>
        <span style="width:36px;text-align:right;font-size:13px;font-weight:700;color:${TEXT_C};">${v}</span></div>`;
    }).join("");
    bodyHTML = `
      <div style="background:linear-gradient(135deg,${IS_DARK?'#352f50':'#E8E4F2'} 0%,${CARD_BG} 100%);border-radius:16px;padding:24px;text-align:center;margin:0 0 16px;">
        <div style="font-size:72px;line-height:1;">${z.sym||""}</div>
        <div style="font-size:24px;font-weight:800;margin-top:8px;color:${BRAND_DARK};">${z.name||""}座 <span style="font-size:16px;padding:2px 10px;border-radius:10px;background:${BRAND};color:#fff;margin-left:6px;">${r.periodName||""} ${(r.scores||[])[0]||0}</span></div>
