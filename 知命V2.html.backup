        <g transform="translate(12,116)"><rect x="0" y="0" width="16" height="12" fill="#FFE4B5" stroke="#8B4513" stroke-width="0.5"/>
          <text x="8" y="10" font-size="6" text-anchor="middle" fill="#8B4513">牛</text></g>
        <g transform="translate(68,116)"><rect x="0" y="0" width="16" height="12" fill="#FFE4B5" stroke="#8B4513" stroke-width="0.5"/>
          <text x="8" y="10" font-size="6" text-anchor="middle" fill="#8B4513">狮</text></g>
        <!-- 大轮 -->
        <circle cx="48" cy="74" r="38" fill="#FFD700" stroke="#8B4513" stroke-width="2"/>
        <circle cx="48" cy="74" r="30" fill="none" stroke="#B8860B" stroke-width="1" stroke-dasharray="2,2"/>
        <text x="48" y="50" font-size="8" text-anchor="middle" font-weight="700" fill="#8B4513">TARO</text>
        <!-- 动物 -->
        <g transform="translate(48,38)"><path d="M-4,0 L4,0 2,-6 -2,-6 Z" fill="#8B4513"/></g> <!-- 上行 -->
        <g transform="translate(74,74)"><path d="M0,-6 L-8,4 L8,4 Z" fill="#A0522D"/></g> <!-- 阿努比斯 -->
        <g transform="translate(24,104)"><ellipse cx="0" cy="0" rx="6" ry="4" fill="#556B2F"/></g> <!-- 蛇 -->
        <!-- ROTA字母 -->
        <text x="48" y="108" font-size="10" text-anchor="middle" font-weight="700" fill="#4A4A4A">R</text>
        <text x="16" y="78" font-size="10" text-anchor="middle" font-weight="700" fill="#4A4A4A">O</text>
        <text x="80" y="78" font-size="10" text-anchor="middle" font-weight="700" fill="#4A4A4A">T</text>
        <text x="48" y="50" font-size="10" text-anchor="middle" font-weight="700" fill="#4A4A4A" transform="translate(12,24)">A</text>
      </g>`;
    case 11: // 正义：天平+剑+宝座
      return `<g>
        <!-- 宝座 -->
        <rect x="18" y="20" width="60" height="128" fill="#DCDCDC" stroke="#808080" stroke-width="1"/>
        <g transform="translate(48,46)">
          <circle cx="0" cy="0" r="9" fill="#FFE4B5"/>
