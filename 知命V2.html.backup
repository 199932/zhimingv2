  </div>
</div>

<!-- ===== 占卜日记 Modal ===== -->
<div class="modal-mask" id="diaryModal" onclick="if(event.target===this)closeDiaryModal()" style="z-index:210;">
  <div class="modal" style="max-width:680px;">
    <div class="modal-head">
      <button class="diary-nav-btn" onclick="switchDiaryMonth(-1)">←</button>
      <button class="diary-nav-btn" onclick="switchDiaryMonth(0)" id="diaryCurMonth" style="min-width:140px;font-weight:700;"></button>
      <button class="diary-nav-btn" onclick="switchDiaryMonth(1)">→</button>
      <button class="btn-secondary small" onclick="switchDiaryMonth('today')" style="margin:0 4px;">今日</button>
      <button class="btn-secondary small" onclick="renderDiaryMonthlyStats(_diaryYear,_diaryMonth)" style="margin-right:8px;">📊 统计</button>
      <h3 style="flex:0 0 auto;"></h3>
      <button class="modal-close" onclick="closeDiaryModal()">✕</button>
    </div>
    <div class="modal-body" id="diaryModalBody" style="padding:10px 12px;">
      <div id="diaryCalendar"></div>
      <div id="diaryDayDetail"></div>
      <div id="diaryStats"></div>
    </div>
  </div>
</div>

