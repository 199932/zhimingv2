        <div style="background:${IS_DARK?'#3f382c':'#EFE6D8'};border-radius:10px;padding:12px;"><div style="font-size:11px;color:${SUB};">神煞</div><div style="font-size:16px;font-weight:700;color:${BRAND_DARK};margin-top:4px;">${r.shou||""}</div></div>
        <div style="background:${IS_DARK?'#3f382c':'#EFE6D8'};border-radius:10px;padding:12px;"><div style="font-size:11px;color:${SUB};">落宫</div><div style="font-size:16px;font-weight:700;color:${BRAND_DARK};margin-top:4px;">第${(r.gongIdx||0)+1}宫</div></div>
