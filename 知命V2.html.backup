    case 15: // 恶魔：山羊角+锁链男女+倒五芒星
      return `<g>
        <polygon points="48,8 16,144 80,144" fill="#3C0000" opacity="0.6"/>
        <!-- 恶魔 -->
        <g transform="translate(48,46)">
          <circle cx="0" cy="0" r="14" fill="#4B0082"/>
