/* =========================================================
 *  批次C 优化⑤ 今日首页 8 个小组件渲染函数
 * =======================================================*/
const TRADITIONAL_FESTIVALS = [
  {name:"春节",m:1,d:1,lunar:true},
  {name:"元宵节",m:1,d:15,lunar:true},
  {name:"清明节",jq:"清明",offset:0},
  {name:"端午节",m:5,d:5,lunar:true},
  {name:"七夕节",m:7,d:7,lunar:true},
  {name:"中秋节",m:8,d:15,lunar:true},
  {name:"重阳节",m:9,d:9,lunar:true},
  {name:"冬至",jq:"冬至",offset:0},
];
function _findNextFestival(today){
  const Y = today.getFullYear();
  let best = null, bd = Infinity;
  TRADITIONAL_FESTIVALS.forEach(f=>{
    for (let yy = Y; yy <= Y+1; yy++){
      let dt;
      if (f.lunar){
        try {
          const sl = lunar2solar(yy, f.m, f.d, false);
          if (sl) dt = new Date(sl.year, sl.month-1, sl.day);
        }catch(e){ dt = null; }
      } else if (f.jq){
        const jqIdx = JQ_NAMES.indexOf(f.jq);
        if (jqIdx >= 0) dt = getJieqi(yy, jqIdx);
      }
      if (!dt) return;
      const diff = Math.ceil((dt - today)/86400000);
      if (diff >= 0 && diff < bd){ bd = diff; best = {name:f.name, days:diff, date:dt}; }
    }
  });
  return best || {name:"春节", days:365, date:new Date(Y+1,0,1)};
}
function _collectMonthYijiFreq(today){
  const yiFreq = {}, jiFreq = {};
  const base = new Date(today.getFullYear(), today.getMonth(), 1);
  const baseTime = base.getTime();
  for (let i = -3; i <= 10; i++){
    const d = new Date(baseTime + i*86400000);
    try {
      const a = buildAlmanac(d);
      (a.yi||[]).forEach(y=>{ yiFreq[y] = (yiFreq[y]||0)+1; });
      (a.ji||[]).forEach(j=>{ jiFreq[j] = (jiFreq[j]||0)+1; });
    }catch(e){}
  }
  const topYi = Object.entries(yiFreq).sort((a,b)=>b[1]-a[1]).slice(0,5);
  const topJi = Object.entries(jiFreq).sort((a,b)=>b[1]-a[1]).slice(0,5);
  return {topYi, topJi};
}
function _radarSVG(labels, valuesY, valuesJ, colors){
  const N = labels.length;
  const cx=60, cy=60, R=42;
  let pts="", axes="";
  for (let i=0;i<N;i++){
    const a = (Math.PI*2*i/N) - Math.PI/2;
    const x = cx + R*Math.cos(a), y = cy + R*Math.sin(a);
    axes += `<line x1="${cx}" y1="${cy}" x2="${x}" y2="${y}" stroke="#ddd" stroke-width="0.5"/>`;
    const lx = cx + (R+8)*Math.cos(a), ly = cy + (R+8)*Math.sin(a);
    axes += `<text x="${lx}" y="${ly}" text-anchor="middle" dominant-baseline="middle" font-size="7" fill="#888">${labels[i]}</text>`;
  }
  let ring5="";
  for (let r=1;r<=5;r++){
    const rr = R*r/5;
    let rp = "";
    for (let i=0;i<N;i++){
      const a = (Math.PI*2*i/N) - Math.PI/2;
      const x = cx + rr*Math.cos(a), y = cy + rr*Math.sin(a);
      rp += (i===0?"M":"L")+x.toFixed(1)+","+y.toFixed(1);
    }
    ring5 += `<path d="${rp}Z" fill="none" stroke="#eee" stroke-width="0.4"/>`;
  }
  let pathY="", pathJ="";
  const maxY = Math.max(1, ...valuesY.map(v=>v.v));
  const maxJ = Math.max(1, ...valuesJ.map(v=>v.v));
  for (let i=0;i<N;i++){
    const a = (Math.PI*2*i/N) - Math.PI/2;
    const rY = R * (valuesY[i].v / maxY) * 0.9;
    const rJ = R * (valuesJ[i].v / maxJ) * 0.9;
    const xY = cx + rY*Math.cos(a), yY = cy + rY*Math.sin(a);
    const xJ = cx + rJ*Math.cos(a), yJ = cy + rJ*Math.sin(a);
    pathY += (i===0?"M":"L")+xY.toFixed(1)+","+yY.toFixed(1);
    pathJ += (i===0?"M":"L")+xJ.toFixed(1)+","+yJ.toFixed(1);
  }
  return `<svg viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg">${ring5}${axes}
    <path d="${pathY}Z" fill="${colors.yiFill}" stroke="${colors.yiStroke}" stroke-width="1" opacity="0.7"/>
    <path d="${pathJ}Z" fill="${colors.jiFill}" stroke="${colors.jiStroke}" stroke-width="1" opacity="0.5"/>
  </svg>`;
}
function renderWidget_5score(r){
  const names = ["综合","爱情","事业","财运","健康"];
  const colors = ["#8B6F47","#E06080","#6B5CA5","#D4A040","#50c878"];
  const rows = names.map((n,i)=>{
    const val = r.scores[i] || 0;
    return `<div class="w-score-row"><span class="sn">${n}</span><div class="st"><div class="sf" style="width:${val}%;background:${colors[i]}"></div></div><span class="sc">${val}</span></div>`;
  }).join("");
  return `<div class="widget">
    <div class="widget-title">📊 ${r.z.name}座5项</div>
    <div class="widget-body">${rows}</div>
  </div>`;
}
function renderWidget_dailyTarot(r){
  const t = TAROT_DATA[r.td.cardId];
  const ur = r.td.reversed ? "逆位" : "正位";
  const cls = r.td.reversed ? "reversed" : "upright";
  return `<div class="widget">
    <div class="widget-title">🎴 每日塔罗</div>
    <div class="widget-body"><div class="w-tarot">
      <div class="w-tarot-svg">${renderTarotFaceSVG(r.td.cardId, 60, 100, r.td.reversed)}</div>
      <div class="w-tarot-info">
        <div class="w-tarot-name">${t.name}</div>
        <span class="w-tarot-ur ${cls}">${ur}</span>
        <div style="font-size:10px;color:var(--text-hint);margin-top:4px;line-height:1.3;">${(t.keywords_u||t.keywords_r||[]).slice(0,2).join("·")}</div>
      </div>
    </div></div>
  </div>`;
}
function renderWidget_godsDir(r){
  const rows = [
    {icon:"😇", k:"喜神", v:r.a.xiShen},
    {icon:"💰", k:"财神", v:r.a.caiShen},
    {icon:"🍀", k:"福神", v:r.a.fuShen},
  ].map(it=>`<div class="w-god-row"><span class="wg-icon">${it.icon}</span><span class="wg-k">${it.k}</span><span class="wg-v">${it.v}</span></div>`).join("");
  return `<div class="widget">
    <div class="widget-title">💰 喜财福方位</div>
    <div class="widget-body"><div class="w-gods">${rows}</div></div>
  </div>`;
}
function renderWidget_wuxingToday(r){
  const WX_NAMES = ["木","火","土","金","水"];
  const WX_COLORS = ["#4CAF50","#F44336","#FFC107","#C0C0C0","#2196F3"];
  const GAN_WX = {甲:"木",乙:"木",丙:"火",丁:"火",戊:"土",己:"土",庚:"金",辛:"金",壬:"水",癸:"水"};
  const ZHI_WX = {子:"水",丑:"土",寅:"木",卯:"木",辰:"土",巳:"火",午:"火",未:"土",申:"金",酉:"金",戌:"土",亥:"水"};
  const SEASON_WX = (()=>{
    const m = r.today.getMonth()+1;
    if (m>=2 && m<=4) return {旺:"木",相:"火",休:"水",囚:"金",死:"土"};
    if (m>=5 && m<=7) return {旺:"火",相:"土",休:"木",囚:"水",死:"金"};
    if (m>=8 && m<=10) return {旺:"金",相:"水",休:"土",囚:"火",死:"木"};
    return {旺:"水",相:"木",休:"金",囚:"土",死:"火"};
  })();
  const score = {};
  WX_NAMES.forEach(w=>score[w]=40);
  const dayGanWX = GAN_WX[r.a.dayGan] || "土";
  const dayZhiWX = ZHI_WX[r.a.dayZhi] || "土";
  score[dayGanWX] = (score[dayGanWX]||0) + 20;
  score[dayZhiWX] = (score[dayZhiWX]||0) + 15;
  score[SEASON_WX.旺] = (score[SEASON_WX.旺]||0) + 25;
  score[SEASON_WX.相] = (score[SEASON_WX.相]||0) + 10;
  const maxS = Math.max(...Object.values(score));
  const rows = WX_NAMES.map((w,i)=>{
    const pct = Math.round((score[w]||0)*100/maxS);
    return `<div class="w-wx-row"><span class="wn" style="color:${WX_COLORS[i]}">${w}</span><div class="wt"><div class="wf" style="width:${pct}%;background:${WX_COLORS[i]}"></div></div></div>`;
  }).join("");
  return `<div class="widget">
    <div class="widget-title">🌿 今日五行</div>
    <div class="widget-body"><div class="w-wx">${rows}</div></div>
  </div>`;
}
function renderWidget_jqCountdown(r){
  const n = r.a.nearest;
  if (!n) return "";
  const pct = Math.min(100, Math.round((15-n.days)/15*100)) || 3;
  const dateStr = n.date ? `${n.date.getMonth()+1}/${n.date.getDate()}` : "";
  return `<div class="widget">
    <div class="widget-title">📍 节气倒计时</div>
    <div class="widget-body"><div class="w-jq">
      <div class="w-jq-top"><span class="w-jq-name">${n.name||"节气"}</span><span class="w-jq-days">${n.days}<small>天</small></span></div>
      <div class="w-jq-track"><div class="w-jq-fill" style="width:${pct}%"></div></div>
      <div class="w-jq-tip">${dateStr} · ${n.isToday?"就是今天":`还有${n.days}天`}</div>
    </div></div>
  </div>`;
}
function renderWidget_festivalCountdown(r){
  const f = _findNextFestival(r.today);
  return `<div class="widget">
    <div class="widget-title">⏳ 下一节日</div>
    <div class="widget-body"><div class="w-fest">
      <div class="w-fest-top"><span class="w-fest-name">🎊 ${f.name}</span><span class="w-fest-days">${f.days}<small>天</small></span></div>
      <div class="w-fest-tip">${f.date?`${f.date.getMonth()+1}月${f.date.getDate()}日`:""} · 距离现在还有${f.days}天</div>
    </div></div>
  </div>`;
}
function renderWidget_yijiRadar(r){
  const freq = _collectMonthYijiFreq(r.today);
  const labels = freq.topYi.map(e=>e[0]);
  const valuesY = freq.topYi.map(e=>({n:e[0], v:e[1]}));
  const valuesJ = freq.topJi.map(e=>({n:e[0], v:e[1]}));
  const fillLabels = labels.length >= 5 ? labels : (labels.concat(["宜","忌","平","顺","慎"].slice(0,5-labels.length)));
  const fillVY = valuesY.concat(Array(Math.max(0,5-valuesY.length)).fill({n:"",v:0})).slice(0,5);
  const fillVJ = valuesJ.concat(Array(Math.max(0,5-valuesJ.length)).fill({n:"",v:0})).slice(0,5);
  const svg = _radarSVG(fillLabels, fillVY, fillVJ, {yiFill:"rgba(39,174,96,0.25)", yiStroke:"#27AE60", jiFill:"rgba(192,57,43,0.2)", jiStroke:"#C0392B"});
  return `<div class="widget">
    <div class="widget-title">📈 本月宜忌雷达</div>
    <div class="widget-body"><div class="w-radar">${svg}</div></div>
  </div>`;
}
function renderWidget_peopleShortcut(r){
  const p = (typeof getActiveProfile === "function") ? getActiveProfile() : null;
  const allP = (typeof loadProfiles === "function") ? loadProfiles() : [];
  const curIdx = p ? allP.findIndex(x=>x.id===p.id) : -1;
  const emoji = p && p.emoji ? p.emoji : "👤";
  const name = p && p.name ? p.name : "暂无档案";
  const meta = p ? (p.month && p.day ? `${p.month}/${p.day} · ${ZODIAC_12[r.zodiacIdx]?.name||""}座` : "未设生日") : "打开档案创建";
  const leftOnclick = (allP.length>1) ? `onclick="cyclePeopleShortcut(-1)"` : "disabled style=\"opacity:.3;cursor:not-allowed;\"";
  const rightOnclick = (allP.length>1) ? `onclick="cyclePeopleShortcut(1)"` : "disabled style=\"opacity:.3;cursor:not-allowed;\"";
  return `<div class="widget">
    <div class="widget-title">⭐ 人物快捷</div>
    <div class="widget-body"><div class="w-people">
      <div class="w-p-emoji">${emoji}</div>
      <div class="w-p-info">
        <div class="w-p-name">${name}</div>
        <div class="w-p-meta">${meta}</div>
      </div>
      <div class="w-p-actions">
        <button class="w-p-btn" ${leftOnclick} title="上一位">‹</button>
        <button class="w-p-btn" ${rightOnclick} title="下一位">›</button>
      </div>
    </div></div>
  </div>`;
}
function cyclePeopleShortcut(dir){
  try {
    const allP = loadProfiles();
    if (allP.length <= 1) return;
    const cur = getActiveProfile();
    let idx = cur ? allP.findIndex(x=>x.id===cur.id) : -1;
    idx = (idx + dir + allP.length) % allP.length;
    setActiveProfile(allP[idx].id);
    renderToday();
  }catch(e){}
}

/* =========================================================
 *  批次C 优化③ 结果分享卡片导出PNG
 * =======================================================*/
function onShareCardClick(){
  let type = null, data = null;
  const sec = document.querySelector(".section.active");
  const secId = sec ? sec.id : "";
  const pageId = (document.querySelector(".page.active")||{}).id || "";
  if (pageId === "page-today"){
    const today = new Date();
    const a = buildAlmanac(today);
    const zodiacIdx = +(localStorage.getItem("zhiming_zodiac_idx")||0);
    data = {
      date: today, almanac: a, zodiacIdx,
      zodiac: ZODIAC_12[zodiacIdx] || ZODIAC_12[0],
      tarot: getDailyTarot(today),
      scores: zodiacSubScores(zodiacIdx, 0, today),
      lunarStr: (()=>{ const w=["日","一","二","三","四","五","六"][today.getDay()]; return `${a.yearGZ}年【${a.zodiac}年】 ${lunarMonthStr(a.lunar.month,a.lunar.isLeap)}${lunarDayStr(a.lunar.day)} · 周${w}`; })()
    };
    type = "almanac";
  } else if (secId === "sec-cn1" && _lastBaziResult){
    type = "bazi"; data = _lastBaziResult;
  } else if (secId === "sec-cn4" && _lastQimenResult){
    type = "qimen"; data = _lastQimenResult;
  } else if (secId === "sec-wu1" && _lastTarotResult){
    type = "tarot"; data = _lastTarotResult;
  } else if (secId === "sec-cn1c" && _lastGongzhenResult){
    type = "gongzhen"; data = _lastGongzhenResult;
  } else if (secId === "sec-cn5" && _lastXiaoliurenResult){
    type = "xiaoliuren"; data = _lastXiaoliurenResult;
  } else if (secId === "sec-cn3" && _lastZhouyiResult){
    type = "zhouyi"; data = _lastZhouyiResult;
  } else if (secId === "sec-wu2" && _lastZodiacResult){
    type = "zodiac"; data = _lastZodiacResult;
  } else if (secId === "sec-cn2" && _lastWugeResult){
    type = "wuge"; data = _lastWugeResult;
  } else if (secId === "sec-cn6" && _lastCeziResult){
    type = "cezi"; data = _lastCeziResult;
  } else if (secId === "sec-al1"){
    const today = new Date();
    const a = buildAlmanac(today);
    data = {date:today, almanac:a, lunarStr:`${a.yearGZ}年【${a.zodiac}年】`};
    type = "almanac";
  }
  if (!type || !data){
    alert("暂无结果可分享，先进行占卜吧～");
    return;
  }
  try {
    generateShareCardImage(type, data);
    const btn = document.getElementById("shareBtn");
    if (btn){
      const ot = btn.textContent;
      btn.textContent = "✅ 已生成";
      btn.classList.add("ok");
      setTimeout(()=>{btn.textContent=ot;btn.classList.remove("ok");},1500);
    }
  }catch(e){
    _warn("分享卡生成失败:", e);
    alert("分享卡生成失败: " + (e.message||e));
  }
}
function buildShareCardHTML(type, r){
  const W = 720, IS_DARK = document.body.classList.contains("theme-dark");
  const BRAND = "#8B6F47", BRAND_DARK = "#6A5437", TEXT_C = "#2b2b2b", SUB = "#666", BG = IS_DARK ? "#2a2620" : "#FAF8F5", CARD_BG = IS_DARK ? "#3A3530" : "#ffffff";
  const CARD = `style="font-family:-apple-system,BlinkMacSystemFont,'PingFang SC','Helvetica Neue','Microsoft YaHei',sans-serif;background:${BG};width:${W}px;padding:0;margin:0;color:${TEXT_C};"`;
  const now = new Date();
  const dateLabel = `${now.getFullYear()}.${String(now.getMonth()+1).padStart(2,"0")}.${String(now.getDate()).padStart(2,"0")}`;
  let title="", bodyHTML="", cardH = 1100;
  if (type === "bazi"){
    title = "☯ 八字排盘";
    const p = (r.pillars||[]);
    const cols = p.map(x=>`<div style="flex:1;background:${IS_DARK?'#3f382c':'#EFE6D8'};border-radius:12px;padding:18px 6px;text-align:center;margin:0 4px;">
      <div style="font-size:12px;color:${BRAND_DARK};opacity:.7;margin-bottom:6px;">${x.col}</div>
      <div style="font-size:32px;font-weight:800;color:${BRAND_DARK};line-height:1.2;">${x.gz.charAt(0)}</div>
      <div style="font-size:28px;font-weight:800;color:${BRAND};margin-top:6px;line-height:1.2;">${x.gz.charAt(1)}</div>
      <div style="font-size:11px;color:${SUB};margin-top:10px;">${x.nayin||""}</div>
      <div style="font-size:11px;color:${BRAND_DARK};margin-top:4px;">${x.wx||""}</div>
    </div>`).join("");
    const wxScores = Object.entries(r.wxScore||{});
    const maxWx = Math.max(1, ...wxScores.map(x=>+x[1]||0));
    const wxColors = {木:"#4CAF50",火:"#F44336",土:"#FFC107",金:"#9E9E9E",水:"#2196F3"};
    const wxBars = wxScores.map(([k,v])=>{
      const pct = Math.round((+v||0)*100/maxWx);
      return `<div style="display:flex;align-items:center;gap:8px;margin:6px 0;"><span style="width:30px;font-size:14px;font-weight:700;color:${wxColors[k]||BRAND};">${k}</span>
        <div style="flex:1;height:14px;background:${IS_DARK?'#2a2620':'#f3ede3'};border-radius:7px;overflow:hidden;"><div style="height:100%;width:${pct}%;background:${wxColors[k]||BRAND};border-radius:7px;"></div></div>
        <span style="width:36px;text-align:right;font-size:12px;color:${SUB};">${v}</span></div>`;
    }).join("");
    bodyHTML = `
      <div style="margin:0 0 16px;">
        <div style="font-size:13px;color:${SUB};margin-bottom:6px;">四柱八字</div>
        <div style="display:flex;">${cols}</div>
      </div>
      <div style="background:${IS_DARK?'#3f382c':'#EFE6D8'};border-radius:12px;padding:14px 16px;margin:0 0 16px;">
        <div style="font-size:13px;color:${BRAND_DARK};margin-bottom:4px;font-weight:700;">日干 ${r.dayGan||""}</div>
        <div style="font-size:12px;color:${TEXT_C};line-height:1.7;">生肖: ${r.zodiac||""} · 月令: ${r.yueLing||""} · 旺衰: <b>${r.wangshuai||""}</b><br>缺属: ${(r.lack||[]).join(",")||"无"} · 喜用神: ${(r.xiYong||[]).join(",")||""}</div>
      </div>
      <div>
        <div style="font-size:13px;color:${SUB};margin-bottom:6px;">五行强弱</div>
        ${wxBars}
      </div>`;
    cardH = 980;
  } else if (type === "qimen"){
    title = "✦ 奇门遁甲";
    const gongOrder = [4,9,2,3,5,7,8,1,6];
    const cellSize = 200;
    let grid = "";
    gongOrder.forEach(g=>{
      const tp = (r.tianpan||{})[g] || {};
      const men = (r.bamen||{})[g] || "-";
      const shen = (r.bashen||{})[g] || "-";
      const xing = (QM_9XING_GONG||{})[g] || "-";
      const border = `border:1px solid ${IS_DARK?'#4a443c':'#ece3d6'}`;
      grid += `<div style="${border};padding:6px;text-align:center;background:${CARD_BG};font-size:11px;">
        <div style="color:${SUB};font-size:10px;">宫${g} · ${shen}</div>
        <div style="font-weight:700;color:${BRAND_DARK};margin:2px 0;font-size:13px;">${xing}</div>
        <div style="color:${BRAND};margin:2px 0;font-size:14px;font-weight:700;">${men}门</div>
        <div style="font-size:12px;"><b style="color:#C0392B;">${tp.tianGan||"-"}</b> / <span style="color:#6B5CA5;">${tp.diGan||"-"}</span></div>
      </div>`;
    });
    bodyHTML = `
      <div style="background:${IS_DARK?'#3f382c':'#EFE6D8'};border-radius:12px;padding:14px 16px;margin:0 0 16px;">
        <div style="font-size:12px;color:${TEXT_C};line-height:1.8;">
          <b>流派:</b> 时家奇门 · 拆补法 · ${r.dun==="YANG"?"阳遁":"阴遁"}${r.juNum}局<br>
          <b>节气:</b> ${r.jieqi||""} · <b>三元:</b> ${r.sanyuan||""}<br>
          <b>四柱:</b> ${(r.pillars||{}).y||""} ${(r.pillars||{}).m||""} ${(r.pillars||{}).d||""} ${(r.pillars||{}).h||""}<br>
          <b>值符:</b> ${r.zhiFuXing||""}(${r.zhiFuGong||""}宫) · <b>值使:</b> ${r.zhiShiMen||""}门(${r.zhiShiGong||""}宫)
        </div>
      </div>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:4px;margin:0 0 16px;">${grid}</div>
      <div style="font-size:12px;line-height:1.7;">
        ${(r.goodGe||[]).length?`<div style="margin:4px 0;"><b style="color:#27AE60;">吉格:</b> ${r.goodGe.join("、")}</div>`:""}
        ${(r.badGe||[]).length?`<div style="margin:4px 0;"><b style="color:#C0392B;">凶格:</b> ${r.badGe.join("、")}</div>`:""}
      </div>`;
    cardH = 1300;
  } else if (type === "tarot"){
    title = "✦ 韦特塔罗";
    const cards = r.cards || [];
    const positions = r.positions || cards.map((_,i)=>`第${i+1}张`);
    const cardItems = cards.slice(0,6).map((c,i)=>{
      const pos = positions[i] || "";
      const t = TAROT_DATA[c.cardId] || {name:""};
      const reversed = !!c.reversed;
      const kw = reversed ? (t.keywords_r||[]) : (t.keywords_u||[]);
      const faceSVG = (typeof renderTarotFaceSVG === "function") ? renderTarotFaceSVG(c.cardId, 120, 200, reversed) : "";
      return `<div style="width:${6>cards.length?180:140}px;margin:8px;text-align:center;display:inline-block;vertical-align:top;">
        <div style="width:120px;height:200px;margin:0 auto;border-radius:8px;overflow:hidden;box-shadow:0 4px 14px rgba(0,0,0,.15);">${faceSVG}</div>
        <div style="margin-top:10px;font-size:12px;color:${SUB};font-weight:500;">${pos}</div>
        <div style="margin-top:2px;font-size:14px;font-weight:700;color:${TEXT_C};">${t.name}</div>
        <div style="margin-top:2px;font-size:11px;"><span style="padding:1px 8px;border-radius:6px;background:${reversed?'#FCEAEA':'#EAF7EC'};color:${reversed?'#C0392B':'#27AE60'};font-weight:600;">${reversed?'逆位':'正位'}</span></div>
        <div style="margin-top:6px;font-size:11px;color:${SUB};line-height:1.4;">${kw.slice(0,3).join(" · ")}</div>
      </div>`;
    }).join("");
    bodyHTML = `
      <div style="background:${IS_DARK?'#352f50':'#E8E4F2'};border-radius:12px;padding:12px 16px;margin:0 0 16px;">
        <div style="font-size:13px;color:#6B5CA5;font-weight:700;">${r.spreadName||"牌阵"} · ${cards.length}张</div>
        ${r.question?`<div style="font-size:12px;color:${TEXT_C};margin-top:4px;line-height:1.6;"><b>问:</b> ${r.question}</div>`:""}
      </div>
      <div style="text-align:center;">${cardItems}</div>`;
    cardH = 1350;
  } else if (type === "gongzhen"){
    title = "📊 四法共振判定";
    const methods = r.methods || [];
    const methodColors = ["#8B6F47","#D4A040","#6B5CA5","#B8860B"];
    const mcards = methods.slice(0,4).map((m,i)=>{
      const dotC = m.level==="吉"?"#27AE60":m.level==="凶"?"#C0392B":"#B8860B";
      return `<div style="flex:1;background:${CARD_BG};border-radius:12px;padding:12px;margin:4px;border:1px solid ${IS_DARK?'#4a443c':'#ece3d6'};">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
          <span style="font-size:13px;font-weight:700;color:${BRAND_DARK};">${m.name||""}</span>
          <span style="font-size:18px;font-weight:800;color:${methodColors[i%4]};">${m.score||0}<span style="width:10px;height:10px;border-radius:50%;background:${dotC};display:inline-block;margin-left:4px;"></span></span>
        </div>
        <div style="font-size:11px;color:${SUB};line-height:1.5;">${m.summary||""}</div>
      </div>`;
    }).join("");
    const lvlColors = {大吉:"#27AE60",吉:"#4CAF50",中:"#FFC107",凶:"#E67E22",大凶:"#C0392B"};
    bodyHTML = `
      <div style="background:linear-gradient(135deg,${IS_DARK?'#3f382c':'#EFE6D8'} 0%,${CARD_BG} 100%);border-radius:14px;padding:20px;margin:0 0 16px;border:2px solid ${BRAND};text-align:center;">
        ${r.question?`<div style="font-size:13px;color:${SUB};margin-bottom:6px;">「 ${r.question} 」</div>`:""}
        <div style="font-size:56px;font-weight:900;margin:8px 0;color:${BRAND_DARK};">${r.total||0}</div>
        <div style="font-size:22px;font-weight:700;color:${lvlColors[r.level]||BRAND};margin-bottom:4px;">${r.level||""}</div>
        <div style="height:14px;background:${IS_DARK?'#2a2620':'#f3ede3'};border-radius:7px;overflow:hidden;margin:10px 20px;">
          <div style="height:100%;width:${Math.min(100,Math.round((r.total||0)))}%;background:linear-gradient(90deg,${BRAND},${BRAND_DARK});border-radius:7px;"></div>
        </div>
      </div>
      <div style="display:flex;flex-wrap:wrap;margin:0 -4px 16px;">${mcards}</div>
