  zhouyi:{ tip:"周易64卦：下卦<<3|上卦 索引 64条完整版",
    tri:["坤","震","坎","兑","艮","离","巽","乾"],
    triSym:["地","雷","水","泽","山","火","风","天"],
    hex: [
      ["坤为地","坤厚载物，德合无疆。含弘光大，品物咸亨。","地势坤，君子以厚德载物。柔顺包容，承天而行。"],
      ["地雷复","出入无疾，朋来无咎。反复其道，七日来复。","一阳来复，生机重现。反省修正，宜回归正道。"],
      ["地水师","师贞，丈人吉，无咎。","地中有水，聚众成师。用兵治事，需老成持重之人。"],
      ["地泽临","元亨利贞，至于八月有凶。","居高临下，以德化人。顺势把握时机，慎防物极必反。"],
      ["地山谦","亨，君子有终。","地中有山，谦尊而光。谦卑低调，终获吉祥。"],
      ["地火明夷","利艰贞。","明入地中，光明受伤。时运艰难，宜藏器待时。"],
      ["地风升","元亨，用见大人，勿恤，南征吉。","地中生木，积小高大。顺势上升，得贵人相助则成。"],
      ["地天泰","小往大来，吉亨。","天地交而万物通，上下交而其志同。通达顺遂之时。"],
      ["雷地豫","利建侯行师。","雷出地奋，和乐舒畅。宜定目标、顺势行动。"],
      ["震为雷","亨。震来虩虩，笑言哑哑。震惊百里，不丧匕鬯。","惊雷震动，戒惧修省。临危不乱，处变不惊。"],
      ["雷水解","利西南。无所往，其来复吉。有攸往，夙吉。","雷雨作，百果草木皆甲坼。困境松动，宜早行动。"],
      ["雷泽归妹","征凶，无攸利。","泽上有雷，少女从长男。感情事宜慎重，勿轻率决断。"],
      ["雷山小过","亨，利贞。可小事，不可大事。","山上有雷，声势过实。宜低调务实，不宜好大喜功。"],
      ["雷火丰","亨，王假之。勿忧，宜日中。","雷电皆至，光明盛大。物盛则衰，宜持盈保泰。"],
      ["雷风恒","亨，无咎，利贞，利有攸往。","雷风相与，恒久不已。持之以恒，正道方得长久。"],
      ["雷天大壮","利贞。","雷在天上，声势壮大。强盛之时，宜守正不妄动。"],
      ["水地比","吉。原筮元永贞，无咎。","地上有水，亲密比附。择善而从，团结协作。"],
      ["水雷屯","元亨利贞，勿用有攸往，利建侯。","云雷交而未雨，万事开头难。积累蓄力，不宜冒进。"],
      ["坎为水","习坎，有孚，维心亨，行有尚。","水洊至，重重险陷。诚信在心，步步为营可脱险。"],
      ["水泽节","亨。苦节不可贞。","泽上有水，堤防节制。适度节制，过犹不及。"],
      ["水山蹇","利西南，不利东北。利见大人，贞吉。","山上有水，行路艰难。知难而止，待时守正。"],
      ["水火既济","亨小，利贞。初吉终乱。","水在火上，万事已成。功成之时，慎防懈怠生变。"],
      ["水风井","改邑不改井，无丧无得。往来井井。","木上有水，养而不穷。恒久利民，守常即成。"],
      ["水天需","有孚，光亨，贞吉。利涉大川。","云上于天，待时而动。耐心等待，时机成熟再行动。"],
      ["泽地萃","亨，王假有庙。利见大人，利贞。","泽上于地，水聚汇聚。群英荟萃，团结成事。"],
      ["泽雷随","元亨利贞，无咎。","泽中有雷，顺势相随。随和从善，与时俱进。"],
      ["泽水困","亨，贞，大人吉，无咎。有言不信。","泽中无水，困穷之象。坚持正道，少言多行可脱困。"],
      ["兑为泽","亨，利贞。","丽泽相连，和悦沟通。以和为贵，广结善缘。"],
      ["泽山咸","亨，利贞，取女吉。","山上有泽，两相交感。真情相通，重在感应。"],
      ["泽火革","巳日乃孚，元亨利贞，悔亡。","泽中有火，变革更替。审时度势，适时革新。"],
      ["泽风大过","栋桡，利有攸往，亨。","泽灭木，事态过甚。力挽狂澜，非常之时行非常之事。"],
      ["泽天夬","扬于王庭，孚号有厉。","泽上于天，决断分明。果断清除小人，但不宜急躁。"],
      ["山地剥","不利有攸往。","山附于地，剥落衰微。宜藏退守正，静待时变。"],
      ["山雷颐","贞吉。观颐，自求口实。","山下有雷，颐养之道。修身养性，自食其力。"],
      ["山水蒙","亨。匪我求童蒙，童蒙求我。","山下出泉，蒙昧待启。启蒙教育，诚心求教方得指引。"],
      ["山泽损","有孚，元吉，无咎可贞，利有攸往。","山下有泽，损下益上。适度减损，反而受益。"],
      ["艮为山","艮其背，不获其身。行其庭，不见其人，无咎。","两山并立，静止不动。适时止息，安分守己。"],
      ["山火贲","亨。小利有攸往。","山下有火，文饰美化。注重礼仪外表，但勿华而不实。"],
      ["山风蛊","元亨，利涉大川。先甲三日，后甲三日。","山下有风，积弊腐败。整饬革新，革除陈弊。"],
      ["山天大畜","利贞，不家食吉，利涉大川。","天在山中，积蓄丰厚。厚积薄发，可成大事。"],
      ["火地晋","康侯用锡马蕃庶，昼日三接。","明出地上，光明上升。事业进取，受赏识晋升。"],
      ["火雷噬嗑","亨。利用狱。","雷电合章，咬合决断。排除障碍，果断执法决策。"],
      ["火水未济","亨。小狐汔济，濡其尾，无攸利。","火在水上，事未成就。差之毫厘，谨慎收尾。"],
      ["火泽睽","小事吉。","上火下泽，乖违背离。求同存异，小事仍可成就。"],
      ["火山旅","小亨，旅贞吉。","山上有火，行旅在外。漂泊不定，宜守正安稳。"],
      ["离为火","利贞，亨。畜牝牛，吉。","明两作离，重明相继。光明附丽，守正则吉。"],
      ["火风鼎","元吉，亨。","木上有火，烹饪成鼎。除旧布新，奠定新局面。"],
      ["火天大有","元亨。","火在天上，光明普照。大有所获，顺天应人。"],
      ["风地观","盥而不荐，有孚颙若。","风行地上，遍观万物。观察思考，心存诚敬。"],
      ["风雷益","利有攸往，利涉大川。","风雷相激，相得益彰。把握时机，主动行动必获益。"],
      ["风水涣","亨。王假有庙。利涉大川，利贞。","风行水上，离散涣散。凝聚人心，同舟共济。"],
      ["风泽中孚","豚鱼吉，利涉大川，利贞。","泽上有风，中心诚信。至诚感人，可涉大险。"],
      ["风山渐","女归吉，利贞。","山上有木，循序渐进。步步踏实，不可拔苗助长。"],
      ["风火家人","利女贞。","风自火出，家道有序。修身齐家，内外有别。"],
      ["巽为风","小亨，利有攸往，利见大人。","随风相随，谦逊深入。顺势而为，得贵人指引。"],
      ["风天小畜","亨。密云不雨，自我西郊。","风行天上，积蓄待发。力量不足，宜暂蓄养实力。"],
      ["天地否","否之匪人，不利君子贞，大往小来。","天地不交，闭塞不通。时运不济，宜藏器待时。"],
      ["天雷无妄","元亨利贞。其匪正有眚，不利有攸往。","天下雷行，顺势而为。不存妄念，脚踏实地则吉。"],
      ["天水讼","有孚，窒惕，中吉，终凶。","天与水违行，争讼之象。宜化解矛盾，不可缠讼到底。"],
      ["天泽履","履虎尾，不咥人，亨。","上天下泽，谨慎前行。履险如夷，小心谨慎可免祸。"],
      ["天山遁","亨，小利贞。","天下有山，退避隐匿。识时务者为俊杰，退而保全。"],
      ["天火同人","同人于野，亨。利涉大川，利君子贞。","天与火同，志同道合。广结善缘，众人同心则事成。"],
      ["天风姤","女壮，勿用取女。","天下有风，意外相遇。防范未然，慎防小人暗害。"],
      ["乾为天","元亨利贞。","天行健，君子以自强不息。刚健中正，大展宏图。"]
    ]
  },
  qimen:{
    overview:{
      yangYang:"此局为<b>阳遁</b>，阳气渐升，气机舒展，宜主动、进取、先发制人。",
      yangYin:"此局为<b>阴遁</b>，阴气渐长，气机内敛，宜静守、谋划、后发制人。",
      zhiFuGood:"值符当令，得天时之助，关键之事有神妙之机。",
      zhiShiKey:"值使门主事机变化，开休生三门则吉，景杜死伤惊则慎。",
      geMoreGood:"吉格多于凶格，整体气机偏顺，乘势而为可收良效。",
      geMoreBad:"凶格多于吉格，整体气机偏逆，宜稳中求进，切忌冒进。",
      geBalance:"吉凶参半，事在人为，守正行稳方得始终。"
    },
    career:{
      good:"当前局中吉格多见，事业与决策上可大胆推进，尤其遇到值符/值使同宫、三奇得使等格局，主贵人相助、计划易成。",
