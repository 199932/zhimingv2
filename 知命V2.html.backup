function equationOfTime(N){
  const B = 2 * Math.PI / 365 * (N - 81); // 弧度，公式用弧度
  const E = 9.87 * Math.sin(2*B) - 7.53 * Math.cos(B) - 1.5 * Math.sin(B);
  return E;
}
function isChinaDST(date){
  const y = date.getFullYear();
  if (y < 1986 || y > 1991) return false;
  const m = date.getMonth()+1, d = date.getDate(), h = date.getHours();
  const ts = date.getTime();
  function nthWeekday(y,m,n,w){// nth n(1,2..)  weekday w(0=Sun..6)
    const first = new Date(y,m-1,1);
    const off = (w - first.getDay() + 7) % 7;
    return new Date(y, m-1, 1 + off + (n-1)*7);
  }
  let start, end;
  if (y === 1986){
    start = new Date(1986,4,4,0,0,0); // 5月4日(1986.5.4确实是第1个周日)
    end = new Date(1986,8,14,0,0,0);  // 9月中 ~ 9.14
  } else {
    start = nthWeekday(y,4,2,0);       // 4月第2个周日
    end   = nthWeekday(y,9,2,0);       // 9月第2个周日
  }
  return ts >= start.getTime() && ts < end.getTime();
}
function trueSolarTime(beijingTime, lngE){
  let t = new Date(beijingTime.getTime());
  const dstBefore = isChinaDST(t);
  let dstMinus = 0;
  if (dstBefore){ t.setHours(t.getHours()-1); dstMinus = 60; }
  const jan1 = new Date(t.getFullYear(),0,1);
  const N = Math.floor((t - jan1)/86400000) + 1;
  const lngMin = 4 * (lngE - 120);
  const EoT = equationOfTime(N);
  const corrected = new Date(t.getTime() + Math.round((lngMin + EoT) * 60000));
  corrected._debug = {
    originalBJ: new Date(beijingTime.getTime()),
    afterDST: new Date(t.getTime()),
    dstMinusMin: dstMinus,
    lngDiffMin: +lngMin.toFixed(2),
    eotMin: +EoT.toFixed(2),
    totalCorrectionMin: +(dstMinus + lngMin + EoT).toFixed(2)
  };
  return corrected;
}

