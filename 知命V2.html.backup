  const COURT_TWEAK_R = {
    wands:["年轻人缺乏耐心做事三分钟热度，需要督促。","做事毛躁易冲动闯祸，不计后果的做法很危险。","控制欲强或虚荣的女性，让人感到压迫和不满。","傲慢自大的男性领导者，独断专行不听劝终吃亏。"],
    cups:["多情敏感易受伤，情绪起伏大容易被人利用。","用情不专的暧昧对象，嘴上爱你心里还有别人。","情感勒索/操控型女性，用眼泪和委屈达成目的。","逃避责任的伴侣/男性，遇事只会躲不肯承担。"],
    swords:["嘴上不饶人的年轻人，爱顶嘴爱钻牛角尖伤人。","心怀恶意的对手，使用阴谋诡计不择手段。","冷漠刻薄的女性，说话伤人且毫无同情心。","独裁固执的男性掌权者，滥用权力打压异己。"],
    pentacles:["懒懒散散不思进取的人，物质拮据还不肯努力。","贪财吝啬的小气鬼，做事只看眼前利益不顾长远。","拜金虚荣的女性，一味索取不懂付出与感恩。","唯利是图的商人/老板，不讲诚信只顾自己赚钱。"]
  };
  function minorDesc(suit, num, isR, kindIdx){
    const arr = isR ? MINOR_R[suit][["love","career","choice"][kindIdx]] : MINOR_U[suit][["love","career","choice"][kindIdx]];
    const idx = (num <= 10) ? (num - 1) : (num - 11);
    let s = arr[idx % arr.length] || arr[0];
    if (num >= 11 && num <= 14){
      const tweak = isR ? COURT_TWEAK_R[suit][num-11] : COURT_TWEAK_U[suit][num-11];
      s = tweak + " " + s;
    }
    return s;
  }
  function minorKeywords(suit, num, isR){
    const suitTheme = {
      wands:{u:["激情","行动","创造","热情","领导","进取","开拓","活力","勇气","专注"],r:["冲动","鲁莽","焦躁","拖延","固执","专横","散涣","倦怠","挫败","自负"]},
      cups: {u:["爱意","共情","浪漫","深情","信任","温馨","治愈","创意","喜悦","和谐"],r:["情绪化","敏感","冷战","猜忌","失落","沉溺","暧昧","失望","忧郁","自欺"]},
      swords:{u:["理性","沟通","决断","策略","真理","分析","独立","突破","逻辑","正义"],r:["冲突","刻薄","冷漠","纠结","焦虑","逃避","争执","偏见","优柔","痛苦"]},
      pentacles:{u:["稳定","务实","财富","积累","成长","落地","安全","专业","可靠","复利"],r:["贪婪","吝啬","停滞","亏损","怠惰","物质","抠门","拖延","保守","负债"]}
    };
    const pool = isR ? suitTheme[suit].r : suitTheme[suit].u;
    const i1 = (num * 3 + (isR?5:1)) % pool.length;
    const i2 = (num * 7 + (isR?2:4)) % pool.length;
    const i3 = (num * 11 + (isR?8:7)) % pool.length;
    const kw = Array.from(new Set([pool[i1],pool[i2],pool[i3]])).slice(0,3);
    while(kw.length<3) kw.push(pool[(kw.length+num)%pool.length]);
    return kw;
  }
  const desc = {};
  MAJOR_INFO.forEach(m=>{
    const [num,name,ku,kr,du,dr] = m;
    desc[num] = {
      name, keywords_u:ku, keywords_r:kr,
      desc_u:{love:du[0],career:du[1],choice:du[2]},
      desc_r:{love:dr[0],career:dr[1],choice:dr[2]}
    };
  });
  const suits = ["wands","cups","swords","pentacles"];
  let id = 22;
  suits.forEach(suit=>{
    for (let n = 1; n <= 14; n++){
      const name = SUIT_CN[suit] + numName(n);
      desc[id] = {
        name,
        keywords_u: minorKeywords(suit,n,false),
        keywords_r: minorKeywords(suit,n,true),
        desc_u: {love:minorDesc(suit,n,false,0), career:minorDesc(suit,n,false,1), choice:minorDesc(suit,n,false,2)},
        desc_r: {love:minorDesc(suit,n,true,0), career:minorDesc(suit,n,true,1), choice:minorDesc(suit,n,true,2)}
      };
      id++;
    }
  });
  TEXT.tarot.desc = desc;
})();

/* 构造 TAROT_DATA 数组 */
const TAROT_DATA = (function(){
  const arr = [];
  const MAJOR_NAMES = ["愚者","魔术师","女祭司","皇后","皇帝","教皇","恋人","战车","力量","隐士","命运之轮","正义","倒吊人","死神","节制","恶魔","高塔","星星","月亮","太阳","审判","世界"];
  for (let i = 0; i < 22; i++){
    const d = TEXT.tarot.desc[i];
    arr.push({id:i,type:"major",suit:null,num:i,name:MAJOR_NAMES[i],
      keywords_u:d.keywords_u,keywords_r:d.keywords_r,
      desc_u:d.desc_u,desc_r:d.desc_r});
  }
  const SUITS = ["wands","cups","swords","pentacles"];
  let id = 22;
  SUITS.forEach(suit=>{
    for (let n = 1; n <= 14; n++){
      const d = TEXT.tarot.desc[id];
      arr.push({id,type:"minor",suit,num:n,name:d.name,
        keywords_u:d.keywords_u,keywords_r:d.keywords_r,
        desc_u:d.desc_u,desc_r:d.desc_r});
      id++;
    }
  });
  return arr; // 0..77
})();

/* --- 5.1  renderTarotFaceSVG & renderTarotBackSVG  --- */
function renderTarotFaceSVG(id, width, height, reversed){
  const t = TAROT_DATA[id]; if (!t) return "";
  const numLabel = t.type === "major" ? (t.num===0?"0":String(t.num))
                    : (t.num===1?"ACE":t.num<=10?String(t.num):["","","","","","","","","","","","侍","骑","后","王"][t.num]);
  const nameStr = `${numLabel}-${t.name}`;
  const urText = reversed ? "逆位 Reversed" : "正位 Upright";
  const inner = t.type === "major" ? _majorInnerSVG(t.num) : _minorInnerSVG(t.suit, t.num);
  return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 200" width="${width||120}" height="${height||200}">
    <defs>
      <linearGradient id="f1_${id}" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#FFF9F0"/><stop offset="1" stop-color="#F4E9D7"/>
      </linearGradient>
      <linearGradient id="fg_${id}" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#B8860B"/><stop offset="1" stop-color="#8B6914"/>
      </linearGradient>
    </defs>
    <!-- 外卡底色 -->
    <rect x="0" y="0" width="120" height="200" rx="6" fill="url(#f1_${id})"/>
    <!-- 外层棕金边框 -->
    <rect x="3" y="3" width="114" height="194" rx="5" fill="none" stroke="url(#fg_${id})" stroke-width="2"/>
    <rect x="7" y="7" width="106" height="186" rx="3" fill="none" stroke="#A0783A" stroke-width="1"/>
    <!-- 顶部横条 -->
    <rect x="7" y="9" width="106" height="18" fill="#6B5CA5"/>
    <rect x="7" y="27" width="106" height="1" fill="#A0783A"/>
    <text x="60" y="22" font-size="9" font-family="sans-serif" font-weight="700" fill="#FFFFFF" text-anchor="middle">${nameStr}</text>
    <!-- 图案区 -->
    <g transform="translate(12,33)">${inner}</g>
    <!-- 底部小字 -->
    <rect x="7" y="182" width="106" height="1" fill="#A0783A"/>
    <text x="60" y="194" font-size="7" font-family="sans-serif" fill="#8B6914" text-anchor="middle">${urText}</text>
  </svg>`;
}

function renderTarotBackSVG(width, height){
  return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 200" width="${width||120}" height="${height||200}">
    <defs>
      <radialGradient id="bk1" cx="50%" cy="50%" r="70%">
        <stop offset="0" stop-color="#6B5CA5"/><stop offset="1" stop-color="#3A2F66"/>
      </radialGradient>
      <pattern id="bkP" x="0" y="0" width="16" height="16" patternUnits="userSpaceOnUse">
        <polygon points="8,1 9.5,6 15,6 10.5,9 12,14.5 8,11.5 4,14.5 5.5,9 1,6 6.5,6" fill="#FFD700" opacity="0.25"/>
      </pattern>
    </defs>
    <rect x="0" y="0" width="120" height="200" rx="6" fill="url(#bk1)"/>
    <rect x="3" y="3" width="114" height="194" rx="5" fill="url(#bkP)"/>
    <rect x="7" y="7" width="106" height="186" rx="3" fill="none" stroke="#FFD700" stroke-width="1" opacity="0.6"/>
    <!-- 中心装饰 -->
    <circle cx="60" cy="100" r="48" fill="none" stroke="#FFD700" stroke-width="1" opacity="0.55"/>
    <circle cx="60" cy="100" r="36" fill="none" stroke="#FFD700" stroke-width="0.8" opacity="0.4"/>
    <!-- 8角星 -->
    <polygon points="60,66 66,90 90,96 66,102 60,126 54,102 30,96 54,90" fill="#FFD700" opacity="0.75"/>
    <circle cx="60" cy="96" r="5" fill="#FFF8DC" opacity="0.9"/>
    <!-- 四角花纹 -->
    <g fill="#FFD700" opacity="0.6">
      <polygon points="14,14 18,20 24,24 18,28 14,34 10,28 4,24 10,20"/>
      <polygon points="106,14 110,20 116,24 110,28 106,34 102,28 96,24 102,20"/>
      <polygon points="14,186 18,180 24,176 18,172 14,166 10,172 4,176 10,180"/>
      <polygon points="106,186 110,180 116,176 110,172 106,166 102,172 96,176 102,180"/>
    </g>
  </svg>`;
}

/* --- 22 大阿卡纳 SVG 图案 --- 内容区坐标 (0,0) 对应整卡的 (12,33), 尺寸 宽96 高148 --- */
function _majorInnerSVG(num){
  const s = 96, h = 148;
  switch(num){
    case 0: // 愚者：山岗+小人背影+小狗+彩色太阳
      return `<g>
        <polygon points="0,140 30,80 48,100 70,60 96,140" fill="#F5DEB3" stroke="#A0826D" stroke-width="0.5"/>
        <polygon points="10,140 40,95 60,120 80,75 96,140" fill="#EEE0C8" opacity="0.7"/>
        <!-- 8角太阳 -->
        <g transform="translate(78,20)">
          <polygon points="0,-12 3,-4 12,-3 5,2 7,11 0,6 -7,11 -5,2 -12,-3 -3,-4" fill="#FFD700"/>
          <circle cx="0" cy="0" r="4" fill="#FF8C00"/>
        </g>
        <!-- 小人(背影) -->
        <circle cx="34" cy="94" r="4" fill="#333"/>
        <path d="M28,98 L40,98 L42,130 L26,130 Z" fill="#4682B4"/>
        <rect x="40" y="102" width="8" height="10" fill="#A0522D"/> <!-- 包袱 -->
        <line x1="42" y1="102" x2="38" y2="96" stroke="#000" stroke-width="0.8"/>
        <line x1="30" y1="130" x2="28" y2="140" stroke="#000" stroke-width="1"/>
        <line x1="38" y1="130" x2="40" y2="140" stroke="#000" stroke-width="1"/>
        <!-- 小狗 -->
        <g transform="translate(48,128)">
          <ellipse cx="0" cy="0" rx="6" ry="4" fill="#D2B48C"/>
          <circle cx="6" cy="-2" r="3" fill="#D2B48C"/>
          <polygon points="4,-6 5,-3 7,-4" fill="#8B4513"/>
          <line x1="-6" y1="0" x2="-10" y2="-2" stroke="#8B4513" stroke-width="1"/>
        </g>
      </g>`;
    case 1: // 魔术师：桌子+四元素+∞
      return `<g>
        <text x="48" y="18" font-size="16" fill="#B8860B" text-anchor="middle" font-weight="700">∞</text>
        <!-- 桌子 -->
        <rect x="14" y="80" width="68" height="50" fill="#A0522D" stroke="#5C3A1E" stroke-width="1"/>
        <rect x="14" y="78" width="68" height="4" fill="#8B4513"/>
        <line x1="18" y1="130" x2="16" y2="148" stroke="#5C3A1E" stroke-width="2"/>
        <line x1="78" y1="130" x2="80" y2="148" stroke="#5C3A1E" stroke-width="2"/>
        <!-- 权杖 -->
        <g transform="translate(26,48)"><rect x="-1" y="0" width="3" height="30" fill="#DAA520"/><circle cx="0" cy="-2" r="4" fill="#FFD700"/></g>
        <!-- 圣杯 -->
        <g transform="translate(48,48)">
          <path d="M-8,0 Q0,-14 8,0 Q6,10 0,14 Q-6,10 -8,0 Z" fill="#4A90E2"/>
          <rect x="-1" y="14" width="2" height="6" fill="#4A90E2"/>
          <rect x="-6" y="20" width="12" height="2" fill="#4A90E2"/>
        </g>
        <!-- 宝剑 -->
        <g transform="translate(70,50)">
          <polygon points="-2,-20 0,-24 2,-20 2,4 -2,4" fill="#C0C0C0" stroke="#808080" stroke-width="0.5"/>
          <rect x="-6" y="4" width="12" height="2" fill="#A0522D"/>
          <rect x="-1" y="6" width="2" height="8" fill="#A0522D"/>
        </g>
        <!-- 星币 -->
        <g transform="translate(48,108)">
          <polygon points="0,-10 3,-3 10,-3 4.5,2 6.5,9 0,5 -6.5,9 -4.5,2 -10,-3 -3,-3" fill="#FFD700" stroke="#B8860B" stroke-width="0.8"/>
        </g>
      </g>`;
    case 2: // 女祭司：端坐+双柱+月+TORA卷轴
      return `<g>
        <!-- 双柱 -->
        <rect x="8" y="30" width="12" height="110" fill="#1C1C1C"/>
        <rect x="76" y="30" width="12" height="110" fill="#F5F5F5" stroke="#333" stroke-width="0.5"/>
        <text x="14" y="90" font-size="14" fill="#FFD700" text-anchor="middle" font-weight="700">B</text>
        <text x="82" y="90" font-size="14" fill="#1C1C1C" text-anchor="middle" font-weight="700">J</text>
        <!-- 人物 -->
        <g transform="translate(48,50)">
          <polygon points="-20,0 20,0 26,90 -26,90" fill="#4B0082"/>
          <circle cx="0" cy="-4" r="10" fill="#FFE4B5"/>
          <path d="M-10,-8 L10,-8 L12,-16 L-12,-16 Z" fill="#4B0082"/> <!-- 头巾 -->
          <rect x="-22" y="20" width="44" height="40" fill="#8A2BE2"/> <!-- 斗篷 -->
          <!-- TORA卷轴 -->
          <g transform="translate(0,38)">
            <rect x="-10" y="-4" width="20" height="12" fill="#F5DEB3" stroke="#8B4513" stroke-width="0.5"/>
            <text x="0" y="5" font-size="7" fill="#8B4513" text-anchor="middle" font-weight="700">TORA</text>
          </g>
        </g>
        <!-- 月亮 -->
        <g transform="translate(48,138)">
          <circle cx="0" cy="0" r="7" fill="#F5F5F5" stroke="#C0C0C0" stroke-width="0.5"/>
          <circle cx="2.5" cy="0" r="5.5" fill="#4B0082"/>
        </g>
      </g>`;
    case 3: // 皇后：坐椅+金星符号+花园麦穗
      return `<g>
        <rect x="8" y="60" width="80" height="88" fill="#FFE4E1" stroke="#DB7093" stroke-width="1"/>
        <!-- 人物 -->
        <g transform="translate(48,46)">
          <circle cx="0" cy="0" r="10" fill="#FFE4B5"/>
          <circle cx="0" cy="-6" r="9" fill="#DAA520"/> <!-- 皇冠 -->
          <circle cx="-5" cy="-4" r="1.5" fill="#FF4500"/>
          <circle cx="0" cy="-8" r="1.5" fill="#FF4500"/>
          <circle cx="5" cy="-4" r="1.5" fill="#FF4500"/>
          <path d="M-20,14 L20,14 28,80 -28,80 Z" fill="#FF69B4"/>
          <polygon points="0,34 -4,46 4,46" fill="#FFD700"/>
        </g>
        <!-- 金星♀ -->
        <g transform="translate(18,130)"><circle cx="0" cy="0" r="5" fill="none" stroke="#FF1493" stroke-width="1.5"/>
          <line x1="0" y1="5" x2="0" y2="15" stroke="#FF1493" stroke-width="1.5"/>
          <line x1="-5" y1="10" x2="5" y2="10" stroke="#FF1493" stroke-width="1.5"/></g>
        <!-- 麦穗 -->
        <g transform="translate(78,120)" stroke="#DAA520" stroke-width="1.5" fill="#FFD700">
          <line x1="0" y1="0" x2="0" y2="25"/>
          <ellipse cx="-4" cy="-5" rx="3" ry="2"/>
          <ellipse cx="4" cy="0" rx="3" ry="2"/>
          <ellipse cx="-4" cy="6" rx="3" ry="2"/>
          <ellipse cx="4" cy="12" rx="3" ry="2"/>
        </g>
      </g>`;
    case 4: // 皇帝：王座+白羊头+权杖+♂
      return `<g>
        <rect x="8" y="50" width="80" height="98" fill="#FF8C00" stroke="#8B0000" stroke-width="1"/>
        <!-- 王座靠背 -->
        <rect x="18" y="20" width="60" height="10" fill="#8B4513"/>
        <g transform="translate(28,20)"><circle cx="0" cy="0" r="5" fill="#C0C0C0"/>
          <path d="M-3,-5 Q0,-11 3,-5 L3,0 L-3,0 Z" fill="#C0C0C0"/> <!-- 羊角 -->
          <circle cx="-1.5" cy="-1" r="0.8" fill="#000"/>
          <circle cx="1.5" cy="-1" r="0.8" fill="#000"/></g>
        <g transform="translate(68,20)"><circle cx="0" cy="0" r="5" fill="#C0C0C0"/>
          <path d="M-3,-5 Q0,-11 3,-5 L3,0 L-3,0 Z" fill="#C0C0C0"/>
          <circle cx="-1.5" cy="-1" r="0.8" fill="#000"/>
          <circle cx="1.5" cy="-1" r="0.8" fill="#000"/></g>
        <!-- 人物 -->
        <g transform="translate(48,54)">
          <circle cx="0" cy="0" r="9" fill="#FFE4B5"/>
          <polygon points="-7,-9 7,-9 5,-16 0,-20 -5,-16" fill="#FFD700"/> <!-- 皇冠 -->
          <rect x="-20" y="10" width="40" height="70" fill="#8B0000"/>
          <polygon points="-8,18 0,22 8,18 4,44 -4,44" fill="#FFD700"/>
        </g>
        <!-- 权杖(右手) -->
        <g transform="translate(20,80)"><rect x="0" y="0" width="3" height="30" fill="#FFD700"/>
          <circle cx="1.5" cy="-4" r="5" fill="#FF0000"/></g>
        <!-- ♂ -->
        <g transform="translate(78,130)"><circle cx="0" cy="0" r="5" fill="none" stroke="#8B0000" stroke-width="1.5"/>
          <line x1="3" y1="-3" x2="10" y2="-10" stroke="#8B0000" stroke-width="1.5"/>
          <line x1="6" y1="-10" x2="12" y2="-10" stroke="#8B0000" stroke-width="1.5"/>
          <line x1="12" y1="-10" x2="12" y2="-4" stroke="#8B0000" stroke-width="1.5"/></g>
      </g>`;
    case 5: // 教皇：双交叉钥匙+信徒+三重冠
      return `<g>
        <polygon points="48,14 16,140 80,140" fill="#800080" opacity="0.5"/>
        <!-- 人物 -->
        <g transform="translate(48,38)">
          <circle cx="0" cy="0" r="9" fill="#FFE4B5"/>
          <polygon points="-8,-10 -4,-18 0,-14 4,-18 8,-10 6,-6 -6,-6" fill="#FFD700"/> <!-- 三重冠 -->
          <polygon points="-16,10 16,10 24,80 -24,80 Z" fill="#4B0082"/>
          <rect x="-12" y="18" width="24" height="6" fill="#FFD700"/>
