/* --- 5.1 + 5.2  78张塔罗数据 & 解读 TEXT.tarot --- */
(function initTarotText(){
  const MAJOR_INFO = [
    [0,"愚者",["新起点","冒险","纯真"],["鲁莽","盲目","停滞"],
      ["感情上愿意放下顾虑，真诚投入新关系，有机会邂逅有趣的人。","适合尝试新思路、换岗或创业，保持好奇能带来突破。","做选择时听从直觉，但也要评估基础风险，别单凭冲动。"],
      ["对感情过度天真易受伤，不愿面对现实容易错过对的人。","工作上缺乏规划易出错，不宜贸然跳槽或草率决策。","选前没准备清楚易踩坑，建议多问几人再决定。"]],
    [1,"魔术师",["创造","意志","行动"],["欺骗","混乱","失控"],
      ["有能力经营好关系，主动示好和沟通能快速拉近距离。","创造力爆棚，提案谈判易成功，是展现才华的好时机。","你的能力足以左右结果，选哪个都能凭实力做好。"],
      ["感情中有隐瞒或操纵，表面完美其实暗藏谎言。","工作光说不练，计划多落地少，谨防被同事画大饼。","选择被情绪误导，看似机会实则陷阱，三思而行。"]],
    [2,"女祭司",["直觉","静默","智慧"],["秘密","疏离","偏执"],
      ["慢热式感情，保持神秘反而更有吸引力，勿过度主动。","适合深度研究、幕后工作，靠专业判断比社交更得利。","重要决定相信第六感，信息不足时多观察少表态。"],
      ["感情里隔阂加深，不沟通易生猜忌，有秘密要及时说清。","工作陷入钻牛角尖，偏执己见会错失合作机会。","被片面信息误导，选前一定要把关键数据拿到手。"]],
    [3,"皇后",["丰饶","母爱","创造力"],["依赖","占有","停滞"],
      ["感情升温甜蜜，单身者有相亲/表白机会，付出会有回报。","事业稳中有升，适合团队管理、艺术创作、客户运营。","选能带来长期滋养的方向，短期投机别动心。"],
      ["过度付出反被轻视，感情失衡易生抱怨边界感差。","舒适区太久缺乏进取，被取代风险高宜动不宜静。","被依赖感绑架选错项，学会对自己负责再决定。"]],
    [4,"皇帝",["权威","秩序","自律"],["专制","僵化","压制"],
      ["感情里偏理性主导，稳定但需要多些温柔和共情。","事业适合做管理、做决策，按规矩办事可掌控局面。","用理性数据做选择，控制住情绪方能选出最优解。"],
      ["控制欲过强会让对方窒息，硬碰硬只会两败俱伤。","独断专行得罪人，规则太死反而阻碍业务推进。","选项被强势方操控，要争回自己的决策权。"]],
    [5,"教皇",["传统","信仰","指引"],["教条","束缚","从众"],
      ["感情有长辈/媒妁牵线机会，价值观一致的关系更稳固。","适合学习考证、拜师、进大公司，走规范路径上升。","参考过来人的经验，别凭喜好做重大人生选择。"],
      ["过于按他人剧本恋爱，失去自我难以真正被爱。","刻板流程拖慢效率，不敢创新难获晋升机会。","盲目跟风做选择，后悔时才发现不是自己要的。"]],
    [6,"恋人",["结合","选择","和谐"],["分裂","犹豫","出轨"],
      ["热恋正缘信号，沟通理解佳，表白和求婚成功率高。","合作签约顺利，搭档互补有默契，人际带来好资源。","站在人生岔路口，忠于内心才能选到不后悔的路。"],
      ["三观不合矛盾爆发，第三者或暧昧容易趁虚而入。","合作破裂信任危机，合伙人要明算账、补合同。","举棋不定两边落空，必须尽快做出艰难取舍。"]],
    [7,"战车",["意志","前进","胜利"],["失控","冲突","疲惫"],
      ["主动出击能破冰，驾驭关系节奏需要耐心和决心。","攻坚项目和竞争岗有利，咬牙推进终将拿下目标。","只要坚持到底的那条路，往往就是正确的那条。"],
      ["感情硬碰硬两败俱伤，太强势反而推对方更远。","方向错越努力越糟，暂停一下比盲目加速更重要。","被情绪推着向前冲，及时刹车才能避免更大损失。"]],
    [8,"力量",["勇气","温柔","耐心"],["自我怀疑","焦躁","失控"],
      ["温柔化解矛盾，真诚的包容能让关系更上一层楼。","以柔克刚搞定难搞客户，实力的底气来自内在稳定。","自信是你选对的关键，相信自己值得更好的选项。"],
      ["内心脆弱敏感，一点摩擦就放大，容易把爱人作走。","遇事慌乱决策失当，被压力压垮会拖团队后腿。","自我怀疑而选错路，先重建信心再谈选择。"]],
    [9,"隐士",["内省","独处","智慧"],["孤独","逃避","封闭"],
      ["单身期是自我提升的好时机，宁缺毋滥等待正缘。","适合独立研究、复盘沉淀，深度思考后再行动更好。","问选择时需回到内心，别人的建议只能作参考。"],
      ["感情冷暴力或封闭沟通，长期逃避让问题越积越重。","闭门造车脱离业务一线，信息差导致判断失误。","逃避做决定反而错过时间窗口，必须主动面对。"]],
    [10,"命运之轮",["转机","循环","机遇"],["挫折","厄运","失控"],
      ["缘分突然降临，异地或偶遇桃花，保持开放心态。","行业周期有利，抓住风口可短期获得超预期回报。","顺其自然的选择反而最顺，不必强留无法改变的。"],
      ["感情进入瓶颈或坏循环，分手概率高不宜强求。","流年不利业绩下滑，不宜重仓投资或冒进扩张。","处在下行周期，怎么选都难，保守为上策。"]],
    [11,"正义",["公平","真相","责任"],["偏见","不公","逃避"],
      ["平等尊重的感情最长久，坦诚沟通能化解所有误会。","凭实力争取公平待遇，合同条款要一字一句看清。","利大于弊？弊大于利？把帐算清楚再选不会错。"],
      ["感情有双标或隐瞒，不平等关系迟早会爆发冲突。","职场遭遇不公，申诉时需要有充分证据才能翻盘。","选择被偏见引导，忽略数据和事实会后悔。"]],
    [12,"倒吊人",["等待","牺牲","换位"],["停滞","牺牲过度","执迷"],
      ["慢节奏的恋爱，换角度看对方的付出会更懂得珍惜。","先沉淀再突破的阶段，短期牺牲休息能换长期回报。","不必急着选，再等等信息会更明朗，时间会给出答案。"],
      ["单方面付出过度，自我感动却得不到对方回应。","卡在舒适区太久，时间都浪费在无意义的等待。","越拖代价越大，该止损时就要果断止损。"]],
    [13,"死神",["结束","蜕变","新生"],["抗拒改变","拖延","旧习难改"],
      ["旧关系结束是为真爱的让路，放下才有新开始。","职业/项目转型窗口期，断臂求生比苟延残喘强。","主动告别不合适的旧选项，才能拥抱真正的机会。"],
      ["死抓烂尾关系不放手，互相消耗到最后都是伤害。","死守旧业务老方法，被淘汰只会更惨更痛。","迟迟不肯做抉择，被动结束比主动放手代价更高。"]],
    [14,"节制",["平衡","调和","耐心"],["失衡","过度","冲突"],
      ["感情节奏刚刚好，细水长流，沟通顺畅互相成就。","资源分配得当，项目节奏稳，合作各方都满意。","中庸的那个选项就是最优解，别走向任何极端。"],
      ["情绪冷热不均让人难以捉摸，矛盾越积越严重。","摊子铺太大顾不过来，节奏失调处处出漏洞。","非黑即白走极端，结果两边都做不好。"]],
    [15,"恶魔",["诱惑","执念","欲望"],["觉醒","解绑","断舍离"],
      ["沉迷肉体或物质的关系，表面激情实则被欲望操控。","短期暴利诱惑大，但可能踩合规红线要警惕风险。","诱人的选项往往有毒，先看代价再看收益。"],
      ["看清执念勇敢解绑，离开错的人才能找回真正自己。","跳出陷阱保住本金，及时切断不良合作止损保命。","抗拒诱惑虽然短期痛苦，但长期会感谢自己。"]],
    [16,"高塔",["突变","崩塌","觉醒"],["恐惧改变","逃避现实","二次危机"],
      ["感情旧模式被打破，虽然痛但诚实面对才有重建可能。","黑天鹅事件强制转型，坏事往往倒逼出正确方向。","被迫做的选择虽然痛，但长远看是必要的转折点。"],
      ["关系破裂后不愿接受现实，反复纠缠二次受伤更重。","突发危机处理失当，逃避掩盖只会让损失扩大。","抗拒改变反而被逼到墙角，越早主动应对越好。"]],
    [17,"星星",["希望","疗愈","灵感"],["迷茫","不切实际","失望"],
      ["遇到灵魂伴侣的契机，温柔真诚的互动让心被治愈。","创意行业和研究工作迎来灵感迸发期，大胆提方案。","选能让你心里燃起希望的那条，相信它不会负你。"],
      ["对人期待过高导致失望，理想与现实差距让人灰心。","计划太理想化落地难，画饼充饥不如脚踏实地。","选择只看美好预期不看落地条件，容易踩空。"]],
    [18,"月亮",["幻觉","潜意识","不安"],["真相浮现","走出迷雾","释然"],
      ["暧昧期让人捉摸不定，警惕小三/谎言等隐藏问题。","项目信息不透明，直觉不安时要深挖背景和数据。","当前看不清选项时别乱选，等真相浮出水面再动。"],
      ["隐藏的矛盾终于暴露，虽痛但终于能看清现实面对。","之前的误会/骗局被揭开，澄清后声誉可以恢复。","迷雾散去发现担心是多余，可以安心做决定。"]],
    [19,"太阳",["喜悦","成功","活力"],["自负","短暂","骄傲"],
      ["热恋阳光般明朗，感情公开被祝福，备孕添丁顺利。","事业成果显著，表彰/晋升/大单临门，人气爆棚。","哪个方向让你最兴奋最有热情，就是正确选择。"],
      ["成功冲昏头骄傲自满，感情易因自负出裂缝。","高光时刻不懂得沉淀，很快跌落摔得更重。","只看表面光鲜忽略风险，选了繁华易碎的选项。"]],
    [20,"审判",["觉醒","复盘","重生"],["自我怀疑","拒绝改变","责备"],
      ["旧情复燃或得到释怀的机会，坦然面对心结可疗愈。","复盘总结后重启项目，被认可/翻盘几率很高。","认真反思过去经历，这次你会选一条不后悔的路。"],
      ["深陷自责无法前进，感情反复翻旧账消耗彼此。","拒绝承认过去的错误，死撑导致机会再次错过。","被他人评价绑架选了不想要的，之后还会重蹈覆辙。"]],
    [21,"世界",["圆满","完成","整合"],["未完成","延迟","有缺"],
      ["修成正果的阶段，订婚结婚、关系稳定幸福美满。","项目完美收官，升职加薪、拿到最想要的offer。","任何一个选项都能有不错结局，相信你选的就是最好。"],
      ["差临门一脚却松懈，功亏一篑非常可惜要再坚持。","项目收尾出纰漏，目标虽近但完成度差强人意。","看似圆满实则藏隐忧，再核对细节再做最终决定。"]]
  ];
  const SUIT_CN = {wands:"权杖",cups:"圣杯",swords:"宝剑",pentacles:"星币"};
  const NUM_CN = {1:"ACE",11:"侍从",12:"骑士",13:"王后",14:"国王"};
  function numName(n){return NUM_CN[n]?NUM_CN[n]:String(n);}
  const MINOR_U = {
    wands: { // 火：行动、热情、事业、创造
      love:["关系进展充满热情，主动约会能快速升温，适合共同规划未来。","双方目标一致，有共同兴趣和行动力，感情生活充满乐趣。","热情正在慢慢积累，别太急躁让彼此都舒服地靠近。","相处模式很有活力，一起运动、旅行、尝试新事物能增进感情。","有一方主导型人格，注意控制节奏避免另一方压力大。","感情基础在稳定发展，给这段关系一些耐心和空间。","火花正在转成稳定感，是正式确认关系的好时机。","沟通热烈但也要倾听对方需求，别只顾自己表达。","双方都很投入感情，有机会达成长期稳定的承诺。","感情中保持热情的同时，也要一起面对现实问题。"],
      career:["新机会新项目启动，大胆提案展示自己能得到关注。","团队协作顺畅，你的行动力会让领导刮目相看。","短期项目推进顺利，注意别冲动答应太多超出能力的事。","基础扎实了可以谈加薪/升职，是时候展现真实实力。","竞争中有优势，但需要更耐心打磨方案细节。","创意爆发期，适合做策划、市场、启动类工作。","遇到阻力但冲劲足够，咬咬牙坚持就能突破瓶颈。","手上项目太多忙不过来，优先级排序和授权更重要。","阶段性成果被看见，外部机会（offer）可能找上门。","目标近在咫尺，最后一英里要稳住不要骄傲松懈。"],
      choice:["充满热情的那个选项更好，它更符合你内心的渴望。","选变化大、有挑战的那一个，你有足够动力驾驭它。","两个都不错，选能让你持续兴奋不无聊的方向。","不要只看短期兴奋点，要评估长期可持续的热情。","如果一个选项让你更愿意早起去做，就选它。","冷静对比利弊后，让最终决定倾向于让你更有激情的。","选择前先问自己能为此坚持多久，别一时冲动。","快节奏高回报的选项更适合你当前的状态。","建议选需要主动出击和创造的那条路。","选择让你能充分施展领导力和创造力的方向。"]
    },
    cups: { // 水：感情、情绪、人际、创意
      love:["感情细腻深情，有很强的灵魂共鸣，是值得珍惜的缘分。","双方很懂彼此，情绪能互相承接，吵架也能好好收场。","新的爱慕信号出现，保持开放的心去接触看看。","关系进入稳定甜蜜期，适合谈婚论嫁、深度承诺。","可能会遇到前任/旧缘复联，问问自己真正想要什么。","感情需要经营和仪式感，用心制造惊喜能回温。","有共同朋友圈或爱好作为纽带，越相处越觉得合拍。","情绪波动会影响感情，先处理好自己再沟通更有效。","彼此付出对等，感情处于健康流动的美好状态。","愿意为对方着想和改变，这段关系会越来越稳固。"],
      career:["靠人际/客户关系带来机会，真诚沟通胜过强势推销。","团队氛围融洽，创意提案容易被接受，适合表达想法。","情绪敏感容易受批评影响，学会把反馈和自我分开。","和同事/客户建立深度信任，后续资源会主动找上门。","艺术/服务/教育类工作表现出色，共情能力就是你的武器。","合作项目进展顺利，对方被你的真诚打动愿意让利。","多倾听他人需求，能发现别人注意不到的机会点。","工作中容易被情绪带动，保持心情稳定才能出结果。","培训、分享、带新人能给你带来额外的声誉和资源。","适合处理需要耐心和同理心的任务，会做得很漂亮。"],
      choice:["选让你心里暖暖的、有归属感的那个选项。","如果一个选项更有人情味、团队氛围好，优先选它。","别只看利益数字，情绪价值和长期幸福感也很重要。","选能让你做真实自己、不需要过度伪装的方向。","如果涉及合作，选你更信任、沟通更舒服的那一方。","理性分析后，最终答案在你直觉喜欢的那一边。","选择更具长期关系价值的，而不是短期便宜的。","问自己：哪个选择十年后回头看不觉得亏心？","建议选更柔和、更具成长性的路线。","选择与你价值观、情感需求更匹配的选项。"]
    },
    swords: { // 风：思考、沟通、冲突、决断
      love:["近期沟通很重要，有误会要及时澄清别冷战伤害感情。","思维上高度契合，能聊深度话题，智识伴侣感强。","可能因为言语冲突或思维差异产生矛盾，冷静处理。","需要做出一个理智的决定，长痛不如短痛的道理适用。","感情里有一方过度分析或尖酸刻薄，要注意讲话方式。","单身者有新桃花出现，多靠社交/文字/学习场合认识。","过度理智会把爱推走，偶尔柔软一点更有魅力。","关系遇到瓶颈需要深入沟通，把话说开反而能突破。","分手或断联期，保持尊严给自己留后路，别撕逼。","能坦诚直面问题的话，关系会进入更高质量阶段。"],
